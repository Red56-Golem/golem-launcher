app.put('/api/groups', (req, res) => {
  const list = Array.isArray(req.body.groups) ? req.body.groups.slice(0, 100) : null
  if (!list) return res.status(400).json({ error: 'No groups sent.' })
  const next = []
  for (const g of list) {
    const name = String(g.name || '').trim().slice(0, 40)
    if (!name) return res.status(400).json({ error: 'Every group needs a name.' })
    const proxy = String(g.proxy || '').trim().slice(0, 300)
    try { proxyLib.parseProxy(proxy) } catch (e) { return res.status(400).json({ error: `${name}: ${e.message}` }) }
    next.push({ id: /^[a-f0-9]{6,16}$/.test(g.id) ? g.id : crypto.randomBytes(4).toString('hex'), name, proxy })
  }
  const before = new Map(config.groups.map(g => [g.id, g.proxy]))
  config.groups = next
  // bots in deleted groups leave them; bots whose proxy changed reconnect
  const restarted = []
  for (const bot of bots.values()) {
    const g = next.find(x => x.id === bot.cfg.group)
    if (bot.cfg.group && !g) bot.cfg.group = ''
    const was = before.get(bot.cfg.group) || ''
    const now = g ? g.proxy : ''
    if (was !== now && bot.status !== 'stopped' && bot.status !== 'error' && bot.status !== 'paused') { bot.restart(); restarted.push(bot.displayName()) }
    bot.changed()
  }
  saveNow()
  broadcast({ type: 'groups', groups: config.groups, lanes: lanes() })
  res.json({ groups: config.groups, restarted })
})

