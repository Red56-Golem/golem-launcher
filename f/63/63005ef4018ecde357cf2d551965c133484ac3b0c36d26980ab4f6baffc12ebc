app.get('/api/bots/:id/log', (req, res) => {
  const bot = bots.get(req.params.id)
  if (!bot) return res.status(404).json({ error: 'No such bot.' })
  res.json({ log: bot.log, history: historyFor(bot.cfg.id) })
})

app.get('/api/bots/:id/shot.png', (req, res) => {
  const bot = bots.get(req.params.id)
  if (!bot) return res.status(404).end()
  res.setHeader('Cache-Control', 'private, max-age=86400') // each picture has its own ?t= address
  res.sendFile(shots.shotFile(bot.cfg.id), err => { if (err && !res.headersSent) res.status(404).end() })
})

app.post('/api/bots', (req, res) => {
  if (bots.size >= 50) return res.status(400).json({ error: 'That is a lot of bots. 50 is the limit.' })
  const base = botDefaults()
  if (req.body.edition === 'bedrock') { base.edition = 'bedrock'; base.port = 19132 }
  const cfg = cleanBot(req.body, base)
  if (!cfg.host) return res.status(400).json({ error: 'Enter a server address.' })
  config.bots.push(cfg)
  saveNow()
  const bot = addBot(cfg)
  if (req.body.start) bot.start()
  broadcast({ type: 'bot', bot: bot.publicState() })
  res.json({ bot: bot.publicState() })
})

app.patch('/api/bots/:id', (req, res) => {
  const bot = bots.get(req.params.id)
  if (!bot) return res.status(404).json({ error: 'No such bot.' })
  const before = JSON.stringify([bot.cfg.host, bot.cfg.port, bot.cfg.version, bot.cfg.auth, bot.cfg.name])
  const next = cleanBot(req.body, bot.cfg)
  if (next.auth !== bot.cfg.auth) next.account = ''
  Object.assign(bot.cfg, next)
  save()
  const after = JSON.stringify([bot.cfg.host, bot.cfg.port, bot.cfg.version, bot.cfg.auth, bot.cfg.name])
  bot.changed()
  res.json({ bot: bot.publicState(), needsRestart: before !== after && bot.status !== 'stopped' })
})

app.delete('/api/bots/:id', (req, res) => {
  const bot = bots.get(req.params.id)
  if (!bot) return res.status(404).json({ error: 'No such bot.' })
  bot.stop('Removed')
  bot.removeAllListeners('change')
  bot.removeAllListeners('line')
  bots.delete(bot.cfg.id)
  config.bots = config.bots.filter(b => b.id !== bot.cfg.id)
  saveNow()
  setTimeout(() => {
    fs.rmSync(path.join(store.DATA, 'auth', bot.cfg.id), { recursive: true, force: true })
    shots.remove(bot.cfg.id)
  }, 4000)
  broadcast({ type: 'removed', id: bot.cfg.id })
  res.json({ ok: true })
})

app.post('/api/bots/:id/:action', (req, res) => {
  const bot = bots.get(req.params.id)
  if (!bot) return res.status(404).json({ error: 'No such bot.' })
  switch (req.params.action) {
    case 'start': bot.start(); break
    case 'stop': bot.stop(); break
    case 'restart': bot.restart(); break
    case 'say':
      if (!bot.say(String(req.body.text || '').trim())) return res.status(409).json({ error: 'The bot has to be online to chat.' })
      break
    case 'screenshot':
      return bot.screenshot().then(shot => res.json({ shot })).catch(e => res.status(409).json({ error: e.message }))
    case 'play':
      try { bot.playMacro(String(req.body.macro || '')) } catch (e) { return res.status(409).json({ error: e.message }) }
      break
    case 'stopmacro': bot.stopMacro(); break
    case 'forget':
      bot.stop('Signed out')
      setTimeout(() => bot.forgetAccount(), 3500)
      break
    default: return res.status(404).json({ error: 'Unknown action.' })
  }
  res.json({ ok: true })
})

app.post('/api/all/:action', (req, res) => {
  for (const bot of bots.values()) {
    if (req.params.action === 'start' && bot.status === 'stopped') bot.start()
    if (req.params.action === 'stop' && bot.status !== 'stopped') bot.stop()
  }
  res.json({ ok: true })
})

