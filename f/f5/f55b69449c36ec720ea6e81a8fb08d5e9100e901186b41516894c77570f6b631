'use strict'
// Finds the shards count in the scoreboard on the right (Donut SMP shows it as a purple number).
// lines: § coded text, top line first. Returns the number as shown (e.g. "1,234" or "1.2K") or null.
const NUM = /\d[\d,.]*(?:\s?[kmbt](?![a-z]))?/i

// small-caps letters some servers use (ꜱʜᴀʀᴅꜱ) read as normal letters
const SMALL_CAPS = { 'ᴀ': 'a', 'ʙ': 'b', 'ᴄ': 'c', 'ᴅ': 'd', 'ᴇ': 'e', 'ꜰ': 'f', 'ɢ': 'g', 'ʜ': 'h', 'ɪ': 'i', 'ᴊ': 'j', 'ᴋ': 'k', 'ʟ': 'l', 'ᴍ': 'm', 'ɴ': 'n', 'ᴏ': 'o', 'ᴘ': 'p', 'ꞯ': 'q', 'ʀ': 'r', 'ꜱ': 's', 'ᴛ': 't', 'ᴜ': 'u', 'ᴠ': 'v', 'ᴡ': 'w', 'ʏ': 'y', 'ᴢ': 'z' }
function strip (s) {
  return String(s || '').replace(/§#[0-9a-f]{6}/gi, '').replace(/§[0-9a-z]/gi, '').replace(/[ᴀʙᴄᴅᴇꜰɢʜɪᴊᴋʟᴍɴᴏᴘꞯʀꜱᴛᴜᴠᴡʏᴢ]/g, c => SMALL_CAPS[c])
}

function purpleNumbers (motd) {
  const out = []
  let color = ''
  const parts = String(motd || '').split(/(§#[0-9a-fA-F]{6}|§[0-9a-zA-Z])/)
  for (const p of parts) {
    if (!p) continue
    if (p.startsWith('§#')) { color = p.slice(1).toLowerCase(); continue }
    if (p.length === 2 && p[0] === '§') {
      const c = p[1].toLowerCase()
      if (/[0-9a-fr]/.test(c)) color = c
      continue
    }
    if (!isPurple(color)) continue
    const m = p.match(NUM)
    if (m) out.push(m[0].trim())
  }
  return out
}

function isPurple (c) {
  if (c === 'd' || c === '5') return true
  if (c.startsWith('#') && c.length === 7) {
    const r = parseInt(c.slice(1, 3), 16); const g = parseInt(c.slice(3, 5), 16); const b = parseInt(c.slice(5, 7), 16)
    return b > 140 && r > 100 && g < Math.min(r, b) - 40
  }
  return false
}

function parseShards (lines) {
  if (!lines || !lines.length) return null
  const plain = lines.map(strip)
  for (let i = 0; i < plain.length; i++) {
    const at = plain[i].search(/shards?/i)
    if (at < 0) continue
    const purple = purpleNumbers(lines[i])
    if (purple.length) return purple[0]
    const after = plain[i].slice(at).match(NUM) || plain[i].match(NUM)
    if (after) return after[0].trim()
    const next = plain[i + 1] && plain[i + 1].match(NUM)
    if (next) return next[0].trim()
  }
  // no "shards" label: a purple number anywhere on the scoreboard
  for (const l of lines) {
    const purple = purpleNumbers(l)
    if (purple.length) return purple[0]
  }
  return null
}

// The reply to /shards, e.g. "You have 1,234 shards" (prefers a purple number)
function shardsFromChat (text, motd) {
  const plain = strip(text)
  if (!/shards?/i.test(plain)) return null
  const purple = purpleNumbers(motd)
  if (purple.length) return purple[0]
  const m = plain.match(NUM)
  return m ? m[0].trim() : null
}

module.exports = { parseShards, shardsFromChat }
