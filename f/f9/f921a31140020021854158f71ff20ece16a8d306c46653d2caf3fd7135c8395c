    ? naughty.slice(0, 8).map(b => `<li data-open="${b.cfg.id}"><i class="dot ${stateOf(b)}"></i><strong>${esc(nameOf(b))}</strong><small>${esc(statusText(b))}</small></li>`).join('') + (naughty.length > 8 ? `<li class="list-empty">and ${naughty.length - 8} more</li>` : '')
