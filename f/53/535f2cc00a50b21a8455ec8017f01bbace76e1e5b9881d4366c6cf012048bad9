}

// ---- proxy health: every proxy in use is tested every 10 minutes
const proxyHealth = {} // proxyKey -> { ok, ms, udp, at, error }
AfkBot.healthOf = (bot) => proxyHealth[proxyKey(bot.cfg)] || null
async function checkProxies () {
  const seen = new Map()
  for (const bot of bots.values()) {
    let p = null
    try { p = store.proxyForBot(bot.cfg) } catch { continue }
    if (!p) continue
    const key = proxyKey(bot.cfg)
    if (!seen.has(key)) seen.set(key, { p, host: bot.cfg.host, names: [] })
    seen.get(key).names.push(bot.displayName())
  }
  for (const [key, { p, host, names }] of seen) {
    const before = proxyHealth[key]
    try {
      const r = await proxyLib.testProxy(p, host, 25565)
      proxyHealth[key] = { ok: true, ms: r.ms, udp: r.udp, at: Date.now() }
    } catch (e) {
      proxyHealth[key] = { ok: false, error: e.message, at: Date.now() }
      if (!before || before.ok) alerts.alert('proxyDown', { title: 'A proxy stopped working', text: `${proxyLib.describe(p)} (used by ${names.join(', ')}): ${e.message}`, tone: 'bad', key: 'proxy:' + key })
    }
  }
  for (const k of Object.keys(proxyHealth)) if (!seen.has(k)) delete proxyHealth[k]
  broadcast({ type: 'proxyHealth', proxyHealth })
}
setInterval(() => checkProxies().catch(() => {}), 10 * 60000).unref()
setTimeout(() => checkProxies().catch(() => {}), 15000).unref()
app.post('/api/proxies/check', async (req, res) => { await checkProxies().catch(() => {}); res.json({ proxyHealth }) })

// ---- the nightly Discord summary
let summaryDay = ''
function sendSummary (force) {
  const list = [...bots.values()]
  const k = dayKey()
  const d = config.days[k] || { earned: 0, bought: 0, disconnects: 0 }
  const farming = list.filter(b => b.inAfk()).length
  const lines = [
    `**${d.earned.toLocaleString('en-US')} shards** earned today by ${list.length} account${list.length === 1 ? '' : 's'}`,
    `**${d.bought}** spawner${d.bought === 1 ? '' : 's'} bought, **${d.disconnects}** disconnect${d.disconnects === 1 ? '' : 's'}`,
    `${farming} of ${list.length} farming right now (${(farming * 60).toLocaleString('en-US')} shards an hour)`
  ]
  const top = list.map(b => ({ b, n: b.cfg.tally && b.cfg.tally.day === k ? b.cfg.tally.today : 0 })).filter(x => x.n).sort((a, b) => b.n - a.n).slice(0, 3)
  if (top.length) lines.push('', 'Top earners: ' + top.map(x => `${x.b.displayName()} +${x.n}`).join(', '))
  const g = config.settings.goalCount
  if (g) {
    const got = list.reduce((a, b) => a + ((b.cfg.tally && b.cfg.tally.bought && b.cfg.tally.bought[config.settings.goalMob]) || 0), 0)
    lines.push(`Goal: ${got} / ${g} ${config.settings.goalMob} spawners`)
  }
  alerts.alert(force ? null : 'summary', { title: 'Daily summary', text: lines.join('\n'), tone: 'info', key: 'summary' })
}
