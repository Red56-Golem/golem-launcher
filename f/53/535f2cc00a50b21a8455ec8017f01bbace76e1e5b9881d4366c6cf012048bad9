setInterval(() => {
  const now = Date.now()
  for (const bot of bots.values()) {
    if (bot.status !== 'online' || bot.busy || !bot.onlineSince) continue
    // not in the AFK area: send the AFK command again (at most every 2 minutes)
    // out of the AFK area for 5 minutes: tell Discord once
    if (bot.inAfk()) bot.outSince = 0
    else {
      if (!bot.outSince) bot.outSince = now
      if (now - bot.outSince > 5 * 60000 && !bot.outAlerted && now - bot.onlineSince > 5 * 60000) {
        bot.outAlerted = true
        alerts.alert('afkOut', { bot, title: 'Not farming', text: `Out of the AFK area for ${Math.round((now - bot.outSince) / 60000)} minutes.`, tone: 'warn' })
      }
    }
    if (bot.inAfk()) bot.outAlerted = false
    if (!bot.afkGap) bot.afkGap = human(120000, 200000)
    if (config.settings.autoAfk && config.settings.afkCommand && now - bot.onlineSince > 20000 && !bot.inAfk() && now - (bot.lastAfkCmd || 0) > bot.afkGap) {
      bot.lastAfkCmd = now
      bot.afkGap = human(120000, 200000)
      bot.write('info', `Not in the AFK area, sending ${config.settings.afkCommand}`)
      bot.sendLine(config.settings.afkCommand, true)
      continue
    }
    if (bot.cfg.autoBuy && now - (bot.lastAutoBuy || 0) > 60000) {
      const p = donut.prices().list.find(x => x.mob === config.settings.buyMob)
      const have = shardsOf(bot)
      if (p && have !== null && have >= p.price) { bot.lastAutoBuy = now; buyMax(bot) }
    }
  }
}, 10000).unref()

// total shards of all bots, one point a minute for the last 4 hours (memory only)
const chart = []
function sampleChart () {
  let total = 0
  let any = false
  for (const bot of bots.values()) {
    if (bot.status !== 'online') continue
    const v = shardsOf(bot)
    if (v !== null) { total += v; any = true }
  }
  if (!any) return
  const point = { t: Date.now(), v: Math.round(total) }
  chart.push(point)
  while (chart.length > 240) chart.shift()
  broadcast({ type: 'chart', point })
}
setInterval(sampleChart, 60000).unref()
setTimeout(sampleChart, 45000).unref()

