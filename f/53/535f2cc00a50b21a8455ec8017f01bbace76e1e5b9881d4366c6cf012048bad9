  if (b.autoAfk !== undefined) s.autoAfk = !!b.autoAfk
  if (b.buyMob !== undefined && donut.prices().list.some(p => p.mob === b.buyMob)) s.buyMob = String(b.buyMob)
  if (b.screenshotSeconds !== undefined) s.screenshotSeconds = SHOT_SECONDS.includes(Number(b.screenshotSeconds)) ? Number(b.screenshotSeconds) : 60
  if (b.allowPhone !== undefined) s.allowPhone = !!b.allowPhone
  if (b.port !== undefined) s.port = clampInt(b.port, 1024, 65535, 8080)
