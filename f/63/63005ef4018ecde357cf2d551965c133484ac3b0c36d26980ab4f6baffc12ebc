function lanAddresses () {
  const out = []
  for (const list of Object.values(os.networkInterfaces())) {
    for (const a of list || []) if (a.family === 'IPv4' && !a.internal) out.push(a.address)
  }
  return out
}

function openBrowser (url) {
  if (BACKGROUND) return
  const cmd = process.platform === 'win32' ? `start "" "${url}"` : process.platform === 'darwin' ? `open "${url}"` : `xdg-open "${url}"`
  exec(cmd, () => {})
}

const port = Number(process.env.GOLEM_AFK_PORT) || config.settings.port
const bindHost = config.settings.allowPhone ? '0.0.0.0' : '127.0.0.1'

server.on('error', (e) => {
  if (e.code === 'EADDRINUSE') {
    console.log(`Golem AFK already seems to be running on port ${port}. Opening it.`)
    openBrowser(`http://localhost:${port}`)
    setTimeout(() => process.exit(0), 1500)
  } else {
    console.error(e)
    process.exit(1)
  }
})

updater.cleanup()
setTimeout(() => updater.check().catch(() => {}), 20000).unref()
setInterval(() => updater.check().catch(() => {}), 6 * 3600e3).unref()

server.listen(port, bindHost, () => {
  const local = `http://localhost:${port}`
  console.log('')
  console.log(`  Golem AFK ${VERSION} is running.`)
  console.log(`  Dashboard:  ${local}`)
  if (config.settings.allowPhone) for (const ip of lanAddresses()) console.log(`  On your phone (same Wi-Fi):  http://${ip}:${port}`)
  console.log('')
  console.log('  Keep this window open. Closing it stops every bot.')
  console.log('')
  openBrowser(local)
  let delay = 0
  for (const bot of bots.values()) {
    if (bot.cfg.running) {
      setTimeout(() => bot.connect(), delay)
      delay += 2500
    }
  }
})

let shuttingDown = false
function shutdown (why, code = 0) {
  if (shuttingDown) return
  shuttingDown = true
  console.log(`\n  Stopping bots (${why})...`)
  for (const bot of bots.values()) {
    const keep = bot.cfg.running
    if (bot.mc) { try { bot.mc.quit() } catch {} }
    bot.cfg.running = keep // restart them next time the app opens
    store.addHistory(bot.cfg.id, 'off')
  }
  history.__alive = Date.now()
  try { saveNow() } catch {}
  try { fs.writeFileSync(path.join(store.DATA, 'history.json'), JSON.stringify(history)) } catch {}
  setTimeout(() => process.exit(code), 800)
}
for (const sig of ['SIGINT', 'SIGTERM', 'SIGHUP', 'SIGBREAK']) process.on(sig, () => shutdown(sig))
process.on('uncaughtException', (e) => { console.error('Unexpected error:', e) })
process.on('unhandledRejection', (e) => { console.error('Unexpected error:', e) })
