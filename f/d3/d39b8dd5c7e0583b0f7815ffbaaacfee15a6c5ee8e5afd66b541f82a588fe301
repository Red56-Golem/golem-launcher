<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<title>Golem AFK</title>
<link rel="icon" href="/golem.svg" type="image/svg+xml">
<link rel="stylesheet" href="/app.css">
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-plus" viewBox="0 0 16 16"><path d="M7 2h2v5h5v2H9v5H7V9H2V7h5z"/></symbol>
  <symbol id="i-gear" viewBox="0 0 16 16"><path d="M7 1h2l.4 2 1.3.6 1.7-1.2 1.4 1.4-1.2 1.7.6 1.3 2 .4v2l-2 .4-.6 1.3 1.2 1.7-1.4 1.4-1.7-1.2-1.3.6L9 15H7l-.4-2-1.3-.6-1.7 1.2-1.4-1.4 1.2-1.7L2.8 9.4 1 9V7l2-.4.6-1.3-1.2-1.7 1.4-1.4 1.7 1.2 1.3-.6zm1 4.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"/></symbol>
  <symbol id="i-play" viewBox="0 0 16 16"><path d="M4 2l10 6-10 6z"/></symbol>
  <symbol id="i-stop" viewBox="0 0 16 16"><path d="M3 3h10v10H3z"/></symbol>
  <symbol id="i-redo" viewBox="0 0 16 16"><path d="M8 2a6 6 0 1 0 6 6h-2a4 4 0 1 1-1.2-2.8L9 7h5V2l-1.8 1.8A6 6 0 0 0 8 2z"/></symbol>
  <symbol id="i-back" viewBox="0 0 16 16"><path d="M10 2l1.4 1.4L6.8 8l4.6 4.6L10 14 4 8z"/></symbol>
  <symbol id="i-send" viewBox="0 0 16 16"><path d="M1 2l14 6-14 6 2-6zm2.6 5h5.4v2H3.6L3 11.6 11 8 3 4.4z"/></symbol>
  <symbol id="i-copy" viewBox="0 0 16 16"><path d="M5 1h9v10h-3v4H2V5h3zm2 2v2h4v4h1V3zM4 7v6h5V7z"/></symbol>
  <symbol id="i-grid" viewBox="0 0 16 16"><path d="M1 2h6v5H1zm8 0h6v5H9zM1 9h6v5H1zm8 0h6v5H9z"/></symbol>
  <symbol id="i-camera" viewBox="0 0 16 16"><path d="M5 2h6l1 2h3v10H1V4h3zm3 3.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zm0 2a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z"/></symbol>
  <symbol id="i-up" viewBox="0 0 16 16"><path d="M8 3l6 6-1.4 1.4L8 5.8l-4.6 4.6L2 9z"/></symbol>
  <symbol id="i-down" viewBox="0 0 16 16"><path d="M8 13L2 7l1.4-1.4L8 10.2l4.6-4.6L14 7z"/></symbol>
  <symbol id="i-pin" viewBox="0 0 16 16"><path d="M8 1a5 5 0 0 1 5 5c0 3.5-5 9-5 9S3 9.5 3 6a5 5 0 0 1 5-5zm0 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"/></symbol>
  <symbol id="i-close" viewBox="0 0 16 16"><path d="M3.4 2L8 6.6 12.6 2 14 3.4 9.4 8l4.6 4.6-1.4 1.4L8 9.4 3.4 14 2 12.6 6.6 8 2 3.4z"/></symbol>
</svg>

<!-- sign in / first password -->
<main id="gate" class="gate" hidden>
  <form class="gate-plate" id="gateForm">
    <img src="/golem.svg" alt="" class="gate-mark" width="56" height="63">
    <h1>Golem AFK</h1>
    <p id="gateText">Sign in to your bots.</p>
    <label class="field">
      <span id="gateLabel">Password</span>
      <input type="password" id="gatePass" autocomplete="current-password" required minlength="6">
    </label>
    <p class="form-error" id="gateError" role="alert"></p>
    <button class="btn primary wide" id="gateBtn">Sign in</button>
  </form>
</main>

<!-- dashboard -->
<div id="app" class="app" hidden>
  <header class="topbar">
    <a class="brand" href="#" id="brand"><img src="/golem.svg" alt="" width="22" height="25"><span>Golem AFK</span></a>
    <p class="tally" id="tally"></p>
    <div class="top-actions">
      <button class="btn primary" id="updatePill" hidden><svg><use href="#i-down"/></svg><span>Update ready</span></button>
      <button class="btn" id="gridBtn" aria-pressed="false"><svg><use href="#i-grid"/></svg><span>All screens</span></button>
      <button class="btn" id="addBtn"><svg><use href="#i-plus"/></svg><span>Add bot</span></button>
      <button class="btn icon" id="settingsBtn" aria-label="Settings" title="Settings"><svg><use href="#i-gear"/></svg></button>
    </div>
  </header>

  <div class="work">
    <nav class="roster" id="roster" aria-label="Bots"></nav>

    <section class="detail" id="detail" aria-live="polite">
      <div class="empty" id="empty">
        <img src="/golem.svg" alt="" width="64" height="72">
        <h2>No bots yet</h2>
        <p>Add a bot, sign in with its Microsoft account once, and it will stay on the server for as long as this app is open.</p>
        <button class="btn primary" id="emptyAdd"><svg><use href="#i-plus"/></svg><span>Add your first bot</span></button>
      </div>

      <div class="overview" id="overview" hidden>
        <div class="overview-head">
          <div>
            <h2>All screens</h2>
            <p>Newest picture from every bot. Click one to open it.</p>
          </div>
          <div class="total-shards" id="totalShards" hidden>
            <span>Total shards</span>
            <strong id="totalShardsNum"></strong>
            <small id="totalShardsFrom"></small>
          </div>
        </div>
        <div class="shot-grid" id="shotGrid"></div>
      </div>

      <div class="bot" id="bot" hidden>
        <div class="bot-head">
          <button class="btn icon back" id="backBtn" aria-label="Back to all bots"><svg><use href="#i-back"/></svg></button>
          <div class="bot-title">
            <h2 id="botName"></h2>
            <p id="botWhere"></p>
          </div>
          <div class="bot-actions" id="botActions"></div>
        </div>
        <p class="status-line" id="statusLine"></p>

        <div class="signin-box" id="signin" hidden>
          <div>
            <h3>Sign in with Microsoft</h3>
            <p id="signinPC">Press <strong>Choose account</strong>. Microsoft's sign-in window opens with your saved accounts and <em>Sign in with a different account</em>. Pick the one this bot should use; the window closes by itself and the bot joins. You only do this once per bot.</p>
            <p id="signinRemote" hidden>Press <strong>Choose account</strong> and finish signing in on the PC running Golem AFK, where the window opens.</p>
            <details class="code-way">
              <summary>Use a code instead</summary>
              <p>Open <a id="signinLink" target="_blank" rel="noopener">microsoft.com/link</a> on any device and enter <strong id="signinCode"></strong>. <button type="button" class="btn subtle small" id="copyCode">Copy code</button></p>
            </details>
          </div>
          <div class="code-box">
            <button class="btn primary" id="signinOpen"><span>Choose account</span></button>
            <p class="hint" id="signinState" role="status"></p>
          </div>
        </div>

        <figure class="screen" id="screen">
          <div class="screen-frame" id="screenFrame">
            <img id="screenImg" alt="">
            <div class="labels" id="screenLabels"></div>
            <p class="screen-empty" id="screenEmpty"></p>
          </div>
          <figcaption>
            <span id="screenCaption"></span>
            <button class="btn" id="shotBtn"><svg><use href="#i-camera"/></svg><span>Take screenshot now</span></button>
          </figcaption>
        </figure>

        <div class="vitals" id="vitals">
          <div class="bars">
            <div class="bar" id="hearts" aria-label="Health"></div>
            <div class="bar" id="hunger" aria-label="Hunger"></div>
          </div>
          <dl class="facts" id="facts"></dl>
        </div>
        <p class="actionbar" id="actionBar" hidden></p>

        <div class="uptime">
          <div class="uptime-head">
            <h3>Last 24 hours</h3>
            <p id="uptimePct"></p>
          </div>
          <div class="strip" id="strip"></div>
          <div class="ticks" id="ticks"></div>
        </div>

        <div class="tabs" role="tablist">
          <button role="tab" class="tab" id="tabChat" aria-selected="true">Chat</button>
          <button role="tab" class="tab" id="tabMacros" aria-selected="false">Macros</button>
          <button role="tab" class="tab" id="tabSettings" aria-selected="false">Bot settings</button>
        </div>

        <div class="pane" id="paneChat">
          <div class="console" id="console" tabindex="0" aria-label="Chat and events"></div>
          <form class="say" id="sayForm">
            <input id="sayInput" maxlength="256" autocomplete="off" placeholder="Type a message or /command" aria-label="Message">
            <button class="btn primary icon" aria-label="Send"><svg><use href="#i-send"/></svg></button>
          </form>
        </div>

        <div class="pane macros" id="paneMacros" hidden></div>

        <form class="pane settings-form" id="paneSettings" hidden></form>
      </div>
    </section>
  </div>
</div>

<!-- add bot -->
<dialog id="addDialog" class="sheet">
  <form id="addForm" method="dialog">
    <header><h2>Add a bot</h2><button type="button" class="btn icon" data-close aria-label="Close"><svg><use href="#i-close"/></svg></button></header>
    <fieldset class="field">
      <legend>Minecraft edition</legend>
      <div class="segmented">
        <label><input type="radio" name="edition" value="java" checked><span>Java</span></label>
        <label><input type="radio" name="edition" value="bedrock"><span>Bedrock</span></label>
      </div>
      <p class="hint" id="editionHint">The normal PC version. Everything works, including walking in macros.</p>
    </fieldset>
    <label class="field"><span>Server address</span><input name="host" value="og-donutsmp.net" required autocomplete="off" spellcheck="false"></label>
    <fieldset class="field">
      <legend>Account</legend>
      <div class="segmented">
        <label><input type="radio" name="auth" value="microsoft" checked><span>Microsoft account</span></label>
        <label><input type="radio" name="auth" value="offline"><span>Offline name</span></label>
      </div>
      <p class="hint" id="authHint">You'll get a code to sign in once the bot starts.</p>
    </fieldset>
    <label class="field" id="offlineName" hidden><span>Player name</span><input name="name" maxlength="16" pattern="[A-Za-z0-9_]{3,16}" autocomplete="off" spellcheck="false"></label>
    <label class="field"><span>Name on the dashboard <em>(optional)</em></span><input name="label" maxlength="40" placeholder="Shown instead of the account name" autocomplete="off"></label>
    <p class="form-error" id="addError" role="alert"></p>
    <footer><button type="button" class="btn" data-close>Cancel</button><button class="btn primary" value="add">Add and start</button></footer>
  </form>
</dialog>

<!-- app settings -->
<dialog id="setDialog" class="sheet wide-sheet">
  <form id="setForm" method="dialog">
    <header><h2>Settings</h2><button type="button" class="btn icon" data-close aria-label="Close"><svg><use href="#i-close"/></svg></button></header>

    <section class="group">
      <h3>Screenshots</h3>
      <p class="hint">Each bot draws what it sees. Only the newest picture of each bot is kept.</p>
      <label class="field"><span>Take a screenshot of each bot</span>
        <select name="screenshotEvery">
          <option value="1">Every minute</option><option value="2">Every 2 minutes</option><option value="5">Every 5 minutes</option><option value="10">Every 10 minutes</option><option value="30">Every 30 minutes</option><option value="0">Only when I ask</option>
        </select>
      </label>
    </section>

    <section class="group">
      <h3>Discord alerts</h3>
      <p class="hint">Paste a webhook link from a Discord channel (Channel settings, Integrations, Webhooks) to get a message when a bot needs you.</p>
      <div class="inline">
        <input name="webhookUrl" placeholder="https://discord.com/api/webhooks/..." autocomplete="off" spellcheck="false" aria-label="Discord webhook link">
        <button type="button" class="btn" id="testAlert">Send a test</button>
      </div>
      <p class="hint" id="testResult" role="status"></p>
      <div class="checks">
        <label><input type="checkbox" name="a_kicked"> Kicked or paused</label>
        <label><input type="checkbox" name="a_stopped"> Stopped for good</label>
        <label><input type="checkbox" name="a_died"> Died</label>
        <label><input type="checkbox" name="a_lowHealth"> Low health</label>
        <label><input type="checkbox" name="a_mentioned"> Name or keyword in chat</label>
        <label><input type="checkbox" name="a_signIn"> Needs a Microsoft sign-in</label>
        <label><input type="checkbox" name="a_backOnline"> Back online</label>
      </div>
      <div class="two">
        <label class="field"><span>Low health means</span>
          <select name="lowHealth">
            <option value="2">1 heart or less</option><option value="4">2 hearts or less</option><option value="6">3 hearts or less</option><option value="10">5 hearts or less</option>
          </select>
        </label>
        <label class="field"><span>Extra chat keywords</span><input name="keywords" placeholder="e.g. tpa, trade" autocomplete="off"></label>
      </div>
    </section>

    <section class="group" id="updates">
      <h3>Updates</h3>
      <p class="hint" id="updText"></p>
      <div class="upd-bar" id="updBar" hidden><i id="updFill"></i></div>
      <div class="inline upd-actions">
        <button type="button" class="btn primary" id="updInstall" hidden></button>
        <button type="button" class="btn" id="updCheck">Check for updates</button>
        <button type="button" class="btn" id="updZip">Install update from a zip</button>
        <input type="file" id="updFile" accept=".zip,application/zip" hidden>
      </div>
    </section>

    <section class="group">
      <h3>This computer</h3>
      <label class="switch"><input type="checkbox" name="allowPhone"><span>Open the dashboard from my phone on the same Wi-Fi</span></label>
      <p class="hint" id="lanHint"></p>
      <label class="switch" id="startupRow"><input type="checkbox" name="startWithWindows"><span>Start Golem AFK in the background when Windows starts</span></label>
      <div class="two">
        <label class="field"><span>New dashboard password</span><input type="password" name="password" minlength="6" autocomplete="new-password" placeholder="Leave empty to keep it"></label>
        <label class="field"><span>Dashboard port</span><input name="port" type="number" min="1024" max="65535"></label>
      </div>
    </section>

    <p class="form-error" id="setError" role="alert"></p>
    <footer>
      <button type="button" class="btn subtle" id="signOut">Sign out</button>
      <button type="button" class="btn subtle danger" id="quitApp">Quit Golem AFK</button>
      <span class="grow"></span>
      <button class="btn primary" value="save">Save settings</button>
    </footer>
  </form>
</dialog>

<div class="toast" id="toast" role="status" hidden></div>
<script src="/app.js"></script>
</body>
</html>
