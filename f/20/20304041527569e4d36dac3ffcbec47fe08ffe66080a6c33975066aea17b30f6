'use strict'
// Keeps a copy of the blocks, entities, time and scoreboard a Bedrock bot is told about,
// so Bedrock bots can take screenshots and show their shards like Java bots.
const ENTITY_SIZE = {
  player: [0.6, 1.8], cow: [0.9, 1.4], mooshroom: [0.9, 1.4], pig: [0.9, 0.9], sheep: [0.9, 1.3], chicken: [0.4, 0.7],
  horse: [1.4, 1.6], wolf: [0.6, 0.85], cat: [0.6, 0.7], spider: [1.4, 0.9], cave_spider: [0.7, 0.5], creeper: [0.6, 1.7],
  enderman: [0.6, 2.9], slime: [1.0, 1.0], magma_cube: [1.0, 1.0], iron_golem: [1.4, 2.7], villager: [0.6, 1.9],
  ghast: [4, 4], blaze: [0.6, 1.8], item: [0.3, 0.3], bee: [0.7, 0.6], rabbit: [0.4, 0.5], fox: [0.6, 0.7], squid: [0.8, 0.8]
}
const SKIP = new Set(['xp_orb', 'arrow', 'snowball', 'egg', 'ender_pearl', 'fireball', 'small_fireball', 'painting', 'leash_knot',
  'falling_block', 'lightning_bolt', 'area_effect_cloud', 'fishing_hook', 'thrown_trident', 'splash_potion', 'lingering_potion',
  'xp_bottle', 'wind_charge_projectile', 'breeze_wind_charge_projectile', 'tnt', 'shulker_bullet', 'dragon_fireball', 'wither_skull',
  'wither_skull_dangerous', 'evocation_fang', 'eye_of_ender_signal', 'fireworks_rocket', 'llama_spit', 'armor_stand', 'minecart',
  'chest_minecart', 'hopper_minecart', 'tnt_minecart', 'command_block_minecart', 'boat', 'chest_boat', 'npc', 'agent', 'tripod_camera'])
const BOUNDS = { 0: [-4, 20], 1: [0, 8], 2: [0, 16] } // overworld, nether, end (in 16-block sections)

function key (x, z) { return `${x},${z}` }
function dimId (d) { return d === 'nether' || d === 1 ? 1 : d === 'the_end' || d === 'end' || d === 2 ? 2 : 0 }

class BedrockWorld {
  constructor (client, version) {
    this.client = client
    this.version = version
    this.registry = require('prismarine-registry')('bedrock_' + version)
    this.Chunk = null
    this.columns = new Map()
    this.entities = new Map() // runtime id -> entity
    this.uniqueToRuntime = new Map()
    this.dim = 0
    this.eye = null
    this.yaw = Math.PI
    this.pitch = 0
    this.time = 6000
    this.selfId = null
    this.sidebar = null // objective name shown on the right
    this.scores = new Map() // scoreboard id -> { objective, score, name }
    this.objectives = new Map() // name -> title
    this.errors = 0
    this.listen()
  }

  chunkClass () {
    if (!this.Chunk) this.Chunk = require('prismarine-chunk/src/bedrock/1.18/chunk')(this.registry)
    return this.Chunk
  }

  newColumn (x, z) {
    const C = this.chunkClass()
    const col = new C({ x, z })
    const [a, b] = BOUNDS[this.dim] || BOUNDS[0]
    col.setBounds(a, b)
    this.columns.set(key(x, z), col)
    return col
  }

  // Sections decoded from a full chunk are filed by their own height, not their order
  refile (col) {
    const secs = col.sections.filter(Boolean)
    col.sections = []
    for (const s of secs) {
      let y = s.y
      if (y > 127) y -= 256
      if (typeof y === 'number' && y >= col.minCY && y < col.maxCY) col.setSection(y, s)
    }
  }

  listen () {
    const c = this.client
    const on = (name, fn) => c.on(name, (p) => { try { fn(p) } catch (e) { if (this.errors++ < 5) console.error(`[bedrock world] ${name}:`, e.message) } })

    on('start_game', (p) => {
      try { this.registry.handleStartGame({ ...p, itemstates: p.itemstates || [] }) } catch (e) {
        console.error('[bedrock world] block ids:', e.message)
      }
      this.selfId = String(p.runtime_entity_id)
      this.dim = dimId(p.dimension)
      this.eye = { x: p.player_position.x, y: p.player_position.y, z: p.player_position.z }
      if (p.rotation) { this.pitch = -p.rotation.x * Math.PI / 180; this.yaw = Math.PI - p.rotation.y * Math.PI / 180 }
    })
    on('change_dimension', (p) => {
      this.dim = dimId(p.dimension)
      this.columns.clear()
      this.entities.clear()
      if (p.position) this.eye = { x: p.position.x, y: p.position.y, z: p.position.z }
    })
    on('set_time', (p) => { this.time = ((p.time % 24000) + 24000) % 24000 })

    on('level_chunk', (p) => {
      if (dimId(p.dimension) !== this.dim) return
      const col = this.newColumn(p.x, p.z)
      if (p.cache_enabled) return // we asked the server not to use the cache
      col.networkDecodeNoCache(p.payload, p.sub_chunk_count)
      if (p.sub_chunk_count >= 0) {
        this.refile(col)
        return
      }
      // newer servers send the chunk's sections separately when asked
      const top = p.sub_chunk_count === -2 && typeof p.highest_subchunk_count === 'number' ? col.minCY + p.highest_subchunk_count : col.maxCY
      const requests = []
      for (let y = col.minCY; y < top; y++) requests.push({ x: 0, y, z: 0 })
      c.queue('subchunk_request', { dimension: this.dim, origin: { x: p.x, y: 0, z: p.z }, requests })
    })
    on('subchunk', (p) => {
      if (p.cache_enabled) return
      for (const e of p.entries || []) {
        const x = p.origin.x + e.dx
        const z = p.origin.z + e.dz
        const y = p.origin.y + e.dy
        const col = this.columns.get(key(x, z)) || this.newColumn(x, z)
        if (e.result === 'success' && e.payload) {
          col.networkDecodeSubChunkNoCache(y, e.payload).catch(() => {})
        }
      }
    })
    on('update_block', (p) => {
      if (p.layer && p.layer !== 0) return
      const b = this.registry.blocksByRuntimeId && this.registry.blocksByRuntimeId[p.block_runtime_id]
      if (!b) return
      const col = this.columns.get(key(p.position.x >> 4, p.position.z >> 4))
      if (!col) return
      try { col.setBlockStateId({ x: p.position.x & 15, y: p.position.y, z: p.position.z & 15, l: 0 }, b.stateId) } catch {}
    })
    on('network_chunk_publisher_update', () => this.prune())

    // the bot itself
    on('move_player', (p) => {
      const id = String(p.runtime_id)
      if (id === this.selfId) {
        this.eye = { x: p.position.x, y: p.position.y, z: p.position.z }
        this.pitch = -p.pitch * Math.PI / 180
        this.yaw = Math.PI - p.yaw * Math.PI / 180
        return
      }
      const e = this.entities.get(id)
      if (e) { e.x = p.position.x; e.y = p.position.y - (e.kind === 'player' ? 1.62 : 0); e.z = p.position.z }
    })

    // other entities
    on('add_player', (p) => {
      const id = String(p.runtime_id)
      this.uniqueToRuntime.set(String(p.unique_id), id)
      this.entities.set(id, { kind: 'player', name: p.username, x: p.position.x, y: p.position.y - 1.62, z: p.position.z, w: 0.6, h: 1.8 })
    })
    on('add_entity', (p) => {
      const name = String(p.entity_type || '').replace('minecraft:', '')
      if (SKIP.has(name)) return
      const id = String(p.runtime_id)
      this.uniqueToRuntime.set(String(p.unique_id), id)
      const [w, h] = ENTITY_SIZE[name] || [0.6, 1.8]
      this.entities.set(id, { kind: 'mob', name, x: p.position.x, y: p.position.y, z: p.position.z, w, h })
    })
    on('add_item_entity', (p) => {
      const id = String(p.runtime_entity_id)
      this.uniqueToRuntime.set(String(p.entity_id_self), id)
      this.entities.set(id, { kind: 'item', name: 'item', x: p.position.x, y: p.position.y, z: p.position.z, w: 0.3, h: 0.3 })
    })
    on('move_entity', (p) => {
      const e = this.entities.get(String(p.runtime_entity_id))
      if (e) { e.x = p.position.x; e.y = p.position.y - (e.kind === 'player' ? 1.62 : 0); e.z = p.position.z }
    })
    on('move_entity_delta', (p) => {
      const e = this.entities.get(String(p.runtime_entity_id))
      if (!e) return
      if (typeof p.x === 'number') e.x = p.x
      if (typeof p.y === 'number') e.y = p.y - (e.kind === 'player' ? 1.62 : 0)
      if (typeof p.z === 'number') e.z = p.z
    })
    on('remove_entity', (p) => {
      const u = String(p.entity_id_self)
      const id = this.uniqueToRuntime.get(u) || u
      this.entities.delete(id)
      this.uniqueToRuntime.delete(u)
    })

    // scoreboard (for shards)
    on('set_display_objective', (p) => {
      this.objectives.set(p.objective_name, p.display_name)
      if (p.display_slot === 'sidebar') this.sidebar = p.objective_name
    })
    on('remove_objective', (p) => {
      if (this.sidebar === p.objective_name) this.sidebar = null
      for (const [id, s] of this.scores) if (s.objective === p.objective_name) this.scores.delete(id)
    })
    on('set_score', (p) => {
      for (const e of p.entries || []) {
        const id = String(e.scoreboard_id)
        if (e.entry_type === 'remove' || p.action === 'remove') { this.scores.delete(id); continue }
        let name = e.custom_name
        if (!name && e.entity_unique_id !== undefined) {
          const ent = this.entities.get(this.uniqueToRuntime.get(String(e.entity_unique_id)))
          name = ent ? ent.name : ''
        }
        this.scores.set(id, { objective: e.objective_name, score: e.score, name: name || '' })
      }
    })
  }

  prune () {
    if (!this.eye) return
    const cx = Math.floor(this.eye.x) >> 4
    const cz = Math.floor(this.eye.z) >> 4
    for (const [k, col] of this.columns) {
      if (Math.abs(col.x - cx) > 8 || Math.abs(col.z - cz) > 8) this.columns.delete(k)
    }
  }

  // Lines on the right-hand scoreboard, top line first (as § coded text)
  sidebarLines () {
    if (!this.sidebar) return []
    return [...this.scores.values()]
      .filter(s => s.objective === this.sidebar)
      .sort((a, b) => b.score - a.score)
      .map(s => s.name)
  }

  getBlockStateId (x, y, z) {
    const col = this.columns.get(key(x >> 4, z >> 4))
    if (!col) return 0
    try { return col.getBlockStateId({ x: x & 15, y, z: z & 15, l: 0 }) || 0 } catch { return 0 }
  }

  hasColumn (cx, cz) { return this.columns.has(key(cx, cz)) }
}

module.exports = { BedrockWorld }
