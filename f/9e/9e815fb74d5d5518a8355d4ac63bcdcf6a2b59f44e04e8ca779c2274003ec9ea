@font-face { font-family: "Chakra Petch"; font-weight: 500; font-display: swap; src: url(/fonts/chakra-petch-latin-500-normal.woff2) format("woff2"); }
@font-face { font-family: "Chakra Petch"; font-weight: 600; font-display: swap; src: url(/fonts/chakra-petch-latin-600-normal.woff2) format("woff2"); }
@font-face { font-family: "Chakra Petch"; font-weight: 700; font-display: swap; src: url(/fonts/chakra-petch-latin-700-normal.woff2) format("woff2"); }
@font-face { font-family: "Atkinson Hyperlegible"; font-weight: 400; font-display: swap; src: url(/fonts/atkinson-hyperlegible-latin-400-normal.woff2) format("woff2"); }
@font-face { font-family: "Atkinson Hyperlegible"; font-weight: 700; font-display: swap; src: url(/fonts/atkinson-hyperlegible-latin-700-normal.woff2) format("woff2"); }

:root {
  --iron: #D7D8D3;
  --plate: #F3F3EF;
  --plate-2: #E9EAE5;
  --ink: #1E2125;
  --ink-2: #565A5F;
  --seam: #A8AAA4;
  --seam-soft: #C4C6C0;
  --hi: rgba(255, 255, 255, .75);
  --lo: rgba(0, 0, 0, .18);
  --poppy: #C2303A;
  --poppy-ink: #FFFFFF;
  --moss: #4D7A33;
  --amber: #A9691A;
  --idle: #8D9089;
  --slate: #23262A;
  --slate-ink: #E2E3DE;
  --focus: #2F6FB0;
  --shard: #8B3FD6;
  --head: "Chakra Petch", "Segoe UI", system-ui, sans-serif;
  --body: "Atkinson Hyperlegible", "Segoe UI", system-ui, sans-serif;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root {
    --iron: #17191C;
    --plate: #212428;
    --plate-2: #2A2E33;
    --ink: #E6E7E2;
    --ink-2: #A3A7AB;
    --seam: #41464C;
    --seam-soft: #33373C;
    --hi: rgba(255, 255, 255, .07);
    --lo: rgba(0, 0, 0, .45);
    --poppy: #D8434D;
    --moss: #79AD56;
    --amber: #DB9C40;
    --idle: #767A80;
    --slate: #121417;
    --focus: #6FA8E0;
    --shard: #C38BFF;
    color-scheme: dark;
  }
}

* { box-sizing: border-box; }
html, body { margin: 0; height: 100%; }
body {
  background: var(--iron);
  color: var(--ink);
  font: 16px/1.5 var(--body);
  -webkit-font-smoothing: antialiased;
}
[hidden] { display: none !important; }
h1, h2, h3 { font-family: var(--head); font-weight: 600; margin: 0; letter-spacing: .01em; }
p { margin: 0; }
a { color: inherit; }
:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
svg { width: 16px; height: 16px; fill: currentColor; flex: none; }

/* ---------- buttons: little iron plates with a bevel ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  min-height: 38px; padding: 0 14px;
  font: 600 15px/1 var(--head);
  color: var(--ink);
  background: var(--plate);
  border: 1px solid var(--seam);
  border-radius: 3px;
  box-shadow: inset 0 1px 0 var(--hi), inset 0 -2px 0 var(--lo);
  cursor: pointer;
  white-space: nowrap;
}
.btn:hover { background: var(--plate-2); }
.btn:active { box-shadow: inset 0 2px 0 var(--lo); padding-top: 2px; }
.btn.primary { background: var(--poppy); border-color: color-mix(in srgb, var(--poppy) 70%, black); color: var(--poppy-ink); }
.btn.primary:hover { background: color-mix(in srgb, var(--poppy) 88%, black); }
.btn.icon { width: 38px; padding: 0; }
.btn.wide { width: 100%; }
.btn.subtle { background: transparent; box-shadow: none; border-color: transparent; color: var(--ink-2); }
.btn.subtle:hover { background: var(--plate-2); color: var(--ink); }
.btn.danger { color: var(--poppy); }
.btn[disabled] { opacity: .5; cursor: default; }

/* ---------- fields ---------- */
.field { display: grid; gap: 6px; margin: 0 0 16px; border: 0; padding: 0; min-width: 0; }
.field > span, .field > legend { font-weight: 700; font-size: 14px; padding: 0; }
.field em { font-style: normal; font-weight: 400; color: var(--ink-2); }
input, select, textarea {
  font: 16px/1.4 var(--body); color: var(--ink);
  background: var(--plate); border: 1px solid var(--seam); border-radius: 3px;
  padding: 9px 11px; width: 100%; min-width: 0;
  box-shadow: inset 0 2px 0 var(--lo);
}
textarea { resize: vertical; min-height: 96px; font-size: 15px; }
input[type=checkbox], input[type=radio] { width: auto; box-shadow: none; accent-color: var(--poppy); }
.hint { color: var(--ink-2); font-size: 14px; }
.form-error { color: var(--poppy); font-size: 14px; min-height: 0; }
.form-error:empty { display: none; }
.form-error:not(:empty) { margin: -4px 0 12px; }

.segmented { display: flex; border: 1px solid var(--seam); border-radius: 3px; overflow: hidden; }
.segmented label { flex: 1; position: relative; }
.segmented input { position: absolute; opacity: 0; inset: 0; }
.segmented span { display: block; padding: 9px 10px; text-align: center; font: 600 14px/1.3 var(--head); background: var(--plate); cursor: pointer; }
.segmented label + label span { border-left: 1px solid var(--seam); }
.segmented input:checked + span { background: var(--ink); color: var(--iron); }
.segmented input:focus-visible + span { outline: 2px solid var(--focus); outline-offset: -3px; }

.switch { display: flex; gap: 10px; align-items: flex-start; margin: 0 0 10px; cursor: pointer; }
.switch input { margin-top: 4px; }

/* ---------- sign in ---------- */
.gate { min-height: 100%; display: grid; place-items: center; padding: 24px 16px; }
.gate-plate {
  width: min(380px, 100%);
  background: var(--plate); border: 1px solid var(--seam); border-radius: 4px;
  box-shadow: inset 0 1px 0 var(--hi), 0 2px 0 var(--lo);
  padding: 32px 28px 28px;
}
.gate-mark { image-rendering: pixelated; display: block; margin-bottom: 18px; }
.gate h1 { font-size: 30px; font-weight: 700; }
.gate-plate > p { color: var(--ink-2); margin: 4px 0 22px; }

/* ---------- layout ---------- */
.app { height: 100%; display: flex; flex-direction: column; }
.topbar {
  display: flex; align-items: center; gap: 16px;
  padding: 10px 16px;
  background: var(--plate);
  border-bottom: 1px solid var(--seam);
  box-shadow: inset 0 1px 0 var(--hi);
}
.brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font: 700 19px/1 var(--head); }
.brand img, .empty img { image-rendering: pixelated; }
.tally { color: var(--ink-2); font-size: 15px; }
.top-actions { margin-left: auto; display: flex; gap: 8px; }

.work { flex: 1; display: grid; grid-template-columns: 300px 1fr; min-height: 0; }
.roster { border-right: 1px solid var(--seam); overflow-y: auto; padding: 8px 0; }
.detail { overflow-y: auto; min-width: 0; }

/* ---------- roster ---------- */
.roster-row {
  display: grid; grid-template-columns: 12px 1fr; gap: 4px 12px; align-items: center;
  width: 100%; padding: 12px 16px 12px 18px; text-align: left;
  background: none; border: 0; border-left: 3px solid transparent; color: inherit; cursor: pointer;
  font: inherit;
}
.roster-row:hover { background: color-mix(in srgb, var(--plate) 55%, transparent); }
.roster-row[aria-current="true"] { background: var(--plate); border-left-color: var(--ink); }
.roster-row strong { font: 600 17px/1.2 var(--head); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.roster-row small { grid-column: 2; color: var(--ink-2); font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.roster-row .mini { grid-column: 2; height: 4px; display: flex; background: var(--seam-soft); border-radius: 1px; overflow: hidden; margin-top: 4px; }
.mini i, .strip i { display: block; height: 100%; }
.roster-foot { display: flex; gap: 8px; padding: 12px 16px; border-top: 1px solid var(--seam-soft); margin-top: 8px; }
.roster-foot .btn { flex: 1; min-height: 34px; font-size: 14px; }

.pip { width: 12px; height: 12px; border-radius: 1px; background: var(--idle); box-shadow: inset 0 -2px 0 rgba(0,0,0,.25); }
.pip.online { background: var(--moss); }
.pip.connecting, .pip.waiting, .pip.signin { background: var(--amber); }
.pip.error, .pip.paused { background: var(--poppy); }
@media (prefers-reduced-motion: no-preference) {
  .pip.connecting, .pip.signin { animation: blink 1.1s steps(2, jump-none) infinite; }
}
@keyframes blink { 50% { opacity: .35; } }

/* ---------- bot detail ---------- */
.empty { max-width: 460px; margin: 12vh auto 0; padding: 0 20px; }
.empty h2 { font-size: 26px; margin: 18px 0 8px; }
.empty p { color: var(--ink-2); margin-bottom: 22px; }

.bot { max-width: 920px; padding: 24px 28px 40px; }
.bot-head { display: flex; align-items: flex-start; gap: 14px; }
.back { display: none; }
.bot-title { flex: 1; min-width: 0; }
.bot-title h2 { font-size: 32px; font-weight: 700; line-height: 1.1; overflow-wrap: anywhere; }
.bot-title p { color: var(--ink-2); margin-top: 4px; overflow-wrap: anywhere; }
.bot-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
.status-line { margin: 14px 0 20px; font-size: 17px; display: flex; gap: 10px; align-items: baseline; }
.status-line .pip { flex: none; transform: translateY(1px); }
.status-line em { font-style: normal; color: var(--ink-2); }

.signin-box {
  display: grid; grid-template-columns: 1fr auto; gap: 20px; align-items: center;
  padding: 18px 20px; margin-bottom: 20px;
  background: var(--plate); border: 1px solid var(--amber); border-left-width: 4px; border-radius: 3px;
}
.signin-box h3 { font-size: 19px; margin-bottom: 4px; }
.signin-box p { color: var(--ink-2); }
.signin-box a { color: var(--ink); font-weight: 700; }
.code-box { display: grid; gap: 8px; justify-items: center; }
.code-box strong { font: 700 30px/1 var(--head); letter-spacing: .14em; padding: 8px 12px; background: var(--iron); border: 1px dashed var(--seam); border-radius: 3px; }

/* the memorable part: live pixel vitals */
.vitals {
  display: grid; grid-template-columns: auto 1fr; gap: 16px 32px; align-items: center;
  padding: 18px 20px; background: var(--slate); color: var(--slate-ink); border-radius: 3px;
  border: 1px solid var(--seam); box-shadow: inset 0 2px 0 rgba(0,0,0,.35);
}
.bars { display: grid; gap: 8px; }
.bar { display: flex; gap: 2px; }
.bar svg { width: 22px; height: 22px; image-rendering: pixelated; shape-rendering: crispEdges; }
.bar.off { opacity: .28; filter: grayscale(1); }
.facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 10px 20px; margin: 0; }
.facts div { min-width: 0; }
.facts dt { font-size: 13px; color: color-mix(in srgb, var(--slate-ink) 62%, transparent); }
.facts dd { margin: 0; font: 600 17px/1.3 var(--head); overflow-wrap: anywhere; }
.actionbar { margin-top: 8px; color: var(--ink-2); font-size: 14px; }

.uptime { margin: 26px 0 8px; }
.uptime-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 8px; }
.uptime-head h3 { font-size: 17px; }
.uptime-head p { color: var(--ink-2); font-size: 14px; }
.strip {
  display: flex; height: 26px; background: var(--seam-soft); border: 1px solid var(--seam); border-radius: 2px; overflow: hidden;
  background-image: repeating-linear-gradient(90deg, transparent 0 calc(100% / 24 - 1px), color-mix(in srgb, var(--iron) 60%, transparent) calc(100% / 24 - 1px) calc(100% / 24));
}
.strip i.on { background: var(--moss); }
.strip i.off, .mini i.off { background: transparent; }
.mini i.on { background: var(--moss); }
.ticks { position: relative; height: 18px; font-size: 12px; color: var(--ink-2); }
.ticks span { position: absolute; top: 3px; transform: translateX(-50%); white-space: nowrap; }
.ticks span:first-child { transform: none; }
.ticks span:last-child { transform: translateX(-100%); }

.tabs { display: flex; gap: 4px; margin: 26px 0 0; border-bottom: 1px solid var(--seam); }
.tab {
  font: 600 16px/1 var(--head); color: var(--ink-2); background: none; border: 1px solid transparent; border-bottom: 0;
  padding: 11px 16px; border-radius: 3px 3px 0 0; cursor: pointer; margin-bottom: -1px;
}
.tab[aria-selected="true"] { color: var(--ink); background: var(--plate); border-color: var(--seam); }
.pane { background: var(--plate); border: 1px solid var(--seam); border-top: 0; border-radius: 0 0 3px 3px; }

.console {
  height: 420px; overflow-y: auto; padding: 12px 14px;
  background: var(--slate); color: var(--slate-ink);
  font: 15px/1.45 var(--body);
}
.console .line { display: grid; grid-template-columns: 4.6em 1fr; gap: 10px; padding: 1px 0; }
.console time { color: #7E838A; font-size: 13px; padding-top: 2px; font-variant-numeric: tabular-nums; white-space: nowrap; }
.console .text { overflow-wrap: anywhere; white-space: pre-wrap; }
.console .info .text { color: #9DB8D1; }
.console .error .text { color: #F07A80; }
.console .you .text { color: #B8D99C; }
.console .server .text { color: #D7D9D2; }
.console .note { color: #7E838A; padding: 8px 0; }
.say { display: flex; gap: 8px; padding: 10px; }
.say input { flex: 1; }

/* bot settings */
.settings-form { padding: 22px 22px 0; }
.settings-form .group { padding-bottom: 22px; margin-bottom: 22px; border-bottom: 1px solid var(--seam-soft); }
.group h3 { font-size: 18px; margin-bottom: 4px; }
.group > .hint { margin-bottom: 14px; }
.two { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; }
.three { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 0 16px; }
.inline { display: flex; gap: 8px; margin-bottom: 8px; }
.checks { display: flex; flex-wrap: wrap; gap: 8px 22px; margin: 6px 0 14px; }
.checks label { display: flex; gap: 8px; align-items: center; cursor: pointer; }
.cmd-help { font-size: 14px; color: var(--ink-2); margin: 8px 0 0; padding-left: 0; list-style: none; display: grid; gap: 2px; }
.cmd-help code { font: 600 14px var(--head); color: var(--ink); background: var(--plate-2); padding: 0 5px; border-radius: 2px; }
.account { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
.save-bar {
  position: sticky; bottom: 0; display: flex; gap: 10px; align-items: center;
  margin: 0 -22px; padding: 12px 22px; background: var(--plate); border-top: 1px solid var(--seam);
}
.save-bar .grow, footer .grow { flex: 1; }
.save-bar p { color: var(--ink-2); font-size: 14px; }

/* dialogs */
.sheet {
  width: min(480px, calc(100% - 24px)); padding: 0; color: var(--ink);
  background: var(--plate); border: 1px solid var(--seam); border-radius: 4px;
  box-shadow: inset 0 1px 0 var(--hi), 0 18px 40px rgba(0,0,0,.35);
}
.wide-sheet { width: min(640px, calc(100% - 24px)); }
.sheet::backdrop { background: rgba(20, 22, 25, .55); }
.sheet form { padding: 0 22px 18px; max-height: 88vh; overflow-y: auto; }
.sheet header { display: flex; align-items: center; justify-content: space-between; padding: 18px 0 14px; }
.sheet header h2 { font-size: 22px; }
.sheet header .btn { border-color: transparent; box-shadow: none; background: none; }
.sheet .group { padding-bottom: 18px; margin-bottom: 18px; border-bottom: 1px solid var(--seam-soft); }
.sheet footer { display: flex; gap: 8px; justify-content: flex-end; align-items: center; padding-top: 6px; flex-wrap: wrap; }

.toast {
  position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%);
  background: var(--ink); color: var(--iron); padding: 10px 16px; border-radius: 3px;
  font-size: 15px; max-width: calc(100% - 32px); box-shadow: 0 6px 20px rgba(0,0,0,.3); z-index: 10;
}

/* ---------- phones ---------- */
@media (max-width: 760px) {
  .work { grid-template-columns: 1fr; }
  .roster { border-right: 0; }
  .app.show-bot .roster { display: none; }
  .app:not(.show-bot) .detail { display: none; }
  .back { display: inline-flex; }
  .tally { display: none; }
  .top-actions .btn span { display: none; }
  .top-actions .btn:not(.icon) { width: 38px; padding: 0; }
  .bot { padding: 16px 14px 32px; }
  .bot-head { flex-wrap: wrap; }
  .bot-title h2 { font-size: 26px; }
  .bot-actions { width: 100%; justify-content: flex-start; }
  .vitals { grid-template-columns: 1fr; padding: 14px; }
  .bar svg { width: 18px; height: 18px; }
  .signin-box { grid-template-columns: 1fr; }
  .code-box { justify-items: start; }
  .console { height: 52vh; }
  .two, .three { grid-template-columns: 1fr; }
  .inline { flex-direction: column; }
}

/* ---------- screenshots ---------- */
.screen { margin: 0 0 18px; }
.screen-frame {
  position: relative; aspect-ratio: 16 / 9; background: var(--slate); border: 1px solid var(--seam); border-radius: 3px; overflow: hidden;
}
.screen-frame img { display: block; width: 100%; height: 100%; object-fit: cover; image-rendering: pixelated; }
.screen-frame img:not([src]) { visibility: hidden; }
.screen-empty { position: absolute; inset: 0; display: grid; place-items: center; padding: 20px; text-align: center; color: var(--slate-ink); opacity: .8; }
.screen-empty:empty { display: none; }
.labels { position: absolute; inset: 0; pointer-events: none; }
.labels span {
  position: absolute; transform: translate(-50%, -100%); white-space: nowrap;
  background: rgba(0, 0, 0, .55); color: #fff; font: 600 13px/1 var(--head); padding: 3px 5px 2px; border-radius: 2px;
}
.screen figcaption { display: flex; gap: 12px; align-items: center; justify-content: space-between; margin-top: 8px; color: var(--ink-2); font-size: 14px; flex-wrap: wrap; }
.screen figcaption .btn { min-height: 34px; font-size: 14px; }

.overview { padding: 24px 28px 40px; }
.overview-head { margin-bottom: 16px; display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
.overview-head h2 { font-size: 28px; font-weight: 700; }
.overview-head p { color: var(--ink-2); }
.shot-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
.shot-card {
  display: flex; flex-direction: column; justify-content: flex-start; width: 100%; text-align: left; padding: 0; cursor: pointer; color: inherit; font: inherit;
  background: var(--plate); border: 1px solid var(--seam); border-radius: 3px; overflow: hidden;
  box-shadow: inset 0 1px 0 var(--hi), 0 2px 0 var(--lo);
}
.shot-card:hover { border-color: var(--ink-2); }
.shot-card .screen-frame { border: 0; border-bottom: 1px solid var(--seam); border-radius: 0; }
.shot-card .meta { display: grid; grid-template-columns: 12px 1fr; gap: 2px 10px; align-items: center; padding: 10px 12px; }
.shot-card strong { font: 600 16px/1.2 var(--head); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.shot-card small { grid-column: 2; color: var(--ink-2); font-size: 13px; }
.btn[aria-pressed="true"] { background: var(--ink); color: var(--iron); border-color: var(--ink); }

/* ---------- chat senders ---------- */
.console .who {
  display: inline-flex; align-items: center; gap: 5px; margin-right: 8px; vertical-align: 1px;
  font: 600 13px/1 var(--head); color: #E8E9E4; background: rgba(255, 255, 255, .09); border-radius: 2px; padding: 2px 6px 2px 2px;
}
.console .who img, .console .who i { width: 16px; height: 16px; image-rendering: pixelated; border-radius: 1px; }
.console .who i { display: inline-grid; place-items: center; font-style: normal; font-size: 10px; background: #4A4F57; }
.console .who.me { background: rgba(140, 200, 100, .18); color: #CBE8B4; }
.console .who.sys { padding: 2px 6px; color: #9EA3A9; background: transparent; border: 1px solid rgba(255,255,255,.12); }

/* ---------- macros ---------- */
.macros { padding: 18px 20px 20px; }
.macros .intro { color: var(--ink-2); margin-bottom: 14px; font-size: 15px; }
.macro-row {
  display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; align-items: center;
  padding: 12px 14px; border: 1px solid var(--seam); border-radius: 3px; background: var(--iron); margin-bottom: 10px;
}
.macro-row strong { font: 600 18px/1.2 var(--head); }
.macro-row small { grid-column: 1; color: var(--ink-2); font-size: 14px; }
.macro-row .row-actions { grid-row: 1 / span 2; grid-column: 2; display: flex; gap: 8px; }
.macro-row.running { border-color: var(--moss); box-shadow: inset 3px 0 0 var(--moss); }
.macro-empty { padding: 18px; border: 1px dashed var(--seam); border-radius: 3px; color: var(--ink-2); margin-bottom: 12px; }
.steps { list-style: none; padding: 0; margin: 0 0 12px; counter-reset: step; }
.step {
  display: grid; grid-template-columns: 30px 1fr auto; gap: 10px; align-items: start;
  padding: 10px 12px; background: var(--iron); border: 1px solid var(--seam-soft); border-radius: 3px; margin-bottom: 6px;
}
.step::before { counter-increment: step; content: counter(step); font: 700 18px/1 var(--head); color: var(--ink-2); padding-top: 9px; text-align: center; }
.step.now { border-color: var(--moss); background: color-mix(in srgb, var(--moss) 12%, var(--iron)); }
.step-body { display: grid; gap: 6px; min-width: 0; }
.step-body > b { font: 600 15px/1.2 var(--head); padding-top: 2px; }
.step-fields { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.step-fields input, .step-fields select { width: auto; min-width: 0; padding: 7px 9px; font-size: 15px; }
.step-fields .xyz { width: 92px; }
.step-fields .wide { flex: 1 1 220px; }
.step-fields .btn { min-height: 34px; font-size: 14px; }
.step-tools { display: flex; gap: 2px; }
.step-tools .btn { width: 32px; min-height: 32px; border-color: transparent; background: transparent; box-shadow: none; }
.step-tools .btn:hover { background: var(--plate-2); }
.add-step { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 16px; }
.add-step select { width: auto; flex: 0 1 280px; }
.macro-opts { display: grid; gap: 4px; margin-bottom: 16px; }
.macro-foot { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; padding-top: 14px; border-top: 1px solid var(--seam-soft); }
.macro-foot .grow { flex: 1; }
.note-box { padding: 10px 12px; background: var(--plate-2); border-left: 3px solid var(--amber); border-radius: 2px; font-size: 14px; color: var(--ink-2); margin-bottom: 14px; }

@media (max-width: 760px) {
  .overview { padding: 16px 14px 32px; }
  .shot-grid { grid-template-columns: 1fr; }
  .macro-row { grid-template-columns: 1fr; }
  .macro-row .row-actions { grid-row: auto; grid-column: 1; }
  .step { grid-template-columns: 22px 1fr; }
  .step-tools { grid-column: 2; }
  .step-fields .xyz { width: 76px; }
}

/* ---------- updates ---------- */
.upd-actions { flex-wrap: wrap; }
.upd-bar { height: 8px; background: var(--seam-soft); border-radius: 2px; overflow: hidden; margin: 8px 0 12px; }
.upd-bar i { display: block; height: 100%; width: 0; background: var(--moss); transition: width .2s; }
#updatePill { min-height: 38px; }
@media (max-width: 760px) { #updatePill span { display: inline; } #updatePill { width: auto; padding: 0 12px; } }

.code-box .btn { width: 100%; }

.code-way { margin-top: 10px; font-size: 14px; color: var(--ink-2); }
.code-way summary { cursor: pointer; font-weight: 700; color: var(--ink); width: max-content; }
.code-way p { margin-top: 6px; }
.code-way strong { font: 700 16px var(--head); letter-spacing: .08em; color: var(--ink); }
.btn.small { min-height: 28px; padding: 0 8px; font-size: 13px; }
.code-box .hint { max-width: 220px; text-align: center; }

.shot-card small.shards { color: var(--shard); font: 600 15px/1.3 var(--head); }
.facts dd.shards { color: #D59BFF; }

.total-shards {
  display: grid; justify-items: end; gap: 2px; padding: 10px 16px;
  background: var(--plate); border: 1px solid var(--seam); border-radius: 3px; box-shadow: inset 0 1px 0 var(--hi);
}
.total-shards span { font: 600 14px var(--head); color: var(--ink-2); }
.total-shards strong { font: 700 30px/1 var(--head); color: var(--shard); }
.total-shards small { font-size: 13px; color: var(--ink-2); }
@media (max-width: 760px) { .total-shards { justify-items: start; width: 100%; } }

/* ---------- groups ---------- */
.group-row { display: grid; grid-template-columns: 1fr 2fr auto auto; gap: 8px; align-items: start; padding: 10px 0; border-bottom: 1px solid var(--seam-soft); }
.group-row input { padding: 8px 10px; font-size: 15px; }
.group-row .btn { min-height: 38px; }
.group-row .test-result { grid-column: 1 / -1; font-size: 13px; color: var(--ink-2); margin-top: -2px; }
.group-row .test-result.good { color: var(--moss); }
.group-row .test-result.bad { color: var(--poppy); }
.group-row .members { grid-column: 1 / -1; font-size: 13px; color: var(--ink-2); }
#groupRows:empty::before { content: "No groups yet."; display: block; padding: 12px 0; color: var(--ink-2); }
#addGroup { margin: 12px 0 8px; }
.hint code { font: 600 13px var(--head); background: var(--plate-2); padding: 0 4px; border-radius: 2px; color: var(--ink); }
.roster-group { display: flex; align-items: center; gap: 6px; padding: 14px 16px 4px 18px; }
.roster-group strong { font: 700 13px/1.2 var(--head); color: var(--ink-2); flex: 1; letter-spacing: .02em; }
.roster-group small { font-size: 12px; color: var(--ink-2); }
.roster-group .btn { min-height: 26px; width: 26px; padding: 0; border-color: transparent; background: transparent; box-shadow: none; }
.roster-group .btn:hover { background: var(--plate); }
.roster-group .btn svg { width: 12px; height: 12px; }
@media (max-width: 760px) { .group-row { grid-template-columns: 1fr; } }

.shot-card small.shards .rate { font: 400 13px var(--body); color: var(--ink-2); margin-left: 6px; }
.total-shards #totalShardsRate { color: var(--shard); font-weight: 700; }
.grid-empty { grid-column: 1 / -1; color: var(--ink-2); padding: 24px 0; }
