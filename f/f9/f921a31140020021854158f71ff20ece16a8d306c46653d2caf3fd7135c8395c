async function openSettings () {
  const data = await api('GET', '/api/settings')
  const s = data.settings
  const f = $('#setForm')
  f.afkCommand.value = s.afkCommand || ''
  f.goalCount.value = s.goalCount || ''
  f.mainName.value = s.mainName || ''
  f.humanize.checked = s.humanize !== false
  f.snow.checked = s.snow !== false
  f.restartWait.value = s.restartWait || 90
  f.summaryTime.value = s.summaryTime || '23:55'
  f.autoAfk.checked = s.autoAfk !== false
  f.startDelay.value = s.startDelay ?? 3
  renderBuyOptions()
  const proxied = state.groups.filter(g => g.proxy).length
  $('#groupSummary').textContent = state.groups.length ? `${plural(state.groups.length, 'group')}, ${proxied} with a proxy.` : 'No groups yet.'
  f.webhookUrl.value = s.webhookUrl
  for (const k of Object.keys(s.alerts)) if (f['a_' + k]) f['a_' + k].checked = s.alerts[k]
  f.lowHealth.value = String(s.lowHealth)
  if (!f.lowHealth.value) f.lowHealth.value = '6'
  f.keywords.value = s.keywords
  f.allowPhone.checked = s.allowPhone
  f.startWithWindows.checked = s.startWithWindows
  $('#startupRow').hidden = !data.windows
  f.port.value = s.port
  f.password.value = ''
  $('#lanHint').textContent = data.lan.length ? `On your phone, open ${data.lan.map(ip => `http://${ip}:${s.port}`).join(' or ')}.` : 'No Wi-Fi or network address found on this computer.'
  $('#setError').textContent = ''
  $('#testResult').textContent = ''
  api('GET', '/api/update').then(u => { state.update = u; renderUpdate() }).catch(() => {})
  $('#setDialog').showModal()
}
$('#settingsBtn').addEventListener('click', () => openSettings().catch(e => toast(e.message)))
$('#setForm').addEventListener('submit', async e => {
  e.preventDefault()
  const f = e.currentTarget
  const alerts = {}
  for (const el of f.querySelectorAll('input[name^="a_"]')) alerts[el.name.slice(2)] = el.checked
  const body = {
    afkCommand: f.afkCommand.value, autoAfk: f.autoAfk.checked, buyMob: f.buyMob.value, startDelay: f.startDelay.value,
    goalCount: f.goalCount.value || 0, goalMob: f.goalMob.value, mainName: f.mainName.value, humanize: f.humanize.checked, snow: f.snow.checked,
    restartWait: f.restartWait.value, summaryTime: f.summaryTime.value,
    webhookUrl: f.webhookUrl.value, alerts, lowHealth: f.lowHealth.value, keywords: f.keywords.value,
    allowPhone: f.allowPhone.checked, port: f.port.value
  }
  if (!$('#startupRow').hidden) body.startWithWindows = f.startWithWindows.checked
  if (f.password.value) body.password = f.password.value
  try {
    const before = await api('GET', '/api/settings')
    const res = await api('PATCH', '/api/settings', body)
    const r = res.settings
    state.settings = { afkCommand: r.afkCommand, autoAfk: r.autoAfk, buyMob: r.buyMob, goalMob: r.goalMob, goalCount: r.goalCount, mainName: r.mainName, snow: r.snow, humanize: r.humanize }
    $('#setDialog').close()
    render()
    const restart = before.settings.port !== Number(body.port) || before.settings.allowPhone !== body.allowPhone
    toast(restart ? 'Saved. Close and reopen Golem AFK to use the new port or phone setting.' : 'Settings saved.')
  } catch (err) { $('#setError').textContent = err.message }
})
