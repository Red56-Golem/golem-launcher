      <label class="switch"><input type="checkbox" name="antiAfk.on" ${c.antiAfk.on ? 'checked' : ''}><span>Do a small random action every so often so the server doesn't kick it</span></label>
      <div class="two"><label class="field"><span>About every (seconds)</span><input name="antiAfk.every" type="number" min="5" max="600" value="${esc(c.antiAfk.every)}"></label></div>
      <div class="checks" ${bedrock ? 'hidden' : ''}>${AFK_ACTIONS.map(([k, t]) => `<label><input type="checkbox" name="afk:${k}" ${c.antiAfk.actions.includes(k) ? 'checked' : ''}> ${t}</label>`).join('')}</div>
    </section>
    <section class="group">
      <h3>Staying online</h3>
      <label class="switch"><input type="checkbox" name="reconnect.on" ${c.reconnect.on ? 'checked' : ''}><span>Reconnect when kicked or disconnected</span></label>
      <div class="two">
        <label class="field"><span>First wait (seconds)</span><input name="reconnect.delay" type="number" min="5" max="300" value="${esc(c.reconnect.delay)}"></label>
        <label class="field"><span>If I log in on this account myself</span>
          <select name="reconnect.onDuplicate"><option value="wait" ${c.reconnect.onDuplicate === 'wait' ? 'selected' : ''}>Pause until I press Start</option><option value="later" ${c.reconnect.onDuplicate === 'later' ? 'selected' : ''}>Try again after 30 minutes</option></select>
        </label>
      </div>
      <label class="switch" ${bedrock ? 'hidden' : ''}><input type="checkbox" name="autoEat" ${c.autoEat ? 'checked' : ''}><span>Eat food when hungry</span></label>
      <label class="switch"><input type="checkbox" name="alerts" ${c.alerts ? 'checked' : ''}><span>Send Discord alerts for this account</span></label>
    </section>
    <footer><button type="button" class="btn" data-close>Cancel</button><button class="btn primary">Save</button></footer>`
  $('#botDialog').showModal()
}
$('#botForm').addEventListener('submit', async e => {
  e.preventDefault()
  const f = e.currentTarget
  const v = n => f.elements[n]
  const data = {
    host: v('host').value, port: v('port').value, label: v('label').value, group: v('group').value,
    joinCommands: v('joinCommands').value,
    antiAfk: { on: v('antiAfk.on').checked, every: v('antiAfk.every').value, actions: AFK_ACTIONS.map(a => a[0]).filter(k => v('afk:' + k).checked) },
    reconnect: { on: v('reconnect.on').checked, delay: v('reconnect.delay').value, onDuplicate: v('reconnect.onDuplicate').value },
    autoEat: v('autoEat').checked, alerts: v('alerts').checked
  }
  if (v('version')) data.version = v('version').value
  try {
    const res = await api('PATCH', `/api/bots/${botFormId}`, data)
    state.bots.set(botFormId, res.bot)
    $('#botDialog').close()
    renderSoon()
    if (res.needsRestart && confirm('Saved. Reconnect now to use the new server settings?')) await api('POST', `/api/bots/${botFormId}/restart`)
    else toast('Saved.')
  } catch (err) { toast(err.message, 6000) }
})
