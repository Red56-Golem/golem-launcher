// Windows startup

function startupFile () {
  return path.join(process.env.APPDATA || '', 'Microsoft', 'Windows', 'Start Menu', 'Programs', 'Startup', 'Golem AFK.vbs')
}
function setStartup (on) {
  if (process.platform !== 'win32') return 'Starting with Windows only works on Windows.'
  try {
    if (on) {
      // run the start file hidden, so it restarts the app if it ever crashes
      const bat = path.join(__dirname, '..', '..', 'Start Golem AFK.bat')
      const target = fs.existsSync(bat)
        ? `"""${bat}"" --background"`
        : `"""${process.execPath}"" ""${path.join(__dirname, 'server.js')}"" --background"`
      const vbs = 'Set sh = CreateObject("WScript.Shell")\r\n' +
        `sh.CurrentDirectory = "${path.dirname(fs.existsSync(bat) ? bat : process.execPath)}"\r\n` +
        `sh.Run ${target}, 0, False\r\n`
      fs.writeFileSync(startupFile(), vbs)
    } else {
      fs.rmSync(startupFile(), { force: true })
    }
  } catch (e) {
    return "Couldn't change the Windows startup setting: " + e.message
  }
  return ''
}

