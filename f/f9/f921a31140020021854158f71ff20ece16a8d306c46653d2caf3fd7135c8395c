function renderSide (bots) {
  const ranked = bots.map(b => ({ b, n: earnedToday(b) })).filter(x => x.n > 0).sort((a, b) => b.n - a.n).slice(0, 5)
  const max = ranked.length ? ranked[0].n : 1
  $('#nice').innerHTML = ranked.length
