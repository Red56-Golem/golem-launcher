'use strict'
// Golem AFK dashboard
const $ = (s, root = document) => root.querySelector(s)
const state = { bots: new Map(), logs: new Map(), history: new Map(), selected: null, versions: [], settings: null, tab: 'chat', dirty: false, sent: [], sentAt: -1, view: 'bot', macroEdit: null }

// ---------- helpers ----------
function esc (s) {
  return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]))
}
async function api (method, url, body) {
  const res = await fetch(url, { method, headers: body ? { 'content-type': 'application/json' } : {}, body: body ? JSON.stringify(body) : undefined })
  const data = await res.json().catch(() => ({}))
  if (res.status === 401 && !url.startsWith('/api/login') && !url.startsWith('/api/setup')) { showGate(); throw new Error(data.error || 'Sign in first.') }
  if (!res.ok) throw new Error(data.error || `Something went wrong (${res.status}).`)
  return data
}
let toastTimer
function toast (text) {
  const t = $('#toast')
  t.textContent = text
  t.hidden = false
  clearTimeout(toastTimer)
  toastTimer = setTimeout(() => { t.hidden = true }, 3200)
}
function duration (ms) {
  const s = Math.max(0, Math.round(ms / 1000))
  if (s < 60) return `${s} s`
  const m = Math.floor(s / 60)
  if (m < 60) return `${m} min`
  const h = Math.floor(m / 60)
  if (h < 48) return `${h} h ${m % 60} min`
  return `${Math.floor(h / 24)} days ${h % 24} h`
}
function clock (t) {
  return new Date(t).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })
}
function nameOf (b) { return b.cfg.label || b.cfg.account || b.cfg.name || 'New bot' }
function defaultPort (b) { return b.cfg.edition === 'bedrock' ? 19132 : 25565 }
function serverOf (b) { return b.cfg.host + (Number(b.cfg.port) !== defaultPort(b) ? ':' + b.cfg.port : '') }
function ago (t) { return duration(Date.now() - t) + ' ago' }

// ---------- sign in ----------
async function boot () {
  const s = await fetch('/api/session').then(r => r.json())
  state.version = s.version
  if (!s.signedIn) return showGate(s.needsPassword)
  showApp()
}
function showGate (needsPassword) {
  $('#app').hidden = true
  $('#gate').hidden = false
  const first = !!needsPassword
  $('#gateForm').dataset.mode = first ? 'setup' : 'login'
  $('#gateText').textContent = first ? 'Pick a password for this dashboard. You need it to open the dashboard from your phone, too.' : 'Sign in to your bots.'
  $('#gateLabel').textContent = first ? 'New password (6 or more characters)' : 'Password'
  $('#gatePass').autocomplete = first ? 'new-password' : 'current-password'
  $('#gateBtn').textContent = first ? 'Set password' : 'Sign in'
  $('#gatePass').focus()
}
$('#gateForm').addEventListener('submit', async e => {
  e.preventDefault()
  const mode = e.currentTarget.dataset.mode
  $('#gateError').textContent = ''
  try {
    await api('POST', mode === 'setup' ? '/api/setup' : '/api/login', { password: $('#gatePass').value })
    $('#gatePass').value = ''
    showApp()
  } catch (err) { $('#gateError').textContent = err.message }
})

async function showApp () {
  $('#gate').hidden = true
  $('#app').hidden = false
  const data = await api('GET', '/api/bots')
  state.versions = data.versions
  state.bots.clear()
  for (const b of data.bots) state.bots.set(b.cfg.id, b)
  const keep = localStorage.getItem('golemafk.selected')
  state.selected = state.bots.has(keep) ? keep : (data.bots[0] && data.bots[0].cfg.id) || null
  render()
  if (state.selected) selectBot(state.selected, false)
  connectLive()
  api('GET', '/api/update').then(u => { state.update = u; renderUpdate() }).catch(() => {})
}

// ---------- live updates ----------
let ws
function connectLive () {
  if (ws && ws.readyState <= 1) return
  ws = new WebSocket(`${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/live`)
  ws.onmessage = ev => {
    const msg = JSON.parse(ev.data)
    if (msg.type === 'update') {
      state.update = msg.update
      renderUpdate()
    } else if (msg.type === 'hello') {
      for (const b of msg.bots) state.bots.set(b.cfg.id, b)
      render()
    } else if (msg.type === 'bot') {
      const before = state.bots.get(msg.bot.cfg.id)
      state.bots.set(msg.bot.cfg.id, msg.bot)
      if (before && before.status !== msg.bot.status) noteStatus(msg.bot)
      render()
    } else if (msg.type === 'removed') {
      state.bots.delete(msg.id)
      if (state.selected === msg.id) state.selected = [...state.bots.keys()][0] || null
      render()
      if (state.selected) selectBot(state.selected, false)
    } else if (msg.type === 'line') {
      const log = state.logs.get(msg.id)
      if (log) { log.push(msg.line); if (log.length > 100) log.shift() }
      if (msg.id === state.selected) appendLine(msg.line)
    }
  }
  ws.onclose = () => setTimeout(async () => {
    const s = await fetch('/api/session').then(r => r.json()).catch(() => null)
    if (s && state.version && s.version !== state.version) return location.reload()
    if (s && !s.signedIn) return showGate(s.needsPassword)
    connectLive()
  }, 2000)
}

// history comes with the log; keep it fresh from status changes too
function noteStatus (b) {
  const list = state.history.get(b.cfg.id)
  if (!list) return
  const s = b.status === 'online' ? 'on' : 'off'
  const last = list[list.length - 1]
  if (!last || last.s !== s) list.push({ t: Date.now(), s })
}

// ---------- rendering ----------
const STATUS_WORD = { stopped: 'Stopped', connecting: 'Connecting', signin: 'Needs sign-in', online: 'Online', waiting: 'Reconnecting', paused: 'Paused', error: 'Stopped with a problem' }

function render () {
  const bots = [...state.bots.values()]
  const online = bots.filter(b => b.status === 'online').length
  $('#tally').textContent = bots.length ? `${online} of ${bots.length} online` : ''
  const grid = state.view === 'grid' && bots.length > 0
  $('#empty').hidden = bots.length > 0
  $('#overview').hidden = !grid
  $('#bot').hidden = grid || !state.selected || !state.bots.has(state.selected)
  $('#gridBtn').setAttribute('aria-pressed', grid)
  $('#gridBtn').hidden = bots.length === 0
  renderRoster()
  if (grid) renderGrid()
  else renderBot()
}

// ---------- screenshots ----------
function shotURL (b) { return `/api/bots/${b.cfg.id}/shot.png?t=${Math.round(b.shot.t)}` }
function labelsHTML (b) {
  return (b.shot && b.shot.labels || []).map(l => `<span style="left:${(l.x * 100).toFixed(2)}%;top:${(l.y * 100).toFixed(2)}%">${esc(l.name)}</span>`).join('')
}
function shotNote (b) {
  if (b.shot) return ''
  return b.status === 'online' ? 'No screenshot yet. The first one comes a few seconds after the bot joins.' : 'No screenshot yet. Start the bot to get one.'
}
function renderScreen (b) {
  const img = $('#screenImg')
  const has = !!b.shot
  if (has) {
    const url = shotURL(b)
    if (img.getAttribute('src') !== url) img.src = url
    img.alt = `What ${nameOf(b)} sees`
  } else img.removeAttribute('src')
  $('#screenLabels').innerHTML = has ? labelsHTML(b) : ''
  $('#screenEmpty').textContent = has ? '' : shotNote(b)
  $('#shotBtn').disabled = b.status !== 'online' || state.shotBusy === b.cfg.id
  renderShotCaption(b)
}
function renderShotCaption (b) {
  const s = b.shot
  $('#screenCaption').textContent = s
    ? `Taken ${ago(s.t)}${s.facing ? `, facing ${s.facing} at ${s.x}, ${s.y}, ${s.z}` : ''}.`
    : ''
}
function renderGrid () {
  const bots = [...state.bots.values()]
  $('#shotGrid').innerHTML = bots.map(b => {
    const has = !!b.shot
    const s = b.stats || {}
    let where = b.status === 'online' && s.x !== undefined ? `${s.x}, ${s.y}, ${s.z}` : STATUS_WORD[b.status]
    if (b.status === 'online' && s.shards != null) where += `, ${s.shards} shards`
    return `<button class="shot-card" data-open="${b.cfg.id}">
      <div class="screen-frame">
        ${has ? `<img src="${shotURL(b)}" alt="What ${esc(nameOf(b))} sees" loading="lazy">` : ''}
        <div class="labels">${has ? labelsHTML(b) : ''}</div>
        <p class="screen-empty">${has ? '' : esc(shotNote(b))}</p>
      </div>
      <div class="meta"><span class="pip ${b.status}"></span><strong>${esc(nameOf(b))}</strong>
        <small>${esc(where)}${has ? `, picture from ${esc(ago(b.shot.t))}` : ''}</small></div>
    </button>`
  }).join('')
}
$('#gridBtn').addEventListener('click', () => {
  state.view = state.view === 'grid' ? 'bot' : 'grid'
  $('#app').classList.toggle('show-bot', state.view === 'grid')
  render()
})
$('#shotGrid').addEventListener('click', e => {
  const card = e.target.closest('[data-open]')
  if (!card) return
  state.view = 'bot'
  selectBot(card.dataset.open)
})
$('#shotBtn').addEventListener('click', async () => {
  const id = state.selected
  state.shotBusy = id
  $('#shotBtn').disabled = true
  $('#shotBtn span').textContent = 'Taking screenshot...'
  try {
    const res = await api('POST', `/api/bots/${id}/screenshot`)
    const b = state.bots.get(id)
    if (b) { b.shot = res.shot; if (id === state.selected) renderScreen(b) }
  } catch (err) { toast(err.message) }
  state.shotBusy = null
  $('#shotBtn span').textContent = 'Take screenshot now'
  const b = state.bots.get(state.selected)
  if (b) renderScreen(b)
})

function renderRoster () {
  const bots = [...state.bots.values()]
  const rows = bots.map(b => `
    <button class="roster-row" data-id="${b.cfg.id}" aria-current="${b.cfg.id === state.selected}">
      <span class="pip ${b.status}" title="${STATUS_WORD[b.status]}"></span>
      <strong>${esc(nameOf(b))}</strong>
      <small>${esc(rosterLine(b))}</small>
      <span class="mini" aria-hidden="true">${stripHTML(b.cfg.id)}</span>
    </button>`).join('')
  const any = bots.length > 1
  $('#roster').innerHTML = rows + (any
    ? `<div class="roster-foot"><button class="btn" data-all="start"><svg><use href="#i-play"/></svg><span>Start all</span></button><button class="btn" data-all="stop"><svg><use href="#i-stop"/></svg><span>Stop all</span></button></div>`
    : '')
}

function rosterLine (b) {
  if (b.status === 'online') return `${serverOf(b)}, online ${duration(Date.now() - b.onlineSince)}`
  if (b.status === 'waiting' && b.nextTry) return `Trying again in ${duration(b.nextTry - Date.now())}`
  return `${serverOf(b)}, ${STATUS_WORD[b.status].toLowerCase()}`
}

function renderBot () {
  const b = state.bots.get(state.selected)
  if (!b) return
  $('#botName').textContent = nameOf(b)
  const who = b.cfg.auth === 'offline' ? `offline name ${b.cfg.name}` : b.cfg.account ? `Microsoft account ${b.cfg.account}` : 'Microsoft account, not signed in yet'
  $('#botWhere').textContent = `${serverOf(b)}, ${b.edition === 'bedrock' ? 'Bedrock' : 'Java'}, ${who}`

  const running = b.status !== 'stopped' && b.status !== 'error' && b.status !== 'paused'
  $('#botActions').innerHTML = running
    ? `<button class="btn" data-act="restart"><svg><use href="#i-redo"/></svg><span>Restart</span></button><button class="btn" data-act="stop"><svg><use href="#i-stop"/></svg><span>Stop</span></button>`
    : `<button class="btn primary" data-act="start"><svg><use href="#i-play"/></svg><span>Start</span></button>`

  renderStatus(b)

  const sign = b.status === 'signin' && b.msa
  $('#signin').hidden = !sign
  $('#signinPC').hidden = !onThisPC
  $('#signinRemote').hidden = onThisPC
  if (sign && state.autoSignin === b.cfg.id && onThisPC) {
    state.autoSignin = null
    openSignin(b.cfg.id, true)
  }
  if (sign) {
    $('#signinCode').textContent = b.msa.code
    $('#signinLink').href = b.msa.url
    $('#signinLink').textContent = b.msa.url.replace(/^https?:\/\/(www\.)?/, '')
  }

  renderScreen(b)
  renderVitals(b)
  renderStrip()
  if (state.tab === 'macros' && !state.macroEdit) renderMacros()
}

function renderStatus (b) {
  let text = STATUS_WORD[b.status]
  let more = ''
  if (b.status === 'online') text = `Online for ${duration(Date.now() - b.onlineSince)}`
  if (b.status === 'waiting') {
    text = b.nextTry ? `Reconnecting in ${duration(b.nextTry - Date.now())}` : 'Reconnecting'
    more = b.detail ? `after: ${b.detail}` : ''
  }
  if (b.status === 'connecting' || b.status === 'paused' || b.status === 'error') more = b.detail || ''
  if (b.status === 'signin') more = 'Use the code below.'
  if (b.status === 'stopped' && b.detail) more = b.detail
  $('#statusLine').innerHTML = `<span class="pip ${b.status}"></span><span><strong>${esc(text)}</strong>${more ? ` <em>${esc(more)}</em>` : ''}</span>`
}

// pixel icons drawn on a 7x7 grid
const HEART = ['.XX.XX.', 'XHXXXXX', 'XXXXXXX', '.XXXXX.', '..XXX..', '...X...']
const MEAT = ['...BBB.', '..BBBBB', '..BBBBB', '.BBBBB.', '.WBB...', 'WW.....', 'W......']
function pixelIcon (rows, fill, empty, part, offY = 0) {
  // part: 2 full, 1 half (left half), 0 empty
  let r = ''
  rows.forEach((row, y) => {
    for (let x = 0; x < row.length; x++) {
      const c = row[x]
      if (c === '.') continue
      const lit = part === 2 || (part === 1 && x <= 3)
      const color = lit ? (fill[c] || fill.X) : empty
      r += `<rect x="${x}" y="${y + offY}" width="1" height="1" fill="${color}"/>`
    }
  })
  return `<svg viewBox="0 0 7 7" aria-hidden="true">${r}</svg>`
}
function iconRow (value, rows, fill, offY) {
  let out = ''
  for (let i = 0; i < 10; i++) {
    const left = value - i * 2
    out += pixelIcon(rows, fill, '#3B3F45', left >= 2 ? 2 : left === 1 ? 1 : 0, offY)
  }
  return out
}
function renderVitals (b) {
  const s = b.stats || {}
  const on = b.status === 'online' && typeof s.health === 'number'
  const health = on ? Math.round(s.health) : 20
  const food = on && typeof s.food === 'number' ? s.food : 20
  const hearts = $('#hearts')
  hearts.innerHTML = iconRow(health, HEART, { X: '#D8343E', H: '#F6C3C6' }, 0.5)
  hearts.classList.toggle('off', !on)
  hearts.setAttribute('aria-label', on ? `Health ${health / 2} of 10 hearts` : 'Health unknown while offline')
  const hunger = $('#hunger')
  hunger.innerHTML = iconRow(food, MEAT, { B: '#B8662F', W: '#EDE6D6' }, 0)
  hunger.classList.toggle('off', !on)
  hunger.setAttribute('aria-label', on ? `Hunger ${food / 2} of 10` : 'Hunger unknown while offline')

  const world = { overworld: 'Overworld', the_nether: 'Nether', the_end: 'The End' }
  $('#facts').innerHTML = on
    ? fact('Position', `${s.x}, ${s.y}, ${s.z}`) +
      fact('World', world[s.dimension] || s.dimension || 'Unknown') +
      fact('Ping', s.ping != null ? `${s.ping} ms` : 'Unknown') +
      fact('Players here', s.players ?? 'Unknown') +
      (s.shards != null ? fact('Shards', s.shards) : '')
    : `<div><dt>Not in a world</dt><dd>Health, food and position show up while the bot is online.</dd></div>`
  const bar = $('#actionBar')
  bar.hidden = !(on && s.actionBar)
  bar.textContent = on && s.actionBar ? s.actionBar : ''
}
function fact (k, v) { return `<div><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>` }

// 24 hour uptime strip
function segments (id, from, to) {
  const list = state.history.get(id) || []
  const out = []
  let cur = 'off'
  for (const h of list) { if (h.t <= from) cur = h.s; else break }
  let t = from
  for (const h of list) {
    if (h.t <= from) continue
    if (h.t >= to) break
    if (h.s !== cur) { out.push({ s: cur, w: h.t - t }); t = h.t; cur = h.s }
  }
  out.push({ s: cur, w: to - t })
  return out
}
function stripHTML (id) {
  const now = Date.now()
  const total = 24 * 3600e3
  if (!state.history.has(id)) {
    const b = state.bots.get(id)
    return b && b.status === 'online' ? '<i class="on" style="width:100%"></i>' : ''
  }
  return segments(id, now - total, now).map(g => `<i class="${g.s}" style="width:${(g.w / total * 100).toFixed(3)}%"></i>`).join('')
}
function renderStrip () {
  const id = state.selected
  if (!id) return
  const now = Date.now()
  const total = 24 * 3600e3
  $('#strip').innerHTML = stripHTML(id)
  const on = segments(id, now - total, now).filter(g => g.s === 'on').reduce((a, g) => a + g.w, 0)
  $('#uptimePct').textContent = state.history.has(id) ? `Online ${Math.round(on / total * 100)}% of the time` : ''
  let ticks = ''
  for (let i = 0; i <= 4; i++) {
    const t = now - total + (total / 4) * i
    ticks += `<span style="left:${i * 25}%">${i === 4 ? 'Now' : clock(t)}</span>`
  }
  $('#ticks').innerHTML = ticks
}

// ---------- selection ----------
async function selectBot (id, push = true) {
  if (state.dirty && state.selected !== id && !confirm('You have unsaved bot settings. Leave without saving?')) return
  if (state.macroEdit && state.selected !== id && !confirm('You have an unsaved macro. Leave it?')) return
  if (state.selected !== id) state.macroEdit = null
  state.dirty = false
  state.view = 'bot'
  state.selected = id
  localStorage.setItem('golemafk.selected', id)
  $('#app').classList.toggle('show-bot', push)
  render()
  renderSettings()
  $('#console').innerHTML = '<p class="note">Loading chat...</p>'
  try {
    const data = await api('GET', `/api/bots/${id}/log`)
    state.logs.set(id, data.log)
    state.history.set(id, data.history)
    if (state.selected !== id) return
    renderConsole()
    render()
  } catch (e) { $('#console').innerHTML = `<p class="note">${esc(e.message)}</p>` }
}

