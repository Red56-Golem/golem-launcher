function cleanBot (input, base) {
  const out = merge(base, {})
  const b = input || {}
  if (b.label !== undefined) out.label = String(b.label).slice(0, 40).trim()
  if (b.host !== undefined) out.host = String(b.host).trim().replace(/^.*:\/\//, '').replace(/\/.*$/, '').slice(0, 120)
  if (b.port !== undefined) out.port = clampInt(b.port, 1, 65535, 25565)
  if (b.version !== undefined) out.version = b.version === 'auto' || SUPPORTED.includes(b.version) ? b.version : 'auto'
  if (b.auth !== undefined) out.auth = b.auth === 'offline' ? 'offline' : 'microsoft'
  if (b.name !== undefined) out.name = String(b.name).trim().slice(0, 16)
  if (b.joinCommands !== undefined) out.joinCommands = String(b.joinCommands).slice(0, 4000)
  if (b.autoEat !== undefined) out.autoEat = !!b.autoEat
  if (b.alerts !== undefined) out.alerts = !!b.alerts
  if (b.reconnect) {
    if (b.reconnect.on !== undefined) out.reconnect.on = !!b.reconnect.on
    if (b.reconnect.delay !== undefined) out.reconnect.delay = clampInt(b.reconnect.delay, 5, 300, 15)
    if (b.reconnect.onDuplicate !== undefined) out.reconnect.onDuplicate = b.reconnect.onDuplicate === 'later' ? 'later' : 'wait'
  }
  if (b.antiAfk) {
    if (b.antiAfk.on !== undefined) out.antiAfk.on = !!b.antiAfk.on
    if (b.antiAfk.every !== undefined) out.antiAfk.every = clampInt(b.antiAfk.every, 5, 600, 30)
    if (Array.isArray(b.antiAfk.actions)) out.antiAfk.actions = b.antiAfk.actions.filter(a => ['look', 'swing', 'jump', 'sneak', 'step'].includes(a))
  }
  if (Array.isArray(b.macros)) out.macros = b.macros.slice(0, 30).map(cleanMacro).filter(Boolean)
  if (b.repeat) {
    if (b.repeat.on !== undefined) out.repeat.on = !!b.repeat.on
    if (b.repeat.every !== undefined) out.repeat.every = Math.min(1440, Math.max(0.5, Number(b.repeat.every) || 10))
    if (b.repeat.commands !== undefined) out.repeat.commands = String(b.repeat.commands).slice(0, 4000)
  }
  return out
}
function cleanMacro (m) {
  if (!m || typeof m !== 'object') return null
  const num = (v) => (v === '' || v === null || v === undefined || !Number.isFinite(Number(v))) ? '' : Math.round(Number(v) * 10) / 10
  return {
    id: /^[a-f0-9]{6,16}$/.test(m.id) ? m.id : crypto.randomBytes(4).toString('hex'),
    name: String(m.name || 'Macro').slice(0, 40).trim() || 'Macro',
    loop: !!m.loop,
    onJoin: !!m.onJoin,
    steps: (Array.isArray(m.steps) ? m.steps : []).slice(0, 100).filter(st => st && STEP_TYPES.includes(st.type)).map(st => {
      const o = { type: st.type }
      if (st.type === 'move') { o.x = num(st.x); o.y = num(st.y); o.z = num(st.z) }
      if (st.type === 'wait' || st.type === 'sneak') o.seconds = Math.min(3600, Math.max(0.1, Number(st.seconds) || 1))
      if (st.type === 'chat') o.text = String(st.text || '').slice(0, 256)
      if (st.type === 'look') o.dir = ['north', 'east', 'south', 'west', 'up', 'down'].includes(st.dir) ? st.dir : 'north'
      if (st.type === 'slot') o.slot = clampInt(st.slot, 1, 9, 1)
      if (st.type === 'click') o.name = String(st.name || '').slice(0, 60)
      return o
    })
  }
}
function clampInt (v, lo, hi, d) {
  const n = parseInt(v, 10)
  return Number.isFinite(n) ? Math.min(hi, Math.max(lo, n)) : d
}

