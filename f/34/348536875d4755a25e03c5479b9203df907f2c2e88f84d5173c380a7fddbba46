@font-face { font-family: "Fraunces"; font-weight: 600; font-display: swap; src: url(/fonts/fraunces-latin-600-normal.woff2) format("woff2"); }
@font-face { font-family: "Fraunces"; font-weight: 700; font-display: swap; src: url(/fonts/fraunces-latin-700-normal.woff2) format("woff2"); }
@font-face { font-family: "Atkinson Hyperlegible"; font-weight: 400; font-display: swap; src: url(/fonts/atkinson-hyperlegible-latin-400-normal.woff2) format("woff2"); }
@font-face { font-family: "Atkinson Hyperlegible"; font-weight: 700; font-display: swap; src: url(/fonts/atkinson-hyperlegible-latin-700-normal.woff2) format("woff2"); }

/* A winter night: violet sky, amethyst for shards, mint for earnings and farming,
   gold for progress and waiting, candy red for trouble. */
:root {
  --sky: #110E22;
  --card: #19152F;
  --card-2: #211C3B;
  --well: #130F26;
  --line: #2C2649;
  --line-2: #3A3360;
  --text: #EEEAFB;
  --muted: #A49DC4;
  --dim: #6E6792;
  --amethyst: #B590FF;
  --amethyst-2: #7C55E6;
  --mint: #5BE3A3;
  --gold: #F5C24C;
  --candy: #EE5560;
  --sky-blue: #6FB7FF;
  --serif: "Fraunces", Georgia, serif;
  --sans: "Atkinson Hyperlegible", "Segoe UI", system-ui, sans-serif;
  color-scheme: dark;
}

* { box-sizing: border-box; }
html, body { margin: 0; min-height: 100%; }
body {
  background-color: var(--sky);
  background-image:
    radial-gradient(1px 1px at 12% 18%, rgba(255,255,255,.55), transparent 60%),
    radial-gradient(1px 1px at 78% 9%, rgba(255,255,255,.45), transparent 60%),
    radial-gradient(1.5px 1.5px at 42% 62%, rgba(255,255,255,.35), transparent 60%),
    radial-gradient(1px 1px at 88% 48%, rgba(255,255,255,.4), transparent 60%),
    radial-gradient(1px 1px at 25% 85%, rgba(255,255,255,.3), transparent 60%),
    radial-gradient(1px 1px at 63% 30%, rgba(255,255,255,.3), transparent 60%),
    radial-gradient(1.5px 1.5px at 5% 55%, rgba(255,255,255,.35), transparent 60%),
    radial-gradient(1px 1px at 95% 80%, rgba(255,255,255,.35), transparent 60%);
  background-size: 640px 520px;
  background-attachment: fixed;
  color: var(--text);
  font: 15px/1.5 var(--sans);
  -webkit-font-smoothing: antialiased;
}
[hidden] { display: none !important; }
h1, h2, h3 { margin: 0; font-family: var(--serif); font-weight: 700; letter-spacing: -.005em; line-height: 1.15; }
h3 { font-size: 17px; }
p { margin: 0; }
a { color: var(--amethyst); }
code { font: 700 .92em var(--sans); background: var(--card-2); padding: 1px 5px; border-radius: 4px; }
:focus-visible { outline: 2px solid var(--amethyst); outline-offset: 2px; }
svg { width: 16px; height: 16px; fill: currentColor; flex: none; }
img { image-rendering: pixelated; }
.grow { flex: 1; }
.sub { color: var(--muted); font-size: 13px; }
.sub.tight { margin: 8px 0 10px; }

/* ---------- controls ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 7px;
  min-height: 34px; padding: 0 13px; border-radius: 8px;
  font: 700 14px/1 var(--sans); color: var(--text);
  background: var(--card-2); border: 1px solid var(--line-2); cursor: pointer; white-space: nowrap;
}
.btn:hover { background: #2A2449; }
.btn.primary { background: var(--amethyst-2); border-color: #9575FF; color: #fff; }
.btn.primary:hover { background: #8A65F0; }
.btn.small { min-height: 28px; padding: 0 10px; font-size: 13px; border-radius: 7px; }
.btn.icon { width: 34px; padding: 0; }
.btn.wide { width: 100%; }
.btn.ghost { background: transparent; border-color: transparent; color: var(--muted); }
.btn.ghost:hover { background: var(--card-2); color: var(--text); }
.btn.subtle { background: transparent; border-color: transparent; color: var(--muted); }
.btn.subtle:hover { color: var(--text); background: var(--card-2); }
.btn.danger, .btn.subtle.danger { color: #FF9AA0; }
.btn[disabled] { opacity: .45; cursor: default; }
.field { display: grid; gap: 5px; margin: 0 0 12px; min-width: 0; }
.field > span { font-weight: 700; font-size: 13px; }
input, select, textarea {
  font: 14px/1.4 var(--sans); color: var(--text); background: var(--well);
  border: 1px solid var(--line-2); border-radius: 8px; padding: 7px 10px; width: 100%; min-width: 0;
}
input:focus, select:focus, textarea:focus { border-color: var(--amethyst-2); outline: none; }
input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--amethyst); outline-offset: 1px; }
textarea { resize: vertical; }
input[type=checkbox], input[type=radio] { width: auto; accent-color: var(--amethyst-2); }
.form-error { color: #FF9AA0; font-size: 13px; }
.form-error:empty { display: none; }
.form-error:not(:empty) { margin: 0 0 10px; }
.switch { display: flex; gap: 10px; align-items: flex-start; margin: 0 0 10px; cursor: pointer; font-size: 14px; }
.switch input { margin-top: 3px; }
.segmented { display: flex; border: 1px solid var(--line-2); border-radius: 8px; overflow: hidden; }
.segmented label { flex: 1; position: relative; }
.segmented input { position: absolute; opacity: 0; inset: 0; }
.segmented span { display: block; padding: 6px 10px; text-align: center; font-weight: 700; font-size: 13px; color: var(--muted); cursor: pointer; }
.segmented label + label span { border-left: 1px solid var(--line-2); }
.segmented input:checked + span { background: var(--card-2); color: var(--text); }
.segmented input:focus-visible + span { outline: 2px solid var(--amethyst); outline-offset: -3px; }
.chips { display: flex; gap: 4px; flex-wrap: wrap; }
.chip { font: 700 12px/1 var(--sans); color: var(--muted); background: transparent; border: 1px solid transparent; border-radius: 6px; padding: 6px 9px; cursor: pointer; }
.chip:hover { color: var(--text); }
.chip[aria-pressed="true"] { background: var(--card-2); border-color: var(--line-2); color: var(--text); }

/* ---------- sign in ---------- */
.gate { min-height: 100vh; display: grid; place-items: center; padding: 24px 16px; }
.gate-card { width: min(380px, 100%); background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 30px 26px 26px; }
.gate-mark { display: block; margin-bottom: 16px; }
.gate h1 { font-size: 32px; }
.gate-card > p { color: var(--muted); margin: 6px 0 20px; }

/* ---------- page ---------- */
.topbar { display: flex; align-items: center; gap: 10px; max-width: 1200px; margin: 0 auto; padding: 14px 20px 0; }
.brand { display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--text); font: 700 18px/1 var(--serif); }
.wrap { max-width: 1200px; margin: 0 auto; padding: 14px 20px 48px; }

.hero {
  position: relative; overflow: hidden; padding: 34px 34px 26px; border-radius: 20px;
  background: radial-gradient(120% 140% at 85% 0%, #4B2E8F 0%, #2A1B57 38%, #1A1438 70%), var(--card);
  border: 1px solid #3B2C6E;
}
.hero::after { /* soft snow at the bottom edge */
  content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 60px; pointer-events: none;
  background: radial-gradient(60% 100% at 50% 100%, rgba(181, 144, 255, .14), transparent 70%);
}
.hero h1 { font-size: clamp(30px, 4.4vw, 46px); max-width: 16ch; }
.hero p { color: #CFC6F0; margin-top: 10px; max-width: 60ch; font-size: 15px; }
.lights { display: flex; flex-wrap: wrap; gap: 10px 14px; margin: 22px 0 16px; padding-top: 6px; position: relative; min-height: 26px; }
.lights::before { /* the wire */
  content: ""; position: absolute; left: -34px; right: -34px; top: 8px; height: 14px;
  border-top: 2px solid rgba(20, 14, 40, .9); border-radius: 50%; pointer-events: none;
}
.bulb { display: inline-block; width: 12px; height: 17px; border-radius: 50% 50% 46% 46% / 58% 58% 42% 42%; position: relative; background: var(--dim); flex: none; }
.lights .bulb::before { content: ""; position: absolute; left: 3px; top: -5px; width: 6px; height: 5px; border-radius: 2px; background: #3C3456; }
.bulb.farming { background: var(--amethyst); box-shadow: 0 0 10px 2px rgba(181, 144, 255, .7); }
.bulb.roaming { background: var(--sky-blue); box-shadow: 0 0 8px 1px rgba(111, 183, 255, .5); }
.bulb.signin { background: var(--gold); box-shadow: 0 0 8px 1px rgba(245, 194, 76, .5); }
.bulb.trouble { background: var(--candy); box-shadow: 0 0 8px 1px rgba(238, 85, 96, .5); }
.bulb.offline { background: #4A4366; }
.lights .bulb:nth-child(4n+2).farming { background: var(--mint); box-shadow: 0 0 10px 2px rgba(91, 227, 163, .6); }
.lights .bulb:nth-child(4n+3).farming { background: var(--gold); box-shadow: 0 0 10px 2px rgba(245, 194, 76, .6); }
.lights .bulb:nth-child(4n).farming { background: #FF8CC6; box-shadow: 0 0 10px 2px rgba(255, 140, 198, .55); }
@media (prefers-reduced-motion: no-preference) {
  .lights .bulb.farming { animation: twinkle 2.6s ease-in-out infinite; }
  .lights .bulb:nth-child(3n).farming { animation-delay: .9s; }
  .lights .bulb:nth-child(3n+1).farming { animation-delay: 1.7s; }
}
@keyframes twinkle { 50% { filter: brightness(.65); box-shadow: none; } }
.legend { display: flex; flex-wrap: wrap; gap: 6px 16px; list-style: none; padding: 0; margin: 0; font-size: 12px; color: #C3BAE6; }
.legend li { display: flex; align-items: center; gap: 6px; }
.legend .bulb { width: 8px; height: 8px; border-radius: 50%; box-shadow: none; }

/* stats */
.stats { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)) minmax(0, 1.6fr); gap: 0; margin: 14px 0; background: var(--card); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
.stat { padding: 14px 16px; border-right: 1px solid var(--line); min-width: 0; }
.stat:last-child { border-right: 0; }
.stat b { display: block; font: 700 24px/1.1 var(--serif); font-variant-numeric: tabular-nums; }
.stat b.mint { color: var(--mint); }
.stat b.gold { color: var(--gold); }
.stat b.amethyst { color: var(--amethyst); }
.stat span { display: block; font-size: 12px; color: var(--muted); margin-top: 4px; }
.stat.chart { padding: 10px 14px 8px; display: grid; grid-template-rows: auto 1fr; }
.stat.chart span { margin: 0 0 4px; }
.stat.chart svg { width: 100%; height: 54px; display: block; }

/* layout */
.cols { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 14px; align-items: start; }
.card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 16px; }
.card h2 { font-size: 18px; }
.side { display: grid; gap: 14px; }
.side .card > .sub { margin: 2px 0 12px; }

/* accounts */
.accounts { padding: 0; overflow: hidden; }
.card-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 14px 16px; border-bottom: 1px solid var(--line); }
.card-head h2 { margin-right: auto; }
.search { position: relative; flex: 0 1 220px; }
.search svg { position: absolute; left: 9px; top: 50%; transform: translateY(-50%); color: var(--dim); width: 14px; height: 14px; }
.search input { padding-left: 29px; height: 30px; font-size: 13px; }
#sort { width: auto; height: 30px; padding: 3px 8px; font-size: 13px; }
.bulk { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; padding: 10px 16px; background: #231C45; border-bottom: 1px solid var(--line); }
.bulk strong { font-size: 13px; margin-right: 6px; }

.thead, .acct .sum {
  display: grid; grid-template-columns: 30px minmax(150px, 1.5fr) 72px 92px minmax(150px, 1.6fr) minmax(90px, 1fr) 82px 92px;
  gap: 10px; align-items: center; padding: 0 16px;
}
.thead { height: 36px; font-size: 12px; color: var(--dim); font-weight: 700; border-bottom: 1px solid var(--line); }
.num { text-align: right; font-variant-numeric: tabular-nums; }
.check { display: grid; place-items: center; cursor: pointer; height: 100%; }
.acct { border-bottom: 1px solid var(--line); }
.acct:last-child { border-bottom: 0; }
.acct .sum { min-height: 50px; cursor: pointer; }
.acct .sum:hover { background: rgba(255, 255, 255, .02); }
.acct.open .sum { background: var(--card-2); }
.who { display: grid; grid-template-columns: 9px auto; gap: 1px 9px; align-items: center; min-width: 0; }
.who .dot { width: 8px; height: 8px; border-radius: 50%; background: #4A4366; grid-row: 1 / span 2; }
.dot.farming { background: var(--mint); box-shadow: 0 0 6px rgba(91, 227, 163, .7); }
.dot.roaming { background: var(--sky-blue); }
.dot.signin { background: var(--gold); }
.dot.trouble { background: var(--candy); }
.who strong { font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: flex; align-items: center; gap: 6px; }
.who small { font-size: 12px; color: var(--dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.badge { font: 700 10px/1 var(--sans); padding: 3px 5px; border-radius: 4px; background: #23325A; color: #9EC3FF; flex: none; }
.sum .shards { font-weight: 700; }
.plus { color: var(--mint); font-weight: 700; }
.zero { color: var(--dim); }
.next { min-width: 0; }
.bar { height: 9px; border-radius: 5px; background: var(--well); overflow: hidden; border: 1px solid var(--line); }
/* a spinning candy cane: red and white stripes that roll along, full or not */
.bar i {
  display: block; height: 100%; border-radius: 5px; background-color: var(--candy);
  background-image: linear-gradient(135deg, #FFF4F4 25%, transparent 25%, transparent 50%, #FFF4F4 50%, #FFF4F4 75%, transparent 75%, transparent);
  background-size: 14px 14px;
  transition: width .4s ease;
}
@media (prefers-reduced-motion: no-preference) {
  .bar i { animation: candy .7s linear infinite; }
}
@keyframes candy { from { background-position: 0 0; } to { background-position: 14px 0; } }
.next small { display: block; font-size: 11.5px; color: var(--muted); margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.c-proxy, .c-online { font-size: 12.5px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sum .btn { justify-self: end; }
.empty { padding: 28px 16px; color: var(--muted); text-align: center; }

/* one account opened */
.more { display: grid; grid-template-columns: 1.15fr 1fr .9fr; gap: 18px 24px; padding: 16px 16px 18px 56px; background: var(--card-2); }
.more h4 { margin: 0 0 6px; font: 700 12px/1.2 var(--sans); color: var(--dim); }
.more .blk + .blk { margin-top: 14px; }
.more ul { list-style: none; margin: 0; padding: 0; font-size: 13.5px; display: grid; gap: 2px; }
.more .afk-in { color: var(--mint); }
.more .afk-out { color: var(--gold); }
.cmd { display: flex; gap: 6px; }
.cmd input { height: 32px; }
.quick { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 6px; }
.out { margin-top: 8px; height: 150px; overflow-y: auto; background: var(--well); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; font-size: 12.5px; line-height: 1.45; }
.out .ln { display: grid; grid-template-columns: 4.4em minmax(0, 1fr); gap: 8px; }
.out time { color: var(--dim); font-variant-numeric: tabular-nums; white-space: nowrap; }
.out .t { white-space: pre-wrap; overflow-wrap: anywhere; }
.out .you .t { color: var(--amethyst); font-weight: 700; }
.out .error .t { color: #FF9AA0; }
.out .info .t { color: #A9C2E8; }
.out .note { color: var(--dim); }
.row-btns { display: flex; gap: 6px; flex-wrap: wrap; }
.proxy-now { font-size: 13px; overflow-wrap: anywhere; margin-bottom: 6px; }
.proxy-set { display: flex; gap: 6px; }
.proxy-set input { height: 30px; font-size: 13px; }

/* side lists */
.nice { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
.nice li { display: grid; grid-template-columns: 18px 1fr auto; gap: 2px 10px; align-items: center; font-size: 13.5px; }
.nice .rank { font: 700 14px var(--serif); color: var(--gold); grid-row: 1 / span 2; }
.nice li:nth-child(n+4) .rank { color: var(--dim); }
.nice strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nice .bar { grid-column: 2; height: 5px; }
.nice .bar i { background: linear-gradient(90deg, var(--gold), #FFDD8A); animation: none; }
.nice .plus { grid-row: 1 / span 2; grid-column: 3; font-size: 13px; }
.naughty { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 13.5px; }
.naughty li { display: grid; grid-template-columns: 9px 1fr; gap: 1px 9px; align-items: center; cursor: pointer; }
.naughty li .dot { width: 8px; height: 8px; border-radius: 50%; grid-row: 1 / span 2; background: #4A4366; }
.naughty small { color: var(--muted); font-size: 12px; }
.list-empty { color: var(--muted); font-size: 13.5px; }

/* dialogs */
.sheet { width: min(460px, calc(100% - 24px)); padding: 0; color: var(--text); background: var(--card); border: 1px solid var(--line-2); border-radius: 16px; box-shadow: 0 24px 60px rgba(0, 0, 0, .55); }
.wide-sheet { width: min(660px, calc(100% - 24px)); }
.sheet::backdrop { background: rgba(8, 6, 18, .7); }
.sheet-body { padding: 0 22px 18px; max-height: 88vh; overflow-y: auto; }
.sheet header { display: flex; align-items: center; justify-content: space-between; padding: 18px 0 10px; position: sticky; top: 0; background: var(--card); z-index: 1; }
.sheet header h2 { font-size: 22px; }
.sheet .group { padding: 12px 0 14px; border-bottom: 1px solid var(--line); }
.sheet .group h3 { margin-bottom: 8px; }
.sheet .group > .sub { margin-bottom: 10px; }
.sheet footer { display: flex; gap: 8px; justify-content: flex-end; align-items: center; padding-top: 12px; flex-wrap: wrap; }
.sheet #signinOpen { margin: 14px 0 8px; }
.two { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14px; }
.three { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 0 14px; }
.inline { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; }
.wrap-row { flex-wrap: wrap; }
.checks { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 6px 0 12px; font-size: 14px; }
.checks label { display: flex; gap: 7px; align-items: center; cursor: pointer; }
.cmd-help { font-size: 13px; color: var(--muted); margin: 6px 0 0; padding: 0; list-style: none; display: grid; gap: 2px; }
.code-way { margin-top: 10px; font-size: 13.5px; color: var(--muted); }
.code-way summary { cursor: pointer; font-weight: 700; color: var(--text); width: max-content; }
.code-way p { margin-top: 6px; }
.code-way strong { font: 700 16px var(--serif); letter-spacing: .08em; color: var(--text); }
.upd-bar { height: 8px; background: var(--well); border: 1px solid var(--line); border-radius: 4px; overflow: hidden; margin: 8px 0 12px; }
.upd-bar i { display: block; height: 100%; width: 0; background: var(--mint); transition: width .2s; }
.group-row { display: grid; grid-template-columns: 1fr 2fr auto auto; gap: 8px; align-items: start; padding: 10px 0; border-bottom: 1px solid var(--line); }
.group-row .test-result { grid-column: 1 / -1; font-size: 12.5px; color: var(--muted); }
.group-row .test-result:empty { display: none; }
.group-row .test-result.good { color: var(--mint); }
.group-row .test-result.bad { color: #FF9AA0; }
.group-row .members { grid-column: 1 / -1; font-size: 12.5px; color: var(--muted); }
.group-row .members b.full { color: var(--gold); }
#groupRows:empty::before { content: "No groups yet."; display: block; padding: 10px 0; color: var(--muted); }
#addGroup { margin: 10px 0; }
.lane-note { font-size: 13px; margin: 10px 0; padding: 8px 12px; background: var(--well); border-left: 3px solid var(--mint); border-radius: 4px; }
.lane-note:empty { display: none; }

.toast {
  position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%); z-index: 10;
  background: var(--text); color: var(--sky); padding: 10px 16px; border-radius: 10px;
  font-size: 14px; font-weight: 700; max-width: calc(100% - 32px); box-shadow: 0 8px 24px rgba(0, 0, 0, .45);
}

/* ---------- smaller screens ---------- */
@media (max-width: 1100px) {
  .stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .stat:nth-child(3) { border-right: 0; }
  .stat:nth-child(-n+3) { border-bottom: 1px solid var(--line); }
  .stat.chart { grid-column: span 1; }
  .cols { grid-template-columns: 1fr; }
  .side { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
}
@media (max-width: 900px) {
  .thead { display: none; }
  .acct .sum { grid-template-columns: 26px minmax(0, 1fr) auto auto; grid-template-areas: "c who shards btn" "c next next today"; gap: 6px 10px; padding: 10px 14px; }
  .acct .sum > .check { grid-area: c; }
  .acct .sum > .who { grid-area: who; }
  .acct .sum > .shards { grid-area: shards; }
  .acct .sum > .today { grid-area: today; }
  .acct .sum > .next { grid-area: next; }
  .acct .sum > .btn { grid-area: btn; }
  .acct .sum > .c-proxy, .acct .sum > .c-online { display: none; }
  .more { grid-template-columns: 1fr; padding: 14px; }
}
@media (max-width: 640px) {
  .topbar { padding: 12px 16px 0; }
  .wrap { padding: 12px 16px 40px; }
  .hero { padding: 24px 20px 20px; border-radius: 16px; }
  .lights::before { left: -20px; right: -20px; }
  .stats { grid-template-columns: 1fr 1fr; }
  .stat { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .stat:nth-child(2n) { border-right: 0; }
  .stat.chart { grid-column: 1 / -1; border-bottom: 0; }
  .stat:nth-child(5) { grid-column: 1 / -1; border-right: 0; }
  .card-head h2 { width: 100%; }
  .search { flex: 1 1 100%; }
