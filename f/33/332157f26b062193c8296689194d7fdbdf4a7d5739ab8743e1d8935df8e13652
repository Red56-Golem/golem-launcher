  const row = e.target.closest('.roster-row')
  if (row) return selectBot(row.dataset.id)
  const all = e.target.closest('[data-all]')
  if (all) {
    await api('POST', `/api/all/${all.dataset.all}`).catch(err => toast(err.message))
    toast(all.dataset.all === 'start' ? 'Starting every stopped bot.' : 'Stopping every bot.')
  }
})
$('#backBtn').addEventListener('click', () => $('#app').classList.remove('show-bot'))
$('#brand').addEventListener('click', e => { e.preventDefault(); $('#app').classList.remove('show-bot') })

$('#botActions').addEventListener('click', async e => {
  const btn = e.target.closest('[data-act]')
  if (!btn) return
  btn.disabled = true
  try { await api('POST', `/api/bots/${state.selected}/${btn.dataset.act}`) } catch (err) { toast(err.message) }
  btn.disabled = false
})

const onThisPC = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname)
async function openSignin (id, auto) {
  try {
    await api('POST', `/api/bots/${id}/signin-window`)
    if (!auto) toast('Sign-in window opened. Paste the code with Ctrl+V.')
  } catch (err) { if (!auto) toast(err.message) }
}
$('#signinOpen').addEventListener('click', () => openSignin(state.selected))
$('#copyCode').addEventListener('click', async () => {
  const code = $('#signinCode').textContent
  try { await navigator.clipboard.writeText(code); toast('Code copied.') } catch { toast(`The code is ${code}`) }
})

// ---------- console ----------
const MC = { 0: '#6B6F75', 1: '#5B6FE0', 2: '#3FBF3F', 3: '#3FBFBF', 4: '#D04040', 5: '#BF3FBF', 6: '#F0A800', 7: '#B4B6B0', 8: '#8A8E94', 9: '#7C7CFF', a: '#6EF06E', b: '#6EF0F0', c: '#FF6B6B', d: '#FF77FF', e: '#FFF36B', f: '#F4F4F0' }
function motdHTML (s) {
  let out = ''
  let style = { color: null, b: false, i: false, u: false, m: false }
  const parts = String(s).split(/(§#[0-9a-fA-F]{6}|§[0-9a-fk-orA-FK-OR])/)
  for (const p of parts) {
    if (!p) continue
    if (p.startsWith('§#')) { style = { color: p.slice(1), b: false, i: false, u: false, m: false }; continue }
    if (p.length === 2 && p[0] === '§') {
      const c = p[1].toLowerCase()
      if (MC[c]) style = { color: MC[c], b: false, i: false, u: false, m: false }
      else if (c === 'l') style.b = true
      else if (c === 'o') style.i = true
      else if (c === 'n') style.u = true
      else if (c === 'm') style.m = true
      else if (c === 'r') style = { color: null, b: false, i: false, u: false, m: false }
      continue
    }
    const css = []
    if (style.color) css.push(`color:${style.color}`)
    if (style.b) css.push('font-weight:700')
    if (style.i) css.push('font-style:italic')
    if (style.u || style.m) css.push(`text-decoration:${style.u ? 'underline' : ''} ${style.m ? 'line-through' : ''}`)
    out += css.length ? `<span style="${css.join(';')}">${esc(p)}</span>` : esc(p)
  }
  return out
}
function whoHTML (l) {
  if (l.from) {
    const me = l.kind === 'you'
    const initial = esc(l.from[0].toUpperCase())
    return `<span class="who${me ? ' me' : ''}"><img src="https://mc-heads.net/avatar/${encodeURIComponent(l.from)}/16" alt="" loading="lazy" onerror="this.outerHTML='<i>${initial}</i>'">${esc(l.from)}</span>`
  }
  if (l.kind === 'server') return '<span class="who sys">Server</span>'
  return ''
}
function lineHTML (l) {
  const body = l.motd ? motdHTML(l.motd) : esc(l.text)
  return `<div class="line ${l.kind}"><time>${clock(l.t)}</time><span class="text">${whoHTML(l)}${body}</span></div>`
}
function renderConsole () {
  const log = state.logs.get(state.selected) || []
  const c = $('#console')
  c.innerHTML = log.length ? log.map(lineHTML).join('') : '<p class="note">Nothing yet. Chat and events show up here once the bot starts.</p>'
  c.scrollTop = c.scrollHeight
}
function appendLine (l) {
  const c = $('#console')
  const atBottom = c.scrollHeight - c.scrollTop - c.clientHeight < 40
  const note = c.querySelector('.note')
  if (note) note.remove()
  c.insertAdjacentHTML('beforeend', lineHTML(l))
  while (c.children.length > 100) c.firstElementChild.remove()
  if (atBottom) c.scrollTop = c.scrollHeight
}

$('#sayForm').addEventListener('submit', async e => {
  e.preventDefault()
  const input = $('#sayInput')
  const text = input.value.trim()
  if (!text) return
  try {
    await api('POST', `/api/bots/${state.selected}/say`, { text })
    state.sent.push(text)
    state.sentAt = -1
    input.value = ''
  } catch (err) { toast(err.message) }
})
$('#sayInput').addEventListener('keydown', e => {
  if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown') return
  if (!state.sent.length) return
  e.preventDefault()
  if (state.sentAt < 0) state.sentAt = state.sent.length
  state.sentAt = Math.max(0, Math.min(state.sent.length, state.sentAt + (e.key === 'ArrowUp' ? -1 : 1)))
  e.target.value = state.sent[state.sentAt] || ''
})

// ---------- tabs ----------
function showTab (tab) {
  if (tab === 'chat' && state.dirty && !confirm('You have unsaved bot settings. Leave them unsaved?')) return
  if (tab === 'chat' && state.dirty) { state.dirty = false; renderSettings() }
  if (tab !== 'macros' && state.macroEdit && !confirm('You have an unsaved macro. Leave it?')) return
  if (tab !== 'macros') state.macroEdit = null
  state.tab = tab
  $('#tabChat').setAttribute('aria-selected', tab === 'chat')
  $('#tabMacros').setAttribute('aria-selected', tab === 'macros')
  $('#tabSettings').setAttribute('aria-selected', tab === 'settings')
  $('#paneChat').hidden = tab !== 'chat'
  $('#paneMacros').hidden = tab !== 'macros'
  $('#paneSettings').hidden = tab !== 'settings'
  if (tab === 'macros') renderMacros()
  if (tab === 'chat') { const c = $('#console'); c.scrollTop = c.scrollHeight }
}
$('#tabChat').addEventListener('click', () => showTab('chat'))
$('#tabSettings').addEventListener('click', () => showTab('settings'))
$('#tabMacros').addEventListener('click', () => showTab('macros'))


// ---------- macros ----------
const STEPS = {
  move: ['Move to', 'Walks there and goes around blocks. Leave Y empty for any height.'],
  wait: ['Wait', ''],
  chat: ['Say or run a command', ''],
  look: ['Look', ''],
  slot: ['Hold hotbar slot', ''],
  use: ['Right-click held item', 'Like eating, or opening a server-picker compass.'],
  useBlock: ['Right-click block in front', 'Opens chests and doors, presses buttons.'],
  click: ['Click menu item', 'Clicks the item with this name in the open menu.'],
  close: ['Close menu', ''],
  jump: ['Jump', ''],
  sneak: ['Sneak', ''],
  attack: ['Hit nearest mob', 'Hits a mob within reach, if there is one.']
}
const BEDROCK_STEPS = ['chat', 'wait']
function newStep (type) {
  const b = state.bots.get(state.selected)
  const s = (b && b.stats) || {}
  switch (type) {
    case 'move': return { type, x: s.x ?? '', y: s.y ?? '', z: s.z ?? '' }
    case 'wait': return { type, seconds: 5 }
    case 'sneak': return { type, seconds: 2 }
    case 'chat': return { type, text: '' }
    case 'look': return { type, dir: 'north' }
    case 'slot': return { type, slot: 1 }
    case 'click': return { type, name: '' }
    default: return { type }
  }
}
function stepSummary (st) {
  switch (st.type) {
    case 'move': return `Move to ${st.x}, ${st.y === '' ? 'any height' : st.y}, ${st.z}`
    case 'wait': return `Wait ${st.seconds} s`
    case 'chat': return `Say "${st.text}"`
    case 'look': return `Look ${st.dir}`
    case 'slot': return `Hold slot ${st.slot}`
    case 'click': return `Click "${st.name}"`
    case 'sneak': return `Sneak ${st.seconds} s`
    default: return STEPS[st.type][0]
  }
}

function renderMacros () {
  const b = state.bots.get(state.selected)
  const pane = $('#paneMacros')
  if (!b) { pane.innerHTML = ''; return }
  if (state.macroEdit) return renderMacroEditor(b)
  const list = b.cfg.macros || []
  const running = b.macro
  const rows = list.map(m => {
    const on = running && running.id === m.id
    const extra = [`${m.steps.length} step${m.steps.length === 1 ? '' : 's'}`]
    if (m.loop) extra.push('repeats forever')
    if (m.onJoin) extra.push('starts when the bot joins')
    const line = on ? `Running: step ${running.step + 1} of ${m.steps.length}, ${stepSummary(m.steps[running.step] || { type: 'wait', seconds: 0 })}` : extra.join(', ')
    return `<div class="macro-row${on ? ' running' : ''}">
      <strong>${esc(m.name)}</strong>
      <small>${esc(line)}</small>
      <div class="row-actions">
        <button type="button" class="btn" data-medit="${m.id}">Edit</button>
        ${on
          ? `<button type="button" class="btn" data-mstop><svg><use href="#i-stop"/></svg><span>Stop</span></button>`
          : `<button type="button" class="btn primary" data-mplay="${m.id}" ${b.status !== 'online' ? 'disabled title="Start the bot first"' : ''}><svg><use href="#i-play"/></svg><span>Play</span></button>`}
      </div>
    </div>`
  }).join('')
  pane.innerHTML = `
    <p class="intro">A macro is a list of steps the bot does in order, like walking somewhere and then typing a command. Press Play to run one.</p>
    ${rows || '<p class="macro-empty">No macros yet.</p>'}
    <button type="button" class="btn" data-mnew><svg><use href="#i-plus"/></svg><span>New macro</span></button>`
}

function renderMacroEditor (b) {
  const d = state.macroEdit.draft
  const bedrock = b.edition === 'bedrock'
  const allowed = Object.keys(STEPS).filter(k => !bedrock || BEDROCK_STEPS.includes(k))
  const steps = d.steps.map((st, i) => `<li class="step" data-i="${i}">
      <div class="step-body"><b>${esc(STEPS[st.type][0])}</b>${stepFields(st, i)}${STEPS[st.type][1] ? `<span class="hint">${esc(STEPS[st.type][1])}</span>` : ''}</div>
      <div class="step-tools">
        <button type="button" class="btn icon" data-sup="${i}" aria-label="Move step ${i + 1} up" ${i === 0 ? 'disabled' : ''}><svg><use href="#i-up"/></svg></button>
        <button type="button" class="btn icon" data-sdown="${i}" aria-label="Move step ${i + 1} down" ${i === d.steps.length - 1 ? 'disabled' : ''}><svg><use href="#i-down"/></svg></button>
        <button type="button" class="btn icon" data-sdel="${i}" aria-label="Remove step ${i + 1}"><svg><use href="#i-close"/></svg></button>
      </div>
    </li>`).join('')
  $('#paneMacros').innerHTML = `
    ${bedrock ? '<p class="note-box">Bedrock bots can only use "Say or run a command" and "Wait" steps.</p>' : ''}
    <label class="field"><span>Macro name</span><input id="mName" value="${esc(d.name)}" maxlength="40" autocomplete="off"></label>
    ${d.steps.length ? `<ol class="steps">${steps}</ol>` : '<p class="macro-empty">No steps yet. Pick one below and press Add step.</p>'}
    <div class="add-step">
      <select id="mAddType" aria-label="Step to add">${allowed.map(k => `<option value="${k}">${esc(STEPS[k][0])}</option>`).join('')}</select>
      <button type="button" class="btn" data-sadd><svg><use href="#i-plus"/></svg><span>Add step</span></button>
    </div>
    <div class="macro-opts">
      <label class="switch"><input type="checkbox" id="mLoop" ${d.loop ? 'checked' : ''}><span>When it reaches the last step, start again from the top</span></label>
      <label class="switch"><input type="checkbox" id="mJoin" ${d.onJoin ? 'checked' : ''}><span>Play it by itself every time the bot joins the server</span></label>
    </div>
    <div class="macro-foot">
      ${state.macroEdit.isNew ? '' : '<button type="button" class="btn subtle danger" data-mdel>Delete macro</button>'}
      <span class="grow"></span>
      <button type="button" class="btn" data-mcancel>Cancel</button>
      <button type="button" class="btn primary" data-msave>Save macro</button>
    </div>`
}

function stepFields (st, i) {
  const f = (k, attrs) => `data-i="${i}" data-k="${k}" ${attrs}`
  switch (st.type) {
    case 'move': return `<div class="step-fields">
        <input class="xyz" type="number" step="1" ${f('x', `value="${esc(st.x)}" placeholder="X" aria-label="X"`)}>
        <input class="xyz" type="number" step="1" ${f('y', `value="${esc(st.y)}" placeholder="Y (any)" aria-label="Y, optional"`)}>
        <input class="xyz" type="number" step="1" ${f('z', `value="${esc(st.z)}" placeholder="Z" aria-label="Z"`)}>
        <button type="button" class="btn" data-shere="${i}"><svg><use href="#i-pin"/></svg><span>Use the bot's spot</span></button>
      </div>`
    case 'wait': case 'sneak': return `<div class="step-fields"><input class="xyz" type="number" min="0.1" max="3600" step="0.5" ${f('seconds', `value="${esc(st.seconds)}" aria-label="Seconds"`)}><span>seconds</span></div>`
    case 'chat': return `<div class="step-fields"><input class="wide" maxlength="256" ${f('text', `value="${esc(st.text)}" placeholder="/home 1 or a message" aria-label="Message or command"`)}></div>`
    case 'look': return `<div class="step-fields"><select ${f('dir', 'aria-label="Direction"')}>${['north', 'east', 'south', 'west', 'up', 'down'].map(d => `<option value="${d}" ${st.dir === d ? 'selected' : ''}>${d[0].toUpperCase() + d.slice(1)}</option>`).join('')}</select></div>`
    case 'slot': return `<div class="step-fields"><select ${f('slot', 'aria-label="Hotbar slot"')}>${[1, 2, 3, 4, 5, 6, 7, 8, 9].map(n => `<option value="${n}" ${Number(st.slot) === n ? 'selected' : ''}>Slot ${n}</option>`).join('')}</select></div>`
    case 'click': return `<div class="step-fields"><input class="wide" maxlength="60" ${f('name', `value="${esc(st.name)}" placeholder="Name of the item, e.g. Survival" aria-label="Menu item name"`)}></div>`
    default: return ''
  }
}

function startEdit (macro) {
  state.macroEdit = { isNew: !macro, draft: macro ? JSON.parse(JSON.stringify(macro)) : { id: Math.random().toString(16).slice(2, 10).padEnd(8, '0'), name: 'New macro', loop: false, onJoin: false, steps: [] } }
  renderMacros()
}
async function saveMacros (list, done) {
  try {
    const res = await api('PATCH', `/api/bots/${state.selected}`, { macros: list })
    state.bots.set(res.bot.cfg.id, res.bot)
    state.macroEdit = null
    renderMacros()
    toast(done)
  } catch (err) { toast(err.message) }
}

$('#paneMacros').addEventListener('input', e => {
  const ed = state.macroEdit
  if (!ed) return
  const t = e.target
  if (t.id === 'mName') ed.draft.name = t.value
  if (t.id === 'mLoop') ed.draft.loop = t.checked
  if (t.id === 'mJoin') ed.draft.onJoin = t.checked
  if (t.dataset.k) ed.draft.steps[Number(t.dataset.i)][t.dataset.k] = t.value
})
$('#paneMacros').addEventListener('change', e => {
  const ed = state.macroEdit
  if (ed && e.target.dataset.k) ed.draft.steps[Number(e.target.dataset.i)][e.target.dataset.k] = e.target.value
})
$('#paneMacros').addEventListener('click', async e => {
  const el = e.target.closest('button')
  if (!el) return
  const b = state.bots.get(state.selected)
  const ed = state.macroEdit
  const d = el.dataset
  if (d.mnew !== undefined) return startEdit(null)
  if (d.medit) return startEdit((b.cfg.macros || []).find(m => m.id === d.medit))
  if (d.mplay) {
    try { await api('POST', `/api/bots/${state.selected}/play`, { macro: d.mplay }) } catch (err) { toast(err.message) }
    return
  }
  if (d.mstop !== undefined) { await api('POST', `/api/bots/${state.selected}/stopmacro`).catch(err => toast(err.message)); return }
  if (!ed) return
  const steps = ed.draft.steps
  if (d.sadd !== undefined) {
    steps.push(newStep($('#mAddType').value))
    renderMacros()
    const last = $('#paneMacros .step:last-child input, #paneMacros .step:last-child select')
    if (last) last.focus()
    return
  }
  if (d.sup) { const i = Number(d.sup); [steps[i - 1], steps[i]] = [steps[i], steps[i - 1]]; return renderMacros() }
  if (d.sdown) { const i = Number(d.sdown); [steps[i + 1], steps[i]] = [steps[i], steps[i + 1]]; return renderMacros() }
  if (d.sdel) { steps.splice(Number(d.sdel), 1); return renderMacros() }
  if (d.shere) {
    const s = b.stats || {}
    if (b.status !== 'online' || s.x === undefined) return toast('The bot has to be online to use its spot.')
    Object.assign(steps[Number(d.shere)], { x: s.x, y: s.y, z: s.z })
    return renderMacros()
  }
  if (d.mcancel !== undefined) { state.macroEdit = null; return renderMacros() }
  if (d.mdel !== undefined) {
    if (!confirm(`Delete the macro "${ed.draft.name}"?`)) return
    return saveMacros((b.cfg.macros || []).filter(m => m.id !== ed.draft.id), 'Macro deleted.')
  }
  if (d.msave !== undefined) {
    const bad = steps.find(st => st.type === 'move' && (st.x === '' || st.z === ''))
    if (bad) return toast('Every Move to step needs an X and a Z.')
    const list = (b.cfg.macros || []).slice()
    const at = list.findIndex(m => m.id === ed.draft.id)
    if (at >= 0) list[at] = ed.draft
    else list.push(ed.draft)
    return saveMacros(list, 'Macro saved.')
  }
})

