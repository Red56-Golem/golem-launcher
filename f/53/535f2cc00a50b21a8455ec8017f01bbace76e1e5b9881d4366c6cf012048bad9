const bots = new Map()
let lastLanes = ''
function addBot (cfg) {
  const bot = cfg.edition === 'bedrock' ? new BedrockBot(cfg) : new AfkBot(cfg)
  bot.on('change', b => {
    // just joined: go to the AFK area right away
    if (b.status === 'online' && b.lastSeenStatus !== 'online' && config.settings.afkCommand) {
      const conn = b.conn
      setTimeout(() => {
        if (b.conn !== conn || b.status !== 'online') return
        b.lastAfkCmd = Date.now()
        b.sendLine(config.settings.afkCommand)
      }, human(1500, 5000))
    }
    // and once per join: /shards, so the count starts from what the account really has
    if (b.status === 'online' && b.lastSeenStatus !== 'online') {
      const conn = b.conn
      setTimeout(() => { if (b.conn === conn && b.status === 'online') b.sendLine('/shards') }, human(6000, 12000))
    }
    b.lastSeenStatus = b.status
    broadcast({ type: 'bot', bot: b.publicState() })
    const l = JSON.stringify(lanes())
    if (l !== lastLanes) { lastLanes = l; broadcast({ type: 'lanes', lanes: JSON.parse(l) }) }
  })
  bot.on('cmd', (b, line) => broadcast({ type: 'line', id: b.cfg.id, line }))
  bots.set(cfg.id, bot)
  return bot
}
for (const cfg of config.bots) addBot(cfg)

// At most PER_PROXY bots run through one proxy, and at most PER_PROXY without one.
// withQueued: also count bots waiting in the start-up queue.
function laneBlock (bot, withQueued) {
  const key = proxyKey(bot.cfg)
  const used = [...bots.values()].filter(b => b !== bot && (b.isActive() || (withQueued && b.queued)) && proxyKey(b.cfg) === key).length
  if (used < PER_PROXY) return ''
  return key === 'none'
    ? `Not started: ${PER_PROXY} bots without a proxy are already running. Put this one in a group with a proxy, or stop another bot.`
    : `Not started: ${PER_PROXY} bots are already running through this proxy. Use a group with a different proxy, or stop another bot.`
}
AfkBot.gate = (bot) => laneBlock(bot, false)

// how many bots use each proxy (and no proxy) right now, for the dashboard
function lanes () {
  const out = {}
  for (const b of bots.values()) {
    const key = proxyKey(b.cfg)
    const lane = out[key] || (out[key] = { running: 0, groups: [] })
    if (b.isActive()) lane.running++
  }
  for (const g of config.groups) {
    const key = proxyKey({ group: g.id })
    const lane = out[key] || (out[key] = { running: 0, groups: [] })
    lane.groups.push(g.id)
  }
  return out
}

// The app may have been closed while bots were online: end their "online" stretch
// at the last time the app was known to be running.
;(function closeOpenHistory () {
  const alive = history.__alive || Date.now()
  for (const [id, list] of Object.entries(history)) {
    if (id === '__alive' || !Array.isArray(list)) continue
    const last = list[list.length - 1]
    if (last && last.s === 'on') list.push({ t: Math.max(last.t, alive), s: 'off' })
  }
})()
setInterval(() => store.touchAlive(), 60000).unref()

function historyFor (id) {
