$('#bulk').addEventListener('click', async e => {
  const btn = e.target.closest('[data-bulk]')
  if (!btn) return
  const what = btn.dataset.bulk
  const ids = [...state.checked]
  if (what === 'clear') { state.checked.clear(); renderRows(); return }
  if (what === 'start') { for (const id of ids) await api('POST', `/api/bots/${id}/start`).catch(() => {}); toast(`Starting ${plural(ids.length, 'account')}.`); return }
  if (what === 'stop') { for (const id of ids) await api('POST', `/api/bots/${id}/stop`).catch(() => {}); toast(`Stopping ${plural(ids.length, 'account')}.`); return }
  if (what === 'afk') { let n = 0; for (const id of ids) { try { await api('POST', `/api/bots/${id}/afk`); n++ } catch {} } toast(`Sent ${state.settings.afkCommand} on ${plural(n, 'account')}.`); return }
  if (what === 'buy') {
    let n = 0
    const why = []
    for (const id of ids) { try { await api('POST', `/api/bots/${id}/buy`); n++ } catch (err) { why.push(`${nameOf(state.bots.get(id))}: ${err.message}`) } }
    toast(`Buying on ${plural(n, 'account')}.${why.length ? ' ' + why.join(' ') : ''}`, 7000)
    return
  }
  if (what === 'autobuy-on' || what === 'autobuy-off') {
    const on = what === 'autobuy-on'
    for (const id of ids) { try { const r = await api('PATCH', `/api/bots/${id}`, { autoBuy: on }); state.bots.set(id, r.bot) } catch {} }
    toast(`Auto-buy ${on ? 'on' : 'off'} for ${plural(ids.length, 'account')}.`)
    renderSoon()
  }
})

