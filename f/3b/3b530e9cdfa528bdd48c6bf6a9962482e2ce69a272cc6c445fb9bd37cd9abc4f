'use strict'
// Updates Golem AFK in place: only files that changed are written, the data folder
// (logins, bots, password) is never touched, and the app restarts afterwards.
// Sources: a Golem AFK zip the user picks, or an online manifest (latest.json + files by hash).
const fs = require('fs')
const path = require('path')
const crypto = require('crypto')
const { EventEmitter } = require('events')

const ROOT = path.join(__dirname, '..', '..') // the "Golem AFK" folder
const APP = path.join(ROOT, 'app')
const CURRENT = require('../package.json').version
// Online updates: <base>latest.json and <base>f/<sha256>
const ONLINE_BASE = process.env.GOLEM_AFK_UPDATES || 'https://raw.githubusercontent.com/Red56-Golem/golem-launcher/golem-afk-updates/'
// Never replaced by an update: the start file is running while we update (cmd reads it as it goes)
const SKIP = new Set(['Start Golem AFK.bat'])

const events = new EventEmitter()
const state = { current: CURRENT, latest: null, notes: [], status: 'idle', detail: '', progress: 0, online: true, checked: 0 }

function set (patch) {
  Object.assign(state, patch)
  events.emit('change', { ...state })
}

function sha256 (buf) { return crypto.createHash('sha256').update(buf).digest('hex') }
function newer (a, b) {
  const x = String(a).split('.').map(Number)
  const y = String(b).split('.').map(Number)
  for (let i = 0; i < 3; i++) if ((x[i] || 0) !== (y[i] || 0)) return (x[i] || 0) > (y[i] || 0)
  return false
}

// all files we manage, as paths relative to ROOT with forward slashes
function localFiles () {
  const out = new Map()
  const walk = (dir) => {
    for (const ent of fs.readdirSync(dir, { withFileTypes: true })) {
      const p = path.join(dir, ent.name)
      if (ent.isDirectory()) walk(p)
      else if (ent.isFile() && !ent.name.endsWith('.golem-old') && !ent.name.endsWith('.golem-new')) out.set(path.relative(ROOT, p).split(path.sep).join('/'), p)
    }
  }
  if (fs.existsSync(APP)) walk(APP)
  return out
}

function hashLocal (rel) {
  try { return sha256(fs.readFileSync(path.join(ROOT, rel))) } catch { return null }
}

function safeRel (rel) {
  const norm = path.posix.normalize(rel)
  if (norm.startsWith('../') || path.posix.isAbsolute(norm)) return null
  if (!(norm.startsWith('app/') || norm === 'README.txt' || norm.startsWith('node/'))) return null
  if (norm.startsWith('data/')) return null
  return norm
}

// Writes one file; a file in use (node.exe, native modules) is renamed out of the way first.
function writeFile (rel, buf) {
  const target = path.join(ROOT, rel)
  fs.mkdirSync(path.dirname(target), { recursive: true })
  const tmp = target + '.golem-new'
  fs.writeFileSync(tmp, buf)
  try {
    fs.renameSync(tmp, target)
  } catch (e) {
    const old = `${target}.${Date.now()}.golem-old`
    fs.renameSync(target, old)
    fs.renameSync(tmp, target)
  }
}

function removeFile (rel) {
  const target = path.join(ROOT, rel)
  try { fs.rmSync(target) } catch {
    try { fs.renameSync(target, `${target}.${Date.now()}.golem-old`) } catch {}
  }
}

// Leftovers from the last update (files that were in use) are deleted at start-up.
function cleanup () {
  if (!installed()) return
  const walk = (dir) => {
    let entries = []
    try { entries = fs.readdirSync(dir, { withFileTypes: true }) } catch { return }
    for (const ent of entries) {
      const p = path.join(dir, ent.name)
      if (ent.isDirectory()) { walk(p); try { if (!fs.readdirSync(p).length) fs.rmdirSync(p) } catch {} } else if (ent.name.endsWith('.golem-old') || ent.name.endsWith('.golem-new')) { try { fs.rmSync(p) } catch {} }
    }
  }
  walk(APP)
  walk(path.join(ROOT, 'node'))
}

// files: [{ path, sha, size, load: async () => Buffer }]
function installed () {
  return path.resolve(APP, 'src') === path.resolve(__dirname) && fs.existsSync(path.join(ROOT, 'Start Golem AFK.bat'))
}

async function applyFiles (version, files) {
  if (!installed()) throw new Error('Updates only work in the Golem AFK folder started with Start Golem AFK.bat.')
  const wanted = new Map()
  for (const f of files) {
    const rel = safeRel(f.path)
    if (rel && !SKIP.has(rel)) wanted.set(rel, f)
  }
  if (!wanted.has('app/src/server.js')) throw new Error("That isn't a Golem AFK update.")
  const changed = []
  for (const [rel, f] of wanted) if (hashLocal(rel) !== f.sha) changed.push([rel, f])
  const extra = [...localFiles().keys()].filter(rel => rel.startsWith('app/') && !wanted.has(rel))

  set({ status: 'downloading', detail: `Getting ${changed.length} changed file${changed.length === 1 ? '' : 's'}`, progress: 0 })
  // load + check everything before writing anything
  const ready = []
  let done = 0
  const queue = changed.slice()
  const worker = async () => {
    while (queue.length) {
      const [rel, f] = queue.shift()
      const buf = await f.load()
      if (sha256(buf) !== f.sha) throw new Error(`A downloaded file was damaged (${rel}). Nothing was changed; try again.`)
      ready.push([rel, buf])
      done++
      set({ progress: changed.length ? done / changed.length : 1 })
    }
  }
  await Promise.all(Array.from({ length: 6 }, worker))

  set({ status: 'installing', detail: 'Copying files', progress: 1 })
  for (const [rel, buf] of ready) writeFile(rel, buf)
  for (const rel of extra) removeFile(rel)
  set({ status: 'restarting', detail: `Updated to ${version}. Restarting...`, latest: version })
  return { changed: changed.length, removed: extra.length }
}

// ---- from a zip the user picked ------------------------------------------

function applyZip (buffer) {
  const AdmZip = require('adm-zip')
  let zip
  try { zip = new AdmZip(buffer) } catch { throw new Error("That file isn't a zip.") }
  const entries = zip.getEntries().filter(e => !e.isDirectory)
  // the zip has a top folder ("Golem AFK/"); find it from app/src/server.js
  const marker = entries.find(e => /(^|\/)app\/src\/server\.js$/.test(e.entryName))
  if (!marker) throw new Error("That zip doesn't contain Golem AFK.")
  const prefix = marker.entryName.slice(0, marker.entryName.length - 'app/src/server.js'.length)
  let version = '?'
  const pkg = entries.find(e => e.entryName === prefix + 'app/package.json')
  if (pkg) { try { version = JSON.parse(pkg.getData().toString('utf8')).version } catch {} }
  const files = entries
    .filter(e => e.entryName.startsWith(prefix))
    .map(e => {
      const data = e.getData()
      return { path: e.entryName.slice(prefix.length), sha: sha256(data), size: data.length, load: async () => data }
    })
  return applyFiles(version, files).then(r => ({ ...r, version }))
}

// ---- online ---------------------------------------------------------------

async function fetchJson (url) {
  const res = await fetch(url, { headers: { 'cache-control': 'no-cache' } })
  if (res.status === 404) return null
  if (!res.ok) throw new Error(`The update server answered ${res.status}.`)
  return res.json()
}

let manifest = null
async function check () {
  if (['downloading', 'installing', 'restarting'].includes(state.status)) return { ...state }
  set({ status: 'checking', detail: 'Checking for updates' })
  try {
    manifest = await fetchJson(ONLINE_BASE + 'latest.json?' + Date.now())
    if (!manifest || !manifest.version) {
      set({ status: 'idle', online: false, detail: 'Automatic updates are not set up yet. Install new versions from a zip.', checked: Date.now() })
    } else if (newer(manifest.version, CURRENT)) {
      set({ status: 'available', online: true, latest: manifest.version, notes: manifest.notes || [], detail: `Version ${manifest.version} is ready to install.`, checked: Date.now() })
    } else {
      set({ status: 'idle', online: true, latest: manifest.version, notes: [], detail: "You're on the newest version.", checked: Date.now() })
    }
  } catch (e) {
    set({ status: 'idle', detail: `Couldn't check for updates: ${e.message}`, checked: Date.now() })
  }
  return { ...state }
}

async function applyOnline () {
  if (!manifest || !newer(manifest.version, CURRENT)) await check()
  if (!manifest || !newer(manifest.version, CURRENT)) throw new Error('There is no update to install.')
  const files = manifest.files.map(f => ({
    path: f.path,
    sha: f.sha,
    size: f.size,
    load: async () => {
      if (f.skip) throw new Error(`${f.path} has to be updated by downloading the full zip.`)
      const res = await fetch(ONLINE_BASE + 'f/' + f.sha.slice(0, 2) + '/' + f.sha)
      if (!res.ok) throw new Error(`Couldn't download ${f.path} (${res.status}).`)
      return Buffer.from(await res.arrayBuffer())
    }
  }))
  return applyFiles(manifest.version, files).then(r => ({ ...r, version: manifest.version }))
}

function fail (e) {
  set({ status: manifest && newer(manifest.version, CURRENT) ? 'available' : 'idle', detail: e.message, progress: 0 })
}

module.exports = { state, events, check, applyZip, applyOnline, cleanup, fail, CURRENT, ROOT }
