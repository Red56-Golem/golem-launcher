function readSettings (f) {
  const v = n => f.elements[n]
  const out = {
    host: v('host').value, port: v('port').value, label: v('label').value, version: v('version') ? v('version').value : 'auto',
    auth: f.querySelector('input[name=auth]:checked').value, name: v('name').value,
    joinCommands: v('joinCommands').value,
    repeat: { on: v('repeat.on').checked, every: v('repeat.every').value, commands: v('repeat.commands').value },
    antiAfk: { on: v('antiAfk.on').checked, every: v('antiAfk.every').value, actions: AFK_ACTIONS.map(a => a[0]).filter(k => v('afk:' + k).checked) },
    reconnect: { on: v('reconnect.on').checked, delay: v('reconnect.delay').value, onDuplicate: v('reconnect.onDuplicate').value },
    autoEat: v('autoEat').checked,
    alerts: v('alerts').checked
  }
  return out
}

$('#paneSettings').addEventListener('input', e => {
  state.dirty = true
  $('#dirtyNote').textContent = 'Unsaved changes'
  if (e.target.name === 'auth') {
    for (const el of $('#paneSettings').querySelectorAll('[data-show]')) el.hidden = el.dataset.show !== e.target.value
  }
})
$('#paneSettings').addEventListener('submit', async e => {
  e.preventDefault()
  const f = e.currentTarget
  const data = readSettings(f)
  const isBedrock = (state.bots.get(state.selected) || {}).edition === 'bedrock'
  if (data.auth === 'offline' && !(isBedrock ? /^[A-Za-z0-9_ ]{3,16}$/ : /^[A-Za-z0-9_]{3,16}$/).test(data.name)) return toast('Offline names need 3 to 16 letters, numbers or underscores.')
  try {
    const res = await api('PATCH', `/api/bots/${state.selected}`, data)
    state.bots.set(res.bot.cfg.id, res.bot)
    state.dirty = false
    renderSettings()
    render()
    if (res.needsRestart) {
      if (confirm('Saved. Restart the bot now to use the new connection settings?')) await api('POST', `/api/bots/${state.selected}/restart`)
    } else toast('Saved. Changes apply the next time the bot joins.')
  } catch (err) { toast(err.message) }
})
$('#paneSettings').addEventListener('click', async e => {
  if (e.target.closest('#removeBtn')) {
    const b = state.bots.get(state.selected)
    if (!confirm(`Remove ${nameOf(b)}? It disconnects, and its saved sign-in and chat log are deleted.`)) return
    state.dirty = false
    await api('DELETE', `/api/bots/${state.selected}`).catch(err => toast(err.message))
    toast('Bot removed.')
  }
  if (e.target.closest('#forgetBtn')) {
    if (!confirm('Sign this bot out of its Microsoft account? It stops, and asks for a new code next time it starts.')) return
    await api('POST', `/api/bots/${state.selected}/forget`).catch(err => toast(err.message))
    toast('Signed out. Start the bot to sign in again.')
  }
})

