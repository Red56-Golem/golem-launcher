'use strict'
// Screenshots: copies the blocks around a bot and has the render worker draw its view.
// Only the newest picture per bot is kept (data/shots/<botId>.png).
const fs = require('fs')
const path = require('path')
const { Worker } = require('worker_threads')
const { PNG } = require('pngjs')
const { DATA } = require('./store')

const SHOT_DIR = path.join(DATA, 'shots')
fs.mkdirSync(SHOT_DIR, { recursive: true })
const WIDTH = 854
const HEIGHT = 480
const RANGE = 36 // blocks around the bot that are drawn
const RANGE_Y = 24

// Pictures are drawn by a few worker threads at once (one per spare CPU core, up to 4),
// so short screenshot timings keep up with many bots.
const POOL = Number(process.env.GOLEM_AFK_RENDERERS) || Math.max(1, Math.min(4, require('os').cpus().length - 1))
const slots = [] // { worker, sent: Set(table keys), busy }
const freeWaiters = []
let assets = null
let atlasInfo = null
const tablePayload = new Map() // key -> tables sent to each worker
const waiting = new Map()
let nextId = 1

function shotFile (id) { return path.join(SHOT_DIR, `${id}.png`) }

function loadAssets () {
  if (assets) return assets
  const dir = path.join(__dirname, 'assets')
  atlasInfo = JSON.parse(fs.readFileSync(path.join(dir, 'atlas.json'), 'utf8'))
  const img = PNG.sync.read(fs.readFileSync(path.join(dir, 'atlas.png')))
  assets = { atlas: { data: new Uint8Array(img.data), width: img.width, cols: atlasInfo.cols } }
  try {
    const hudInfo = JSON.parse(fs.readFileSync(path.join(dir, 'hud.json'), 'utf8'))
    const hudImg = PNG.sync.read(fs.readFileSync(path.join(dir, 'hud.png')))
    const itemInfo = JSON.parse(fs.readFileSync(path.join(dir, 'items.json'), 'utf8'))
    const itemImg = PNG.sync.read(fs.readFileSync(path.join(dir, 'items.png')))
    assets.hud = {
      hud: { data: new Uint8Array(hudImg.data), width: hudImg.width, ...hudInfo },
      items: { data: new Uint8Array(itemImg.data), width: itemImg.width, cols: itemInfo.cols, items: itemInfo.items }
    }
  } catch (e) { console.error('[screenshots] HUD images:', e.message) }
  return assets
}

function newSlot () {
  const a = loadAssets()
  const slot = { worker: new Worker(path.join(__dirname, 'render-worker.js')), sent: new Set(), busy: false, jobs: new Set() }
  slot.worker.unref()
  slot.worker.on('message', (msg) => {
    const w = waiting.get(msg.id)
    if (!w) return
    waiting.delete(msg.id)
    slot.jobs.delete(msg.id)
    if (msg.error) w.reject(new Error(msg.error))
    else w.resolve(msg)
  })
  slot.worker.on('error', (e) => {
    for (const id of slot.jobs) { const w = waiting.get(id); waiting.delete(id); if (w) w.reject(e) }
    const i = slots.indexOf(slot)
    if (i >= 0) slots.splice(i, 1)
    if (slot.busy) release(null)
  })
  slot.worker.postMessage({ type: 'atlas', atlas: a.atlas })
  if (a.hud) slot.worker.postMessage({ type: 'hud', ...a.hud })
  slots.push(slot)
  return slot
}

// waits for a free worker
function acquire () {
  let slot = slots.find(x => !x.busy)
  if (!slot && slots.length < POOL) slot = newSlot()
  if (slot) { slot.busy = true; return Promise.resolve(slot) }
  return new Promise(resolve => freeWaiters.push(resolve))
}
function release (slot) {
  if (slot) slot.busy = false
  const next = freeWaiters.shift()
  if (!next) return
  let s = slots.find(x => !x.busy)
  if (!s && slots.length < POOL) s = newSlot()
  if (s) { s.busy = true; next(s) } else freeWaiters.unshift(next)
}

const tableCache = new Map() // key -> { kind, box, emit } for light estimates
let b2jCache = null

// Bedrock block -> Java block name (textures are Java names). Uses minecraft-data's mapping.
function bedrockNames (registry) {
  if (!b2jCache) {
    b2jCache = { full: new Map(), byName: new Map() }
    try {
      const fs2 = require('fs')
      const dp = JSON.parse(fs2.readFileSync(require.resolve('minecraft-data/minecraft-data/data/dataPaths.json'), 'utf8')).bedrock
      const rel = (dp[registry.version.minecraftVersion] || {}).blocksB2J
      if (rel) {
        const map = JSON.parse(fs2.readFileSync(path.join(path.dirname(require.resolve('minecraft-data/minecraft-data/data/dataPaths.json')), rel, 'blocksB2J.json'), 'utf8'))
        const counts = new Map()
        for (const [b, j] of Object.entries(map)) {
          const jn = j.slice(10, j.indexOf('['))
          b2jCache.full.set(b, jn)
          const bn = b.slice(10, b.indexOf('['))
          const c = counts.get(bn) || new Map()
          c.set(jn, (c.get(jn) || 0) + 1)
          counts.set(bn, c)
        }
        for (const [bn, c] of counts) b2jCache.byName.set(bn, [...c.entries()].sort((a, b) => b[1] - a[1])[0][0])
      }
    } catch (e) { console.error('[screenshots] Bedrock block names:', e.message) }
  }
  return (stateId) => {
    const st = registry.blockStates[stateId]
    if (!st) return null
    const props = Object.keys(st.states || {}).sort().map(k => `${k}=${st.states[k].value}`).join(',')
    return b2jCache.full.get(`minecraft:${st.name}[${props}]`) || b2jCache.byName.get(st.name) || st.name
  }
}

// Per Minecraft version: what each block state looks like
function sendTables (registry, bedrock) {
  const key = (bedrock ? 'bedrock_' : '') + registry.version.minecraftVersion
  if (tablePayload.has(key)) return key
  loadAssets()
  const javaName = bedrock ? bedrockNames(registry) : null
  let max = 0
  for (const b of registry.blocksArray) if (b.maxStateId > max) max = b.maxStateId
  const n = max + 1
  const kind = new Uint8Array(n)
  const tex = new Uint16Array(n * 3).fill(0xFFFF)
  const tint = new Uint8Array(n)
  const box = new Uint8Array(n * 6)
  const emit = new Uint8Array(n)
  const shapes = registry.blockCollisionShapes || { blocks: {}, shapes: {} }
  const KIND = { cube: 1, cross: 2, water: 3, lava: 4 }
  for (const b of registry.blocksArray) {
    if (b.name === 'air' || b.name === 'cave_air' || b.name === 'void_air') continue
    const shapeRef = shapes.blocks[b.name]
    for (let s = b.minStateId; s <= b.maxStateId; s++) {
      let tname = javaName ? javaName(s) : b.name
      if (tname === 'flowing_water' || tname === 'bubble_column') tname = 'water'
      if (tname === 'flowing_lava') tname = 'lava'
      if (tname === 'air' || tname === 'cave_air' || tname === 'void_air' || tname === 'light_block' || tname === 'light') continue
      const a = atlasInfo.blocks[tname]
      emit[s] = Math.min(15, b.emitLight || 0)
      let k = a ? KIND[a.k] : 1
      const idx = Array.isArray(shapeRef) ? shapeRef[s - b.minStateId] : shapeRef
      const boxes = (idx !== undefined && shapes.shapes[idx]) || []
      if (k === 1 && boxes.length === 0 && !(bedrock && idx === undefined)) k = 0 // torches, signs, buttons: skip
      kind[s] = k
      if (a) {
        tex[s * 3] = a.t[0]; tex[s * 3 + 1] = a.t[1]; tex[s * 3 + 2] = a.t[2]
        tint[s] = (a.tint[0] ? 1 : 0) | (a.tint[1] ? 2 : 0) | (a.tint[2] ? 4 : 0) | (a.tt === 'foliage' ? 8 : 0) | (a.tt === 'water' ? 16 : 0)
      }
      let x0 = 1; let y0 = 1; let z0 = 1; let x1 = 0; let y1 = 0; let z1 = 0
      if (k === 1 && boxes.length) {
        for (const bx of boxes) {
          x0 = Math.min(x0, bx[0]); y0 = Math.min(y0, bx[1]); z0 = Math.min(z0, bx[2])
          x1 = Math.max(x1, bx[3]); y1 = Math.max(y1, bx[4]); z1 = Math.max(z1, bx[5])
        }
      } else { x0 = 0; y0 = 0; z0 = 0; x1 = 1; y1 = 1; z1 = 1 }
      const q = v => Math.round(Math.min(1, Math.max(0, v)) * 16)
      box.set([q(x0), q(y0), q(z0), q(x1), q(y1), q(z1)], s * 6)
      if (box[s * 6 + 4] <= box[s * 6 + 1]) box[s * 6 + 4] = box[s * 6 + 1] + 1
    }
  }
  tablePayload.set(key, { kind, tex, tint, box })
  tableCache.set(key, { kind, box, emit })
  return key
}

function daylight (bot) {
  const t = bot.time && typeof bot.time.timeOfDay === 'number' ? bot.time.timeOfDay : 6000
  if (t < 12000) return 1
  if (t < 13800) return 1 - (t - 12000) / 1800
  if (t < 22200) return 0
  return (t - 22200) / 1800
}

// Copies blocks + light around the bot. Runs on the main thread (fast, no allocation per block).
function snapshot (bot) {
  const p = bot.entity.position
  const minY = bot.game.minY ?? -64
  const maxY = minY + (bot.game.height ?? 384) - 1
  const ox = Math.floor(p.x) - RANGE
  const oz = Math.floor(p.z) - RANGE
  const oy = Math.floor(p.y + 1.62) - RANGE_Y
  const sx = RANGE * 2 + 1
  const sz = RANGE * 2 + 1
  const sy = RANGE_Y * 2 + 1
  const states = new Uint16Array(sx * sy * sz)
  const light = new Uint8Array(sx * sy * sz).fill(0xF0)
  const pos = { x: 0, y: 0, z: 0 }
  for (let cx = Math.floor(ox / 16); cx <= Math.floor((ox + sx - 1) / 16); cx++) {
    for (let cz = Math.floor(oz / 16); cz <= Math.floor((oz + sz - 1) / 16); cz++) {
      const col = bot.world.getColumn(cx, cz)
      if (!col) continue
      const x0 = Math.max(ox, cx * 16); const x1 = Math.min(ox + sx - 1, cx * 16 + 15)
      const z0 = Math.max(oz, cz * 16); const z1 = Math.min(oz + sz - 1, cz * 16 + 15)
      for (let y = Math.max(oy, minY); y <= Math.min(oy + sy - 1, maxY); y++) {
        pos.y = y
        for (let z = z0; z <= z1; z++) {
          pos.z = z & 15
          const row = ((y - oy) * sz + (z - oz)) * sx
          for (let x = x0; x <= x1; x++) {
            pos.x = x & 15
            const i = row + (x - ox)
            const s = col.getBlockStateId(pos)
            states[i] = s
            let sky = 15
            let blk = 0
            try { sky = col.getSkyLight(pos); blk = col.getBlockLight(pos) } catch {}
            light[i] = ((sky & 15) << 4) | (blk & 15)
          }
        }
      }
    }
  }
  return { ox, oy, oz, sx, sy, sz, states, light }
}

// Bedrock servers don't send light: estimate it. Open sky lights everything above the
// highest solid block and spreads sideways; light-giving blocks light their surroundings.
function estimateLight (snap, tables) {
  const { sx, sy, sz, states, light } = snap
  const { kind, box, emit } = tables
  const n = sx * sy * sz
  const solid = new Uint8Array(n)
  for (let i = 0; i < n; i++) {
    const s = states[i]
    const k = kind[s]
    if (k === 1 && box[s * 6] === 0 && box[s * 6 + 2] === 0 && box[s * 6 + 3] === 16 && box[s * 6 + 5] === 16 && box[s * 6 + 4] === 16) solid[i] = 1
  }
  const sky = new Uint8Array(n)
  const blk = new Uint8Array(n)
  const queueS = []
  const queueB = []
  for (let z = 0; z < sz; z++) {
    for (let x = 0; x < sx; x++) {
      for (let y = sy - 1; y >= 0; y--) {
        const i = (y * sz + z) * sx + x
        if (solid[i]) break
        sky[i] = 15
        queueS.push(i)
      }
    }
  }
  for (let i = 0; i < n; i++) if (emit[states[i]]) { blk[i] = emit[states[i]]; queueB.push(i) }
  const spread = (lv, queue, down) => {
    let head = 0
    while (head < queue.length) {
      const i = queue[head++]
      const v = lv[i] - 1
      if (v <= 0) continue
      const x = i % sx
      const z = ((i / sx) | 0) % sz
      const y = (i / (sx * sz)) | 0
      const tryAt = (j) => { if (!solid[j] && lv[j] < v) { lv[j] = v; queue.push(j) } }
      if (x > 0) tryAt(i - 1)
      if (x < sx - 1) tryAt(i + 1)
      if (z > 0) tryAt(i - sx)
      if (z < sz - 1) tryAt(i + sx)
      if (y > 0) tryAt(i - sx * sz)
      if (y < sy - 1 && down) tryAt(i + sx * sz)
    }
  }
  spread(sky, queueS, true)
  spread(blk, queueB, true)
  for (let i = 0; i < n; i++) light[i] = (sky[i] << 4) | blk[i]
}

function bedrockSnapshot (world) {
  const e = world.eye
  const ox = Math.floor(e.x) - RANGE
  const oz = Math.floor(e.z) - RANGE
  const oy = Math.floor(e.y) - RANGE_Y
  const sx = RANGE * 2 + 1
  const sz = RANGE * 2 + 1
  const sy = RANGE_Y * 2 + 1
  const states = new Uint16Array(sx * sy * sz)
  const light = new Uint8Array(sx * sy * sz)
  const pos = { x: 0, y: 0, z: 0, l: 0 }
  for (let cx = Math.floor(ox / 16); cx <= Math.floor((ox + sx - 1) / 16); cx++) {
    for (let cz = Math.floor(oz / 16); cz <= Math.floor((oz + sz - 1) / 16); cz++) {
      const col = world.columns.get(`${cx},${cz}`)
      if (!col) continue
      const x0 = Math.max(ox, cx * 16); const x1 = Math.min(ox + sx - 1, cx * 16 + 15)
      const z0 = Math.max(oz, cz * 16); const z1 = Math.min(oz + sz - 1, cz * 16 + 15)
      for (let y = Math.max(oy, col.minY); y <= Math.min(oy + sy - 1, col.maxY - 1); y++) {
        pos.y = y
        for (let z = z0; z <= z1; z++) {
          pos.z = z & 15
          const row = ((y - oy) * sz + (z - oz)) * sx
          for (let x = x0; x <= x1; x++) {
            pos.x = x & 15
            let s = 0
            try { s = col.getBlockStateId(pos) || 0 } catch {}
            states[row + (x - ox)] = s
          }
        }
      }
    }
  }
  return { ox, oy, oz, sx, sy, sz, states, light }
}

function writeBedrockReport (afk, extra) {
  try {
    const rep = { when: new Date().toISOString(), bot: afk.cfg.host, ...afk.world.report(), ...extra }
    fs.writeFileSync(path.join(DATA, 'bedrock-report.json'), JSON.stringify(rep, (k, v) => typeof v === 'bigint' ? String(v) : v, 2))
  } catch {}
}

function bedrockJob (afk) {
  const world = afk.world
  if (!world || !world.eye) throw new Error('The bot has to be online and in a world.')
  writeBedrockReport(afk, {})
  if (!world.columns.size) throw new Error('The server hasn\'t sent the world around the bot yet. Try again in a few seconds.')
  const key = sendTables(world.registry, true)
  const snap = bedrockSnapshot(world)
  let blocks = 0
  for (let i = 0; i < snap.states.length; i++) if (snap.states[i]) { blocks++; if (blocks > 50) break }
  if (blocks <= 50) throw new Error(`The bot hasn't got the blocks around it yet (${world.summary()}).`)
  estimateLight(snap, tableCache.get(key))
  const t = world.time
  const day = t < 12000 ? 1 : t < 13800 ? 1 - (t - 12000) / 1800 : t < 22200 ? 0 : (t - 22200) / 1800
  const ents = []
  for (const e of world.entities.values()) {
    const d = Math.hypot(e.x - world.eye.x, e.y - world.eye.y, e.z - world.eye.z)
    if (d <= RANGE) ents.push({ ...e })
  }
  return {
    job: { key, width: WIDTH, height: HEIGHT, range: RANGE, ...snap, eye: [world.eye.x, world.eye.y, world.eye.z], yaw: world.yaw, pitch: world.pitch, day, entities: ents, hud: afk.hudState() },
    snap,
    eye: { x: world.eye.x, y: world.eye.y - 1.62, z: world.eye.z },
    yaw: world.yaw
  }
}

function entities (bot) {
  const me = bot.entity
  const out = []
  for (const e of Object.values(bot.entities)) {
    if (!e || e === me || !e.position) continue
    const d = e.position.distanceTo(me.position)
    if (d > RANGE) continue
    const kind = e.type === 'player' ? 'player' : e.name === 'item' ? 'item' : (e.type === 'mob' || e.type === 'hostile' || e.type === 'animal' || e.type === 'passive' || e.type === 'water_creature' || e.type === 'ambient') ? 'mob' : 'other'
    if (kind === 'other') continue
    out.push({
      x: e.position.x, y: e.position.y, z: e.position.z,
      w: kind === 'item' ? 0.3 : (e.width || 0.6),
      h: kind === 'item' ? 0.3 : (e.height || 1.8),
      kind,
      name: kind === 'player' ? e.username : e.name
    })
  }
  return out
}

// Takes a screenshot for an AfkBot (Java only). Resolves with { t, labels }.
function capture (afk) {
  return acquire().then(async (slot) => {
    try { return await render(afk, slot) } finally { release(slot) }
  })
}

async function render (afk, slot) {
  {
    if (afk.status !== 'online') throw new Error('The bot has to be online and in a world.')
    let job, snap, eye, yaw
    if (afk.edition() === 'bedrock') {
      ({ job, snap, eye, yaw } = bedrockJob(afk))
    } else {
      const bot = afk.mc
      if (!bot || !bot.entity) throw new Error('The bot has to be online and in a world.')
      const key = sendTables(bot.registry)
      snap = snapshot(bot)
      eye = bot.entity.position
      yaw = bot.entity.yaw
      job = {
        key, width: WIDTH, height: HEIGHT, range: RANGE,
        ...snap,
        eye: [eye.x, eye.y + 1.62, eye.z],
        yaw: bot.entity.yaw,
        pitch: bot.entity.pitch,
        day: daylight(bot),
        entities: entities(bot),
        hud: afk.hudState()
      }
    }
    if (!slot.sent.has(job.key)) {
      slot.worker.postMessage({ type: 'tables', key: job.key, tables: tablePayload.get(job.key) })
      slot.sent.add(job.key)
    }
    const id = nextId++
    const done = new Promise((resolve, reject) => waiting.set(id, { resolve, reject }))
    slot.jobs.add(id)
    slot.worker.postMessage({ type: 'render', id, job }, [snap.states.buffer, snap.light.buffer])
    const res = await withTimeout(done, 30000)
    const file = shotFile(afk.cfg.id)
    fs.writeFileSync(file + '.tmp', Buffer.from(res.png))
    fs.renameSync(file + '.tmp', file) // replaces (deletes) the previous picture
    return {
      t: Date.now(),
      labels: res.labels,
      x: Math.floor(eye.x), y: Math.floor(eye.y), z: Math.floor(eye.z),
      facing: facing(yaw)
    }
  }
}

function facing (yaw) {
  const deg = ((-yaw * 180 / Math.PI) % 360 + 360) % 360 // 0 = north, 90 = east
  return ['north', 'north-east', 'east', 'south-east', 'south', 'south-west', 'west', 'north-west'][Math.round(deg / 45) % 8]
}

function withTimeout (p, ms) {
  return Promise.race([p, new Promise((resolve, reject) => setTimeout(() => reject(new Error('Taking the screenshot took too long.')), ms))])
}

function remove (id) { fs.rmSync(shotFile(id), { force: true }) }

module.exports = { capture, shotFile, remove }
