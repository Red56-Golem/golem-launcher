$('#addForm').addEventListener('submit', async e => {
  e.preventDefault()
  const f = e.currentTarget
  const el = f.elements
  const body = { edition: el.edition.value, host: el.host.value, auth: el.auth.value, name: el.name.value, label: el.label.value, start: true }
  try {
    const res = await api('POST', '/api/bots', body)
