})

app.post('/api/setup', (req, res) => {
  if (config.password) return res.status(409).json({ error: 'A password is already set.' })
  const pw = String(req.body.password || '')
  if (pw.length < 6) return res.status(400).json({ error: 'Use at least 6 characters.' })
  store.setPassword(pw)
  setCookie(res, store.newSession())
  res.json({ ok: true })
})

app.post('/api/login', (req, res) => {
  const failed = recentFailures(req)
  if (failed.length >= 8) return res.status(429).json({ error: 'Too many wrong passwords. Wait a minute and try again.' })
  if (!store.checkPassword(req.body.password)) {
    failed.push(Date.now())
    return res.status(401).json({ error: "That password isn't right." })
  }
  setCookie(res, store.newSession())
  res.json({ ok: true })
})

app.post('/api/logout', (req, res) => {
  store.endSession(cookieToken(req))
  res.setHeader('Set-Cookie', 'golem_afk=; Path=/; Max-Age=0')
  res.json({ ok: true })
})

