function cookieToken (req) {
  const m = /(?:^|;\s*)golem_afk=([a-f0-9]+)/.exec(req.headers.cookie || '')
  return m ? m[1] : ''
}
function signedIn (req) { return store.hasSession(cookieToken(req)) }
function setCookie (res, token) {
  res.setHeader('Set-Cookie', `golem_afk=${token}; Path=/; HttpOnly; SameSite=Strict; Max-Age=${60 * 60 * 24 * 365}`)
}

const failures = new Map()
function recentFailures (req) {
  const ip = req.socket.remoteAddress || '?'
  const list = (failures.get(ip) || []).filter(t => Date.now() - t < 60000)
  failures.set(ip, list)
  return list
}

