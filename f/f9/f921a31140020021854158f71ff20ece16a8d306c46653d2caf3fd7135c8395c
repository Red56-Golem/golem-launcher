function updateMore (b, more) {
  const f = k => more.querySelector(`[data-f="${k}"]`)
  const t = tally(b)
  const bought = Object.entries(t.bought || {}).filter(([, n]) => n > 0)
  const st = b.stash || { total: 0, kinds: [] }
  f('stash').innerHTML = st.total ? st.kinds.map(k => `<li>${num(k.count)} ${esc(k.name)}${k.count === 1 ? '' : 's'}</li>`).join('') : '<li class="zero">No spawners in its inventory</li>'
  const sb = f('sendBtn')
  sb.disabled = !st.total || b.status !== 'online' || !!(b.job && b.job.state === 'running')
  sb.title = state.settings.mainName ? `Teleports to ${state.settings.mainName} with /tpa and drops its spawners there` : 'Put your main account in Settings first'
  sb.textContent = state.settings.mainName ? `Send to ${state.settings.mainName}` : 'Send to main'
  f('bought').innerHTML = bought.length ? bought.map(([mob, n]) => `<li>${plural(n, `${esc(mob)} spawner`)}</li>`).join('') : '<li class="zero">Nothing yet</li>'
  const afk = b.status !== 'online' ? 'Offline' : b.afk && b.afk.in ? '<span class="afk-in">Idle in the AFK area</span>' : '<span class="afk-out">Not in the AFK area</span>'
  f('totals').innerHTML = `<li><span class="plus">+${num(t.earned || 0)}</span> shards earned in total</li>
    ${b.afk && b.afk.since && b.status === 'online' ? `<li>Next shard in ${duration(Math.max(0, b.afk.since + 60000 - Date.now()))}</li>` : ''}
    <li>Last shard ${t.lastShardAt ? (Date.now() - t.lastShardAt < 60000 ? 'just now' : `${duration(Date.now() - t.lastShardAt)} ago`) : 'not yet'}</li>
    <li>${plural(t.spent || 0, 'shard')} spent</li>
    <li>${plural(t.disconnects || 0, 'disconnect')}</li>
    <li>${afk}</li>`
  const g = state.groups.find(x => x.id === b.cfg.group)
  f('proxy').textContent = b.cfg.proxy === 'none' ? 'No proxy' : b.cfg.proxy ? b.cfg.proxy.replace(/:[^:@/]+@/, ':•••@') : g && g.proxy ? `From group ${g.name}: ${parseProxyLabel(g.proxy)}` : 'No proxy'
  const ab = f('autobuy')
  if (document.activeElement !== ab) ab.checked = !!b.cfg.autoBuy
  f('autobuyText').textContent = b.cfg.autoBuy ? `On: buys ${state.settings.buyMob} spawners whenever it can afford one` : 'Off'
  const p = price()
  const have = shardNumber(b.stats && b.stats.shards)
  const can = p && have ? Math.floor(have.value / p) : 0
  const bb = f('buyBtn')
  bb.textContent = can ? `Buy ${num(can)} now` : 'Buy now'
  bb.disabled = b.status !== 'online' || !can || !!(b.job && b.job.state === 'running')
  f('afkchip').textContent = state.settings.afkCommand || '/afk 1'
  const running = !['stopped', 'error', 'paused'].includes(b.status)
  f('conn').innerHTML = (running ? '<button type="button" class="btn small" data-act="stop">Stop</button><button type="button" class="btn small" data-act="restart">Reconnect</button>' : '<button type="button" class="btn small primary" data-act="start">Start</button>') +
    (b.cfg.auth === 'microsoft' ? '<button type="button" class="btn small" data-act="signin">Sign in again</button>' : '') +
    '<button type="button" class="btn small" data-act="settings">Settings</button><button type="button" class="btn small danger" data-act="remove">Remove</button>'
}

// commands and replies (kept in memory only, last 100)
async function loadOut (id) {
  const out = $(`.acct[data-id="${id}"] [data-f="out"]`)
  if (!out) return
  out.innerHTML = '<p class="note">Loading...</p>'
  try {
    const data = await api('GET', `/api/bots/${id}/log`)
    state.logs.set(id, data.log)
    const el = $(`.acct[data-id="${id}"] [data-f="out"]`)
    if (!el) return
    el.innerHTML = data.log.length ? data.log.map(outLine).join('') : '<p class="note">Commands you send and what the server answers show up here.</p>'
    el.scrollTop = el.scrollHeight
  } catch (e) { out.innerHTML = `<p class="note">${esc(e.message)}</p>` }
}
function outLine (l) {
  return `<div class="ln ${l.kind}"><time>${clock(l.t)}</time><span class="t">${esc(l.text)}</span></div>`
}
function appendOut (l) {
  const out = $(`.acct[data-id="${state.open}"] [data-f="out"]`)
  if (!out) return
  const bottom = out.scrollHeight - out.scrollTop - out.clientHeight < 30
  const note = out.querySelector('.note')
  if (note) note.remove()
  out.insertAdjacentHTML('beforeend', outLine(l))
  while (out.children.length > 100) out.firstElementChild.remove()
  if (bottom) out.scrollTop = out.scrollHeight
}

async function sendCommand (id, text) {
  let cmd = String(text || '').trim()
  if (!cmd) return
  if (!cmd.startsWith('/')) cmd = '/' + cmd // commands only
  await api('POST', `/api/bots/${id}/say`, { text: cmd })
}

async function act (id, what) {
  const b = state.bots.get(id)
  if (!b) return
  try {
    switch (what) {
      case 'afk': await api('POST', `/api/bots/${id}/afk`); toast(`Sent ${state.settings.afkCommand}.`); break
      case 'start': await api('POST', `/api/bots/${id}/start`); break
      case 'stop': await api('POST', `/api/bots/${id}/stop`); break
      case 'restart': await api('POST', `/api/bots/${id}/restart`); break
      case 'send':
        if (!state.settings.mainName) { toast('Put your main account name in Settings first.'); openSettings().catch(() => {}); return }
        await api('POST', `/api/bots/${id}/send`)
        toast(`Sent /tpa ${state.settings.mainName}. Type /tpaccept on your main within 90 seconds.`, 7000)
        break
      case 'buy': { const r = await api('POST', `/api/bots/${id}/buy`); toast(`Buying ${plural(r.amount, `${state.settings.buyMob} spawner`)}.`); break }
      case 'signin': openSigninDialog(id); break
      case 'settings': openBotSettings(id); break
      case 'remove':
        if (!confirm(`Remove ${nameOf(b)}? It disconnects, and its saved sign-in is deleted.`)) return
        await api('DELETE', `/api/bots/${id}`)
        toast('Account removed.')
        break
    }
  } catch (err) { toast(err.message, 6000) }
}

$('#rows').addEventListener('click', e => {
  const acct = e.target.closest('.acct')
  if (!acct) return
  const id = acct.dataset.id
  const btn = e.target.closest('button[data-act]')
  if (btn) { act(id, btn.dataset.act); return }
  const q = e.target.closest('[data-q]')
  if (q) { sendCommand(id, q.dataset.q === 'afk' ? state.settings.afkCommand : q.dataset.q).catch(err => toast(err.message)); return }
  if (e.target.closest('.check, .more')) return
  if (e.target.closest('.sum')) {
    state.open = state.open === id ? null : id
    renderRows()
  }
})
$('#rows').addEventListener('change', async e => {
  const acct = e.target.closest('.acct')
  if (!acct) return
  const id = acct.dataset.id
  if (e.target.matches('[data-check]')) {
    if (e.target.checked) state.checked.add(id)
    else state.checked.delete(id)
    renderRows()
  }
  if (e.target.matches('[data-f="autobuy"]')) {
    try {
      const res = await api('PATCH', `/api/bots/${id}`, { autoBuy: e.target.checked })
      state.bots.set(id, res.bot)
      toast(e.target.checked ? `Auto-buy on. It buys ${state.settings.buyMob} spawners whenever it can afford one.` : 'Auto-buy off.')
      renderSoon()
    } catch (err) { toast(err.message) }
  }
})
$('#rows').addEventListener('submit', async e => {
  e.preventDefault()
  const acct = e.target.closest('.acct')
  const id = acct && acct.dataset.id
  const input = $('input', e.target)
  if (e.target.dataset.form === 'cmd') {
    try { await sendCommand(id, input.value); input.value = '' } catch (err) { toast(err.message) }
  }
  if (e.target.dataset.form === 'proxy') {
    const v = input.value.trim()
    const proxy = !v || /^group$/i.test(v) ? '' : /^none$/i.test(v) ? 'none' : v
    try {
      const res = await api('PATCH', `/api/bots/${id}`, { proxy })
      state.bots.set(id, res.bot)
      input.value = ''
      toast(proxy === '' ? "Uses its group's proxy now." : proxy === 'none' ? 'No proxy now.' : 'Proxy changed. It reconnects through the new one.')
      renderSoon()
    } catch (err) { toast(err.message, 6000) }
  }
})

