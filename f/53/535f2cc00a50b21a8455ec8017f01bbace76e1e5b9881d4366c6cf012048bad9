app.post('/api/bots/:id/:action', (req, res) => {
  const bot = bots.get(req.params.id)
  if (!bot) return res.status(404).json({ error: 'No such bot.' })
  switch (req.params.action) {
    case 'start':
      if (bot.start() === false) return res.status(409).json({ error: bot.detail })
      break
    case 'stop': bot.stop(); break
    case 'restart': bot.restart(); break
    case 'say':
      if (!bot.say(String(req.body.text || '').trim())) return res.status(409).json({ error: 'The bot has to be online to chat.' })
      break
    case 'choose-account': {
      if (bot.cfg.auth !== 'microsoft') return res.status(409).json({ error: 'This bot uses an offline name.' })
      if (!signin.findBrowser()) return res.status(409).json({ error: 'No Edge or Chrome found for the sign-in window. Use the code instead.' })
      res.json({ ok: true })
      bot.write('info', 'Sign-in window opened. Choose the Microsoft account for this bot.')
      broadcast({ type: 'signin', id: bot.cfg.id, state: 'open' })
      signin.pickAccount().then(token => {
        signin.saveForBot(bot.cfg.id, token)
        bot.cfg.account = ''
        save()
        bot.write('info', 'Signed in. Joining with the new account.')
        broadcast({ type: 'signin', id: bot.cfg.id, state: 'done' })
        if (bot.status === 'stopped' || bot.status === 'error' || bot.status === 'paused') bot.start()
        else bot.restart()
      }).catch(e => {
        bot.write('error', e.message)
        broadcast({ type: 'signin', id: bot.cfg.id, state: 'failed', text: e.message })
      })
      return
    }
    case 'screenshot':
      return bot.screenshot().then(shot => res.json({ shot })).catch(e => res.status(409).json({ error: e.message }))
    case 'play':
      try { bot.playMacro(String(req.body.macro || '')) } catch (e) { return res.status(409).json({ error: e.message }) }
      break
    case 'stopmacro': bot.stopMacro(); break
    case 'stopjob': donut.stopJob(bot); break
    case 'afk':
      if (bot.status !== 'online') return res.status(409).json({ error: 'The bot has to be online.' })
      bot.lastAfkCmd = Date.now()
      bot.sendLine(config.settings.afkCommand || '/afk 1')
      break
    case 'send':
      if (!String(config.settings.mainName || '').trim()) return res.status(409).json({ error: "Put your main account's name in Settings first." })
      if (bot.status !== 'online') return res.status(409).json({ error: 'The account has to be online.' })
      if (!bot.stash().total) return res.status(409).json({ error: 'It has no spawners to send.' })
      sendToMain(bot).catch(e => bot.write('error', e.message))
      return res.json({ ok: true })
    case 'buy': {
      const r = buyMax(bot)
      if (r.error) return res.status(409).json({ error: r.error })
      return res.json({ ok: true, amount: r.amount })
    }
    case 'forget':
      bot.stop('Signed out')
      setTimeout(() => bot.forgetAccount(), 3500)
      break
    default: return res.status(404).json({ error: 'Unknown action.' })
  }
  res.json({ ok: true })
})

// Bots start one at a time, startDelay seconds apart (Settings), so a server
// doesn't see many joins at once.
const startQueue = []
let starting = false
function queueStart (bot, fn) {
  if (startQueue.some(q => q.bot === bot)) return
  const blocked = laneBlock(bot, true)
  if (blocked) {
    bot.cfg.running = false
    save()
    bot.setStatus('stopped', blocked)
    return
  }
  bot.queued = true
  startQueue.push({ bot, fn })
  if (starting || startQueue.length > 1) bot.setStatus('connecting', 'Waiting for its turn to start')
  if (!starting) runQueue()
}
async function runQueue () {
  starting = true
  while (startQueue.length) {
    const { bot, fn } = startQueue.shift()
    if (!bots.has(bot.cfg.id) || !bot.queued) continue
    bot.queued = false
    try { fn() } catch (e) { console.error(e) }
    // wait even if nothing else is queued yet: more bots may be added right after this one
    await new Promise(r => setTimeout(r, Math.min(60, Math.max(1, Number(config.settings.startDelay) || 3)) * 1000))
  }
  starting = false
}

