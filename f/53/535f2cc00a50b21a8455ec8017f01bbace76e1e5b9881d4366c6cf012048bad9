app.post('/api/groups/:id/:action', (req, res) => {
  const list = [...bots.values()].filter(b => b.cfg.group === req.params.id)
  for (const bot of list) {
    if (req.params.action === 'start' && bot.status === 'stopped') queueStart(bot, () => bot.start())
    if (req.params.action === 'stop') {
      const i = startQueue.findIndex(q => q.bot === bot)
      if (i >= 0) startQueue.splice(i, 1)
      if (bot.status !== 'stopped') bot.stop()
    }
  }
  res.json({ ok: true, count: list.length })
})

