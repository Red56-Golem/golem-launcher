// Buys as many of the chosen spawner (Settings) as the bot can afford
function buyMax (bot) {
  const mob = config.settings.buyMob
  const p = donut.prices().list.find(x => x.mob === mob)
  if (!p) return { error: 'Pick what to buy in Settings first.' }
  if (bot.status !== 'online') return { error: 'The bot has to be online.' }
  if (bot.macro) return { error: 'The bot is playing a macro.' }
  if (bot.job && bot.job.state === 'running') return { error: 'The bot is already buying.' }
  const have = shardsOf(bot)
  if (have === null) return { error: "The bot's shards aren't known yet. Wait a minute." }
  const amount = Math.floor(have / p.price)
  if (amount < 1) return { error: `Not enough shards for a ${mob} spawner (${p.price.toLocaleString('en-US')}).` }
  donut.buySpawners(bot, mob, amount).catch(e => bot.write('error', `Shop: ${e.message}`))
  return { amount }
}
function shardsOf (bot) {
  const m = String(bot.stats.shards ?? '').replace(/,/g, '').match(/(\d+(?:\.\d+)?)\s*([kmb])?/i)
  return m ? parseFloat(m[1]) * ({ k: 1e3, m: 1e6, b: 1e9 }[(m[2] || '').toLowerCase()] || 1) : null
}

function publicSettings () {
  const s = config.settings
  return { afkCommand: s.afkCommand, autoAfk: s.autoAfk, buyMob: s.buyMob, goalMob: s.goalMob, goalCount: s.goalCount, mainName: s.mainName, snow: s.snow, humanize: s.humanize }
}

