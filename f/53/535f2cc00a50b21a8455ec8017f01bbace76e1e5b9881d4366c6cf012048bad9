// targets: { group: '' | groupId | '__none', bots: [ids] } -> online bots that match
function targetBots (body) {
  let list = [...bots.values()].filter(b => b.status === 'online')
  if (Array.isArray(body.bots) && body.bots.length) list = list.filter(b => body.bots.includes(b.cfg.id))
  else if (body.group === '__none') list = list.filter(b => !b.cfg.group)
  else if (body.group) list = list.filter(b => b.cfg.group === body.group)
  return list
}

app.post('/api/macros/:id/play', (req, res) => {
  const m = config.macros.find(x => x.id === req.params.id)
  if (!m) return res.status(404).json({ error: 'That macro is gone.' })
  const started = []
  const skipped = []
  for (const bot of targetBots(req.body || {})) {
    try { bot.playMacro(m.id); started.push(bot.displayName()) } catch (e) { skipped.push({ name: bot.displayName(), why: e.message }) }
  }
  if (!started.length && !skipped.length) return res.status(409).json({ error: 'No bots are online to play it.' })
  res.json({ started, skipped })
})

