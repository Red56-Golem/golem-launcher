'use strict'
// Golem AFK dashboard
const $ = (s, root = document) => root.querySelector(s)
const $$ = (s, root = document) => [...root.querySelectorAll(s)]
const state = {
  bots: new Map(), logs: new Map(), groups: [], versions: [], lanes: {}, perProxy: 4,
  donut: { list: [], readAt: 0 }, settings: { afkCommand: '/afk 1', autoAfk: true, buyMob: 'Skeleton', goalMob: 'Skeleton', goalCount: 0, mainName: '', snow: true }, chart: [],
  days: {}, proxyHealth: {}, chartMode: 'hours',
  open: null, checked: new Set(), filter: 'all', sort: 'offline', search: '', signinFor: null, signinState: {}
}

// ---------- helpers ----------
function esc (s) { return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])) }
async function api (method, url, body) {
  const res = await fetch(url, { method, headers: body ? { 'content-type': 'application/json' } : {}, body: body ? JSON.stringify(body) : undefined })
  const data = await res.json().catch(() => ({}))
  if (res.status === 401 && !url.startsWith('/api/login') && !url.startsWith('/api/setup')) { showGate(); throw new Error(data.error || 'Sign in first.') }
  if (!res.ok) throw new Error(data.error || `Something went wrong (${res.status}).`)
  return data
}
let toastTimer
function toast (text, ms = 3600) {
  const t = $('#toast')
  t.textContent = text
  t.hidden = false
  clearTimeout(toastTimer)
  toastTimer = setTimeout(() => { t.hidden = true }, ms)
}
function store (k, v) { try { localStorage.setItem(k, v) } catch {} }
function load (k) { try { return localStorage.getItem(k) } catch { return null } }
function duration (ms) {
  const s = Math.max(0, Math.round(ms / 1000))
  if (s < 60) return `${s}s`
  const m = Math.floor(s / 60)
  if (m < 60) return `${m}m`
  const h = Math.floor(m / 60)
  if (h < 48) return `${h}h ${m % 60}m`
  return `${Math.floor(h / 24)}d ${h % 24}h`
}
function clock (t) { return new Date(t).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }) }
function num (n) { return Math.round(n).toLocaleString('en-US') }
function plural (n, word) { return `${num(n)} ${word}${n === 1 ? '' : 's'}` }
// the name you typed when adding it stays the account's name
function nameOf (b) { return b.cfg.label || b.cfg.account || b.cfg.name || 'New account' }
function shardNumber (v) {
  const m = String(v ?? '').replace(/,/g, '').match(/(\d+(?:\.\d+)?)\s*([kmbt])?/i)
  if (!m) return null
  return { value: parseFloat(m[1]) * ({ k: 1e3, m: 1e6, b: 1e9, t: 1e12 }[(m[2] || '').toLowerCase()] || 1), rough: !!m[2] }
}
function shardText (v) { const n = shardNumber(v); return n ? (n.rough ? String(v).trim() : num(n.value)) : '' }
function today () { const d = new Date(); return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}` }
function tally (b) { return b.cfg.tally || { earned: 0, day: '', today: 0, spent: 0, bought: {}, disconnects: 0, lastShardAt: 0 } }
function earnedToday (b) { const t = tally(b); return t.day === today() ? t.today : 0 }
function price () { const p = state.donut.list.find(x => x.mob === state.settings.buyMob); return p ? p.price : 0 }

// farming = online and in the AFK area
function stateOf (b) {
  if (b.status === 'online') return b.afk && b.afk.in ? 'farming' : 'roaming'
  if (b.status === 'signin') return 'signin'
  if (b.status === 'error' || b.status === 'paused' || (b.status === 'stopped' && /^Not started/.test(b.detail || ''))) return 'trouble'
  return 'offline'
}
const STATE_TEXT = { farming: 'Farming in the AFK area', roaming: 'Online, not in the AFK area', signin: 'Waiting for sign-in', trouble: 'Needs a look', offline: 'Offline' }
function statusText (b) {
  const s = stateOf(b)
  if (b.job && b.job.state === 'running') return `Buying ${b.job.mob} spawners`
  if (b.status === 'waiting') return b.nextTry ? `Reconnecting in ${duration(b.nextTry - Date.now())}` : 'Reconnecting'
  if (b.status === 'connecting') return b.detail || 'Connecting'
  if (s === 'trouble') return b.detail || 'Stopped with a problem'
  if (b.status === 'stopped') return b.detail || 'Stopped'
  return STATE_TEXT[s]
}

// proxy address -> short label ("Session pq3zbf6qzu", host, or group name)
function parseProxyLabel (text) {
  let s = String(text || '').trim().replace(/^[a-z0-9]+:\/\//i, '')
  let user = ''
  const at = s.lastIndexOf('@')
  if (at >= 0) { user = s.slice(0, at).split(':')[0]; s = s.slice(at + 1) }
  const parts = s.split(':')
  if (!user && parts.length === 4) user = parts[2]
  const sess = /session[-_]?([a-z0-9]+)/i.exec(user)
  return sess ? `Session ${sess[1]}` : parts[0]
}
// green dot = the proxy answered on the last check, red = it didn't
function proxyDot (b) {
  const h = b.proxyHealth
  if (!h || proxyText(b) === 'None') return ''
  return `<i class="pdot ${h.ok ? 'ok' : 'bad'}"></i>`
}
function proxyTitle (b) {
  const h = b.proxyHealth
  if (!h || proxyText(b) === 'None') return proxyText(b)
  return h.ok ? `${proxyText(b)}: working, ${h.ms} ms` : `${proxyText(b)}: not working (${h.error})`
}
function proxyText (b) {
  if (b.cfg.proxy === 'none') return 'None'
  if (b.cfg.proxy) return parseProxyLabel(b.cfg.proxy)
  const g = state.groups.find(x => x.id === b.cfg.group)
  if (g && g.proxy) return `${g.name} (${parseProxyLabel(g.proxy)})`
  return 'None'
}

// ---------- sign in to the dashboard ----------
async function boot () {
  const s = await fetch('/api/session').then(r => r.json())
  state.version = s.version
  if (!s.signedIn) return showGate(s.needsPassword)
  showApp()
}
function showGate (needsPassword) {
  $('#app').hidden = true
  $('#gate').hidden = false
  const first = !!needsPassword
  $('#gateForm').dataset.mode = first ? 'setup' : 'login'
  $('#gateText').textContent = first ? 'Pick a password for this dashboard. You need it to open the dashboard from your phone, too.' : 'Sign in to your bots.'
  $('#gateLabel').textContent = first ? 'New password (6 or more characters)' : 'Password'
  $('#gatePass').autocomplete = first ? 'new-password' : 'current-password'
  $('#gateBtn').textContent = first ? 'Set password' : 'Sign in'
  $('#gatePass').focus()
}
$('#gateForm').addEventListener('submit', async e => {
  e.preventDefault()
  $('#gateError').textContent = ''
  try {
    await api('POST', e.currentTarget.dataset.mode === 'setup' ? '/api/setup' : '/api/login', { password: $('#gatePass').value })
    $('#gatePass').value = ''
    showApp()
  } catch (err) { $('#gateError').textContent = err.message }
})

async function showApp () {
  $('#gate').hidden = true
  $('#app').hidden = false
  const data = await api('GET', '/api/bots')
  state.versions = data.versions
  state.groups = data.groups || []
  state.donut = data.donut || state.donut
  state.lanes = data.lanes || {}
  state.perProxy = data.perProxy || 4
  state.chart = data.chart || []
  state.days = data.days || {}
  state.proxyHealth = data.proxyHealth || {}
  state.chartMode = load('golemafk.chart') || 'hours'
  if (data.settings) state.settings = data.settings
  state.bots.clear()
  for (const b of data.bots) state.bots.set(b.cfg.id, b)
  state.sort = load('golemafk.sort') || 'offline'
  $('#sort').value = state.sort
  render()
  connectLive()
  api('GET', '/api/update').then(u => { state.update = u; renderUpdate() }).catch(() => {})
}

// ---------- live updates ----------
let ws
let queued = false
function renderSoon () {
  if (queued) return
  queued = true
  requestAnimationFrame(() => { queued = false; render() })
}
function connectLive () {
  if (ws && ws.readyState <= 1) return
  ws = new WebSocket(`${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/live`)
  ws.onmessage = ev => {
    const msg = JSON.parse(ev.data)
    switch (msg.type) {
      case 'hello': for (const b of msg.bots) state.bots.set(b.cfg.id, b); renderSoon(); break
      case 'bot': {
        const before = state.bots.get(msg.bot.cfg.id)
        state.bots.set(msg.bot.cfg.id, msg.bot)
        if (before && before.job && msg.bot.job && before.job.state === 'running' && msg.bot.job.state !== 'running') {
          toast(`${nameOf(msg.bot)}: ${msg.bot.job.text}`, 6000)
          if (msg.bot.job.kind === 'shop' && msg.bot.job.bought > 0) shardShower(Math.min(40, 10 + msg.bot.job.bought * 2))
        }
        if (state.signinFor === msg.bot.cfg.id) renderSigninDialog()
        renderSoon()
        break
      }
      case 'removed': state.bots.delete(msg.id); state.checked.delete(msg.id); if (state.open === msg.id) state.open = null; renderSoon(); break
      case 'groups': state.groups = msg.groups; if (msg.lanes) state.lanes = msg.lanes; renderSoon(); break
      case 'lanes': state.lanes = msg.lanes; if ($('#groupDialog').open) renderLaneNote(); break
      case 'donut': state.donut = msg.donut; renderSoon(); break
      case 'settings': state.settings = msg.settings; renderSoon(); break
      case 'chart': state.chart.push(msg.point); while (state.chart.length > 240) state.chart.shift(); renderStats(); break
      case 'proxyHealth': state.proxyHealth = msg.proxyHealth; break
      case 'update': state.update = msg.update; renderUpdate(); break
      case 'signin':
        state.signinState[msg.id] = msg.state === 'open' ? 'Sign-in window open on the PC. Choose an account there.'
          : msg.state === 'done' ? 'Signed in. Joining...' : (msg.text || 'Sign-in did not finish.')
        if (state.signinFor === msg.id) renderSigninDialog()
        if (msg.state === 'done') { toast('Signed in. The account is joining.'); if (state.signinFor === msg.id) $('#signinDialog').close() }
        break
      case 'line': {
        const log = state.logs.get(msg.id)
        if (log) { log.push(msg.line); if (log.length > 100) log.shift() }
        if (msg.id === state.open) appendOut(msg.line)
        break
      }
    }
  }
  ws.onclose = () => setTimeout(async () => {
    const s = await fetch('/api/session').then(r => r.json()).catch(() => null)
    if (s && state.version && s.version !== state.version) return location.reload()
    if (s && !s.signedIn) return showGate(s.needsPassword)
    connectLive()
  }, 2000)
}

// ---------- page ----------
function render () {
  const bots = [...state.bots.values()]
  renderHero(bots)
  renderStats()
  renderRows()
  renderSide(bots)
}

function renderHero (bots) {
  const farming = bots.filter(b => stateOf(b) === 'farming').length
  const host = (bots[0] && bots[0].cfg.host) || 'og-donutsmp.net'
  let title
  if (!bots.length) title = 'Add your first account'
  else if (farming === bots.length) title = bots.length === 1 ? 'Your account is farming' : `All ${bots.length} accounts are farming`
  else if (farming) title = `${farming} of ${bots.length} accounts are farming`
  else title = 'No accounts are farming'
  $('#heroTitle').textContent = title
  $('#heroText').textContent = bots.length
    ? `Earning about ${num(farming * 60)} shards an hour on ${host}.${state.settings.afkCommand ? ` AFKing with ${state.settings.afkCommand}.` : ''}`
    : 'Add accounts on the right. Each one signs in once, joins the server and goes AFK to collect shards.'
  $('#addHost').textContent = host
  $('#lights').innerHTML = bots.map(b => `<i class="bulb ${stateOf(b)}" title="${esc(nameOf(b))}: ${esc(statusText(b))}"></i>`).join('')
  renderGoal(bots, farming)
  setSnow(state.settings.snow !== false)
}

// goal planner: spawners bought plus what the shards can already buy, and when the rest is done
function renderGoal (bots, farming) {
  const goal = Number(state.settings.goalCount) || 0
  const mob = state.settings.goalMob || state.settings.buyMob
  const p = (state.donut.list.find(x => x.mob === mob) || {}).price || 0
  $('#goal').hidden = !goal || !p
  if (!goal || !p) return
  const bought = bots.reduce((a, b) => a + ((tally(b).bought || {})[mob] || 0), 0)
  const shards = bots.reduce((a, b) => a + ((shardNumber(b.stats && b.stats.shards != null ? b.stats.shards : b.cfg.shards) || { value: 0 }).value), 0)
  const ready = Math.floor(shards / p)
  const have = Math.min(goal, bought + ready)
  const left = goal - have
  $('#goalTitle').textContent = `Goal: ${num(have)} of ${num(goal)} ${mob} spawners`
  let eta
  if (left <= 0) eta = ready ? `Done. ${num(ready)} can be bought now.` : 'Done!'
  else if (!farming) eta = `${num(bought)} bought, ${num(ready)} ready to buy. Nobody is farming right now.`
  else eta = `${num(bought)} bought, ${num(ready)} ready to buy, about ${duration(((left * p) - (shards - ready * p)) / (farming * 60) * 3600e3)} to go`
  $('#goalEta').textContent = eta
  $('#goalFill').style.width = `${Math.max(1, Math.min(100, have / goal * 100)).toFixed(1)}%`
}

// ---------- snow and shard showers ----------
let snowOn = false
let flakes = []
function setSnow (on) {
  const reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches
  const want = on && !reduce
  $('#snow').hidden = !want
  if (want === snowOn) return
  snowOn = want
  if (want) requestAnimationFrame(snowFrame)
}
function snowFrame () {
  if (!snowOn) return
  const c = $('#snow')
  const w = c.clientWidth
  const h = c.clientHeight
  if (c.width !== w || c.height !== h) { c.width = w; c.height = h }
  const ctx = c.getContext('2d')
  while (flakes.length < Math.min(90, w / 12)) flakes.push({ x: Math.random() * w, y: Math.random() * h, r: 0.6 + Math.random() * 1.8, s: 0.25 + Math.random() * 0.6, d: Math.random() * Math.PI * 2 })
  ctx.clearRect(0, 0, w, h)
  ctx.fillStyle = 'rgba(255,255,255,.75)'
  for (const f of flakes) {
    f.y += f.s
    f.d += 0.01
    f.x += Math.sin(f.d) * 0.3
    if (f.y > h + 4) { f.y = -4; f.x = Math.random() * w }
    ctx.beginPath(); ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2); ctx.fill()
  }
  if (!document.hidden) requestAnimationFrame(snowFrame)
  else setTimeout(() => requestAnimationFrame(snowFrame), 1000)
}
function shardShower (n) {
  if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return
  const box = document.createElement('div')
  box.className = 'shower'
  box.setAttribute('aria-hidden', 'true')
  for (let i = 0; i < n; i++) {
    const s = document.createElement('i')
    s.innerHTML = '<svg viewBox="0 0 16 16"><path d="M11 0l5 5-9 11-6-1-1-6z"/><path d="M11 0l5 5-7 2z" fill="#fff" fill-opacity=".45"/></svg>'
    s.style.left = `${Math.random() * 100}%`
    s.style.animationDelay = `${Math.random() * 0.9}s`
    s.style.animationDuration = `${1.6 + Math.random() * 1.2}s`
    s.style.setProperty('--spin', `${(Math.random() * 2 - 1) * 540}deg`)
    box.appendChild(s)
  }
  document.body.appendChild(box)
  setTimeout(() => box.remove(), 3500)
}
function renderStats () {
  const bots = [...state.bots.values()]
  let total = 0
  let rough = false
  let known = 0
  for (const b of bots) {
    const n = shardNumber(b.stats && b.stats.shards != null ? b.stats.shards : b.cfg.shards)
    if (!n) continue
    total += n.value; rough = rough || n.rough; known++
  }
  const farming = bots.filter(b => stateOf(b) === 'farming').length
  const earned = bots.reduce((a, b) => a + (tally(b).earned || 0), 0)
  const earnedNow = bots.reduce((a, b) => a + earnedToday(b), 0)
  const mob = state.settings.buyMob
  const bought = bots.reduce((a, b) => a + ((tally(b).bought || {})[mob] || 0), 0)
  const p = price()
  const perDay = p ? farming * 1440 / p : 0
  $('#stats').innerHTML = `
    <div class="stat"><b>${known ? (rough ? '~' : '') + num(total) : '0'}</b><span>Shards across all accounts</span></div>
    <div class="stat"><b class="mint">+${num(earned)}</b><span>Earned in total, +${num(earnedNow)} today</span></div>
    <div class="stat"><b>${num(farming * 60)}</b><span>Shards per hour</span></div>
    <div class="stat"><b class="gold">${num(bought)}</b><span>${esc(mob)} spawners bought</span></div>
    <div class="stat"><b class="amethyst">${perDay.toFixed(1)}</b><span>${esc(mob)} spawners a day at this rate</span></div>
    <div class="stat chart"><div class="chart-head"><span>${state.chartMode === 'days' ? 'Shards earned, last 7 days' : 'Total shards, last 4 hours'}</span>
      <span class="chart-tabs"><button type="button" class="chip" data-chart="hours" aria-pressed="${state.chartMode !== 'days'}">4h</button><button type="button" class="chip" data-chart="days" aria-pressed="${state.chartMode === 'days'}">7d</button></span></div>
      ${state.chartMode === 'days' ? daysSVG() : chartSVG()}</div>`
}
function daysSVG () {
  const out = []
  for (let i = 6; i >= 0; i--) {
    const d = new Date(Date.now() - i * 86400e3)
    const k = `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`
    out.push({ label: d.toLocaleDateString([], { weekday: 'short' }), v: (state.days[k] || {}).earned || 0 })
  }
  const max = Math.max(1, ...out.map(o => o.v))
  const w = 300
  const h = 54
  const bw = w / 7
  return `<svg viewBox="0 0 ${w} ${h + 12}" role="img" aria-label="Shards earned per day: ${out.map(o => `${o.label} ${num(o.v)}`).join(', ')}">
    ${out.map((o, i) => { const bh = Math.max(o.v ? 3 : 1, o.v / max * (h - 4)); return `<rect x="${(i * bw + 4).toFixed(1)}" y="${(h - bh).toFixed(1)}" width="${(bw - 8).toFixed(1)}" height="${bh.toFixed(1)}" rx="2" fill="${i === 6 ? '#B590FF' : '#5B4796'}"><title>${o.label}: ${num(o.v)}</title></rect><text x="${(i * bw + bw / 2).toFixed(1)}" y="${h + 10}" text-anchor="middle" font-size="8" fill="#6E6792">${o.label}</text>` }).join('')}
  </svg>`
}
function chartSVG () {
  const now = Date.now()
  const pts = state.chart.filter(p => p.t > now - 4 * 3600e3)
  if (pts.length < 2) return '<p class="sub">Fills in over the next few minutes.</p>'
  const w = 300
  const h = 54
  const t0 = now - 4 * 3600e3
  const lo = Math.min(...pts.map(p => p.v))
  const hi = Math.max(...pts.map(p => p.v))
  const span = hi - lo || 1
  const xy = pts.map(p => [((p.t - t0) / (4 * 3600e3)) * w, h - 4 - ((p.v - lo) / span) * (h - 10)])
  const line = xy.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ')
  const area = `${line} L${xy[xy.length - 1][0].toFixed(1)} ${h} L${xy[0][0].toFixed(1)} ${h} Z`
  return `<svg viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" role="img" aria-label="Total shards went from ${num(pts[0].v)} to ${num(pts[pts.length - 1].v)}">
    <defs><linearGradient id="cg" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#B590FF" stop-opacity=".45"/><stop offset="1" stop-color="#B590FF" stop-opacity="0"/></linearGradient></defs>
    <path d="${area}" fill="url(#cg)"/><path d="${line}" fill="none" stroke="#B590FF" stroke-width="2" vector-effect="non-scaling-stroke"/></svg>`
}

// ---------- accounts ----------
function visibleBots () {
  const q = state.search.trim().toLowerCase()
  const list = [...state.bots.values()].filter(b => {
    const s = stateOf(b)
    if (state.filter === 'farming' && s !== 'farming') return false
    if (state.filter === 'online' && b.status !== 'online') return false
    if (state.filter === 'offline' && b.status === 'online') return false
    if (state.filter === 'bedrock' && b.edition !== 'bedrock') return false
    if (q && ![b.cfg.label, b.cfg.account, b.cfg.name].some(v => String(v || '').toLowerCase().includes(q))) return false
    return true
  })
  const rank = { trouble: 0, signin: 1, offline: 2, roaming: 3, farming: 4 }
  const sh = b => (shardNumber(b.stats && b.stats.shards) || { value: -1 }).value
  if (state.sort === 'offline') list.sort((a, b) => rank[stateOf(a)] - rank[stateOf(b)] || nameOf(a).localeCompare(nameOf(b)))
  if (state.sort === 'shards') list.sort((a, b) => sh(b) - sh(a))
  if (state.sort === 'today') list.sort((a, b) => earnedToday(b) - earnedToday(a))
  if (state.sort === 'name') list.sort((a, b) => nameOf(a).localeCompare(nameOf(b)))
  return list
}

function nextHTML (b) {
  const p = price()
  const have = shardNumber(b.stats && b.stats.shards != null ? b.stats.shards : b.cfg.shards)
  const spin = b.status === 'online' ? '' : ' still' // a stopped account's candy cane stands still
  if (b.job && b.job.state === 'running') return `<div class="bar${spin}"><i style="width:100%"></i></div><small>Buying: ${esc(b.job.text)}</small>`
  if (!p) return '<small>Pick what to buy in Settings</small>'
  if (!have) return `<div class="bar${spin}"><i style="width:0"></i></div><small>${b.status === 'online' ? 'Counting starts in the AFK area' : '-'}</small>`
  // starts over at every spawner's worth (500, 1,000, ...) and counts up to the next one
  const can = Math.floor(have.value / p)
  const part = have.value - can * p
  const pct = Math.max(1, Math.min(100, part / p * 100))
  const left = stateOf(b) === 'farming' ? `, ${duration((p - part) * 60000)} left` : b.status === 'online' ? ', not farming' : ''
  const afford = can ? `, can afford ${num(can)}${b.cfg.autoBuy ? ' (auto-buy on)' : ''}` : ''
  const text = `${num(part)} / ${num(p)}${left}${afford}`
  return `<div class="bar${spin}" title="${esc(text)}"><i style="width:${pct.toFixed(1)}%"></i></div><small title="${esc(text)}">${esc(text)}</small>`
}
function actionHTML (b) {
  if (b.status === 'online') return '<button class="btn small" data-act="afk">Re-AFK</button>'
  if (b.status === 'signin') return '<button class="btn small primary" data-act="signin">Sign in</button>'
  if (b.status === 'connecting' || b.status === 'waiting') return '<button class="btn small" data-act="stop">Stop</button>'
  return '<button class="btn small" data-act="start">Start</button>'
}
function sumHTML (b) {
  const s = stateOf(b)
  const t = earnedToday(b)
  const online = b.status === 'online' ? duration(Date.now() - b.onlineSince) : (b.status === 'waiting' ? 'Reconnecting' : 'Offline')
  return `<label class="check"><input type="checkbox" data-check ${state.checked.has(b.cfg.id) ? 'checked' : ''} aria-label="Select ${esc(nameOf(b))}"></label>
    <div class="who"><i class="dot ${s}"></i><strong>${esc(nameOf(b))}${b.edition === 'bedrock' ? '<span class="badge">Bedrock</span>' : ''}</strong><small>${esc(statusText(b))}</small></div>
    <span class="num shards">${b.stats && b.stats.shards != null ? esc(shardText(b.stats.shards)) : b.cfg.shards != null ? num(b.cfg.shards) : '<span class="zero">-</span>'}</span>
    <span class="num today ${t ? 'plus' : 'zero'}">${t ? '+' + num(t) : '0'}</span>
    <div class="next">${nextHTML(b)}</div>
    <span class="c-proxy" title="${esc(proxyTitle(b))}">${proxyDot(b)}${esc(proxyText(b))}</span>
    <span class="c-online">${esc(online)}</span>
    ${actionHTML(b)}`
}

function renderRows () {
  const list = visibleBots()
  const box = $('#rows')
  const want = new Set(list.map(b => b.cfg.id))
  for (const el of $$('.acct', box)) if (!want.has(el.dataset.id)) el.remove()
  let prev = null
  for (const b of list) {
    let el = box.querySelector(`.acct[data-id="${b.cfg.id}"]`)
    if (!el) {
      el = document.createElement('div')
      el.className = 'acct'
      el.dataset.id = b.cfg.id
      el.innerHTML = '<div class="sum"></div>'
    }
    // keep the order without moving rows that are already in place (moving would drop focus)
    const at = prev ? prev.nextElementSibling : box.firstElementChild
    if (at !== el) box.insertBefore(el, at)
    prev = el
    patchRow($('.sum', el), sumHTML(b))
    const open = state.open === b.cfg.id
    el.classList.toggle('open', open)
    let more = $('.more', el)
    if (open && !more) { el.insertAdjacentHTML('beforeend', moreSkeleton()); more = $('.more', el); loadOut(b.cfg.id) }
    if (!open && more) more.remove()
    if (open) updateMore(b, more)
  }
  const total = state.bots.size
  $('#empty').hidden = list.length > 0
  $('#empty').textContent = total ? 'No accounts match.' : 'No accounts yet. Add some on the right.'
  for (const id of [...state.checked]) if (!state.bots.has(id)) state.checked.delete(id)
  const shownIds = list.map(b => b.cfg.id)
  $('#checkAll').checked = shownIds.length > 0 && shownIds.every(id => state.checked.has(id))
  $('#bulk').hidden = state.checked.size === 0
  $('#bulkCount').textContent = `${state.checked.size} selected`
}

// Updates a row in place: only the cells that changed are touched, and the candy-cane
// bar itself is never replaced (replacing it restarted its animation).
function patchRow (sum, html) {
  const tmp = document.createElement('div')
  tmp.innerHTML = html
  const fresh = [...tmp.children]
  const old = [...sum.children]
  if (fresh.length !== old.length) { sum.innerHTML = html; syncBars(sum); return }
  fresh.forEach((n, i) => {
    const o = old[i]
    if (o.outerHTML === n.outerHTML) return
    if (o.classList.contains('next') && n.classList.contains('next') && patchNext(o, n)) return
    o.replaceWith(n)
  })
  syncBars(sum)
}
function patchNext (o, n) {
  const ob = o.querySelector('.bar i')
  const nb = n.querySelector('.bar i')
  if (!ob || !nb) return false
  if (ob.style.width !== nb.style.width) ob.style.width = nb.style.width
  const obar = o.querySelector('.bar')
  const nbar = n.querySelector('.bar')
  if (obar.title !== nbar.title) obar.title = nbar.title
  if (obar.className !== nbar.className) { obar.className = nbar.className; delete ob.dataset.synced } // back in step when it starts again
  const os = o.querySelector('small')
  const ns = n.querySelector('small')
  if (os && ns) { if (os.textContent !== ns.textContent) os.textContent = ns.textContent; if (os.title !== ns.title) os.title = ns.title }
  return true
}
// every bar's stripes move in step, even a bar that was just drawn
function syncBars (root) {
  for (const i of root.querySelectorAll('.bar i')) {
    if (i.dataset.synced) continue
    i.dataset.synced = '1'
    i.style.animationDelay = `-${Math.round(performance.now() % 700)}ms`
  }
}

