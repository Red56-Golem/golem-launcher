    if (body.auth === 'microsoft') state.autoSignin = res.bot.cfg.id
    $('#addDialog').close()
    selectBot(res.bot.cfg.id)
    showTab('chat')
  } catch (err) { $('#addError').textContent = err.message }
})

// ---------- app settings ----------
async function openSettings () {
  const data = await api('GET', '/api/settings')
  const s = data.settings
  const f = $('#setForm')
  f.webhookUrl.value = s.webhookUrl
  for (const k of Object.keys(s.alerts)) if (f['a_' + k]) f['a_' + k].checked = s.alerts[k]
  f.lowHealth.value = String(s.lowHealth)
  if (!f.lowHealth.value) f.lowHealth.value = '6'
  f.keywords.value = s.keywords
  f.screenshotEvery.value = String(s.screenshotEvery)
  f.allowPhone.checked = s.allowPhone
  f.startWithWindows.checked = s.startWithWindows
  $('#startupRow').hidden = !data.windows
  f.port.value = s.port
  f.password.value = ''
  $('#lanHint').textContent = data.lan.length
    ? `On your phone, open ${data.lan.map(ip => `http://${ip}:${s.port}`).join(' or ')}. Windows may ask to let Node.js through the firewall; allow it on private networks.`
    : 'No Wi-Fi or network address found on this computer.'
  $('#setError').textContent = ''
  api('GET', '/api/update').then(u => { state.update = u; renderUpdate() }).catch(() => {})
  $('#testResult').textContent = ''
  $('#setDialog').showModal()
}
$('#settingsBtn').addEventListener('click', () => openSettings().catch(e => toast(e.message)))
$('#setForm').addEventListener('submit', async e => {
  e.preventDefault()
  const f = e.currentTarget
  const alerts = {}
  for (const el of f.querySelectorAll('input[name^="a_"]')) alerts[el.name.slice(2)] = el.checked
  const body = {
    webhookUrl: f.webhookUrl.value, alerts, lowHealth: f.lowHealth.value, keywords: f.keywords.value, screenshotEvery: f.screenshotEvery.value,
    allowPhone: f.allowPhone.checked, port: f.port.value
  }
  if (!$('#startupRow').hidden) body.startWithWindows = f.startWithWindows.checked
  if (f.password.value) body.password = f.password.value
  try {
    const before = await api('GET', '/api/settings')
    await api('PATCH', '/api/settings', body)
    $('#setDialog').close()
    const restartNeeded = before.settings.port !== Number(body.port) || before.settings.allowPhone !== body.allowPhone
    toast(restartNeeded ? 'Saved. Close and reopen Golem AFK to use the new port or phone setting.' : before.settings.screenshotEvery !== Number(body.screenshotEvery) ? 'Saved. The new screenshot timing starts the next time each bot joins.' : 'Settings saved.')
  } catch (err) { $('#setError').textContent = err.message }
})
$('#testAlert').addEventListener('click', async () => {
  $('#testResult').textContent = 'Sending...'
  const res = await api('POST', '/api/settings/test-alert', { url: $('#setForm').webhookUrl.value }).catch(e => ({ ok: false, error: e.message }))
  $('#testResult').textContent = res.ok ? 'Sent. Check your Discord channel.' : res.error
})
$('#signOut').addEventListener('click', async () => {
  await api('POST', '/api/logout').catch(() => {})
  $('#setDialog').close()
  if (ws) { ws.onclose = null; ws.close() }
  showGate(false)
})
$('#quitApp').addEventListener('click', async () => {
  if (!confirm('Quit Golem AFK? Every bot disconnects until you open the app again.')) return
  await api('POST', '/api/quit').catch(() => {})
  $('#setDialog').close()
  document.body.innerHTML = '<main class="gate"><div class="gate-plate"><h1>Golem AFK is closed</h1><p>Open it again with Start Golem AFK on your computer.</p></div></main>'
})


// ---------- updates ----------
function renderUpdate () {
  const u = state.update
  if (!u) return
  const busy = ['downloading', 'installing', 'restarting'].includes(u.status)
  $('#updatePill').hidden = u.status !== 'available'
  $('#updatePill span').textContent = u.latest ? `Update to ${u.latest}` : 'Update ready'
  const lines = [`You have version ${u.current}.`]
  if (u.detail) lines.push(u.detail)
  $('#updText').textContent = lines.join(' ')
  $('#updBar').hidden = !busy
  $('#updFill').style.width = `${Math.round((u.status === 'downloading' ? u.progress : 1) * 100)}%`
  $('#updInstall').hidden = u.status !== 'available'
  $('#updInstall').textContent = `Install version ${u.latest}`
  for (const id of ['#updInstall', '#updCheck', '#updZip']) $(id).disabled = busy || u.status === 'checking'
  if (u.status === 'restarting') showRestarting(u.latest)
}
function showRestarting (version) {
  if (state.restarting) return
  state.restarting = true
  toast(`Updated${version && version !== '?' ? ` to ${version}` : ''}. Golem AFK is restarting; this page reloads by itself.`)
  // the app comes back in a few seconds; reload once it answers with the new version
  const poll = setInterval(async () => {
    const s = await fetch('/api/session').then(r => r.json()).catch(() => null)
    if (s && s.version !== state.version) { clearInterval(poll); location.reload() }
  }, 2000)
}
$('#updatePill').addEventListener('click', () => openSettings().then(() => $('#updates').scrollIntoView({ block: 'start' })).catch(e => toast(e.message)))
$('#updCheck').addEventListener('click', async () => {
  try { state.update = await api('POST', '/api/update/check'); renderUpdate() } catch (e) { toast(e.message) }
})
$('#updInstall').addEventListener('click', async () => {
  try { await api('POST', '/api/update/install'); showRestarting(state.update && state.update.latest) } catch (e) { toast(e.message) }
})
$('#updZip').addEventListener('click', () => $('#updFile').click())
$('#updFile').addEventListener('change', () => {
  const file = $('#updFile').files[0]
  $('#updFile').value = ''
  if (!file) return
  const xhr = new XMLHttpRequest()
  xhr.open('POST', '/api/update/upload')
  xhr.setRequestHeader('content-type', 'application/zip')
  $('#updBar').hidden = false
  for (const id of ['#updInstall', '#updCheck', '#updZip']) $(id).disabled = true
  xhr.upload.onprogress = e => {
    if (!e.lengthComputable) return
    $('#updFill').style.width = `${Math.round(e.loaded / e.total * 100)}%`
    $('#updText').textContent = `Sending ${file.name} to Golem AFK: ${Math.round(e.loaded / e.total * 100)}%`
  }
  xhr.upload.onload = () => { $('#updText').textContent = 'Checking which files changed...' }
  xhr.onload = () => {
    let data = {}
    try { data = JSON.parse(xhr.responseText) } catch {}
    if (xhr.status >= 200 && xhr.status < 300) {
      $('#updText').textContent = `Installed ${data.version || 'the update'} (${data.changed} files changed). Restarting...`
      showRestarting(data.version)
    } else {
      $('#updBar').hidden = true
      for (const id of ['#updCheck', '#updZip']) $(id).disabled = false
      $('#updText').textContent = data.error || `The update didn't install (${xhr.status}).`
    }
  }
  xhr.onerror = () => { $('#updText').textContent = "Couldn't send the file to Golem AFK." }
  xhr.send(file)
})

for (const d of document.querySelectorAll('dialog')) {
  d.addEventListener('click', e => { if (e.target.closest('[data-close]') || e.target === d) d.close() })
}

// ---------- timers ----------
setInterval(() => {
  if ($('#app').hidden) return
  const b = state.bots.get(state.selected)
  if (b && state.view !== 'grid') { renderStatus(b); renderShotCaption(b) }
  for (const row of document.querySelectorAll('.roster-row')) {
    const rb = state.bots.get(row.dataset.id)
    if (rb) row.querySelector('small').textContent = rosterLine(rb)
  }
}, 1000)
setInterval(() => { if (!$('#app').hidden) { renderStrip(); renderRoster(); if (state.view === 'grid') renderGrid() } }, 30000)
window.addEventListener('beforeunload', e => { if (state.dirty) { e.preventDefault(); e.returnValue = '' } })

boot()
