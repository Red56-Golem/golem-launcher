'use strict'
// Bedrock Edition bot (Bedrock servers, or Java servers with a Bedrock port like Donut's 19132).
// It stays online, chats, runs commands and reports health; screenshots and
// walking are Java-only because Bedrock world data isn't decoded here.
const path = require('path')
const crypto = require('crypto')
const { AfkBot, findSender, sliceMotd, sleep, ago, hearts, friendlyAuth } = require('./bot')
const { DATA, config, save, addHistory, proxyForBot } = require('./store')
const proxyLib = require('./proxy')
const { alert } = require('./alerts')
const { BedrockWorld } = require('./bedrock-world')
const { BedrockWalker } = require('./bedrock-walk')
const { parseShards } = require('./shards')

let backend = null
function rakBackend () {
  if (backend) return backend
  try {
    require('raknet-native')
    backend = 'raknet-native'
  } catch {
    backend = 'jsp-raknet' // pure JavaScript fallback (needs no Visual C++ runtime)
  }
  return backend
}

let lib = null
function bedrockLib () {
  if (lib) return lib
  const Options = require('bedrock-protocol/src/options')
  const { Client } = require('bedrock-protocol/src/client')
  const advertisement = require('bedrock-protocol/src/server/advertisement')
  lib = { Options, Client, advertisement }
  return lib
}

// Bedrock through a SOCKS5 proxy: the pure-JavaScript RakNet client, with its UDP
// socket swapped for one that relays through the proxy.
async function proxySocket (raknet, proxy) {
  const relay = await proxyLib.udpRelay(proxy)
  try { raknet.socket.removeAllListeners('message'); raknet.socket.close() } catch {}
  raknet.socket = relay
  relay.on('message', (buf, rinfo) => raknet.handle(buf, rinfo))
}

let patched = false
function patchJsRaknet () {
  if (patched) return
  patched = true
  const { Client: JsClient } = require('jsp-raknet')
  const RakJs = require('bedrock-protocol/src/rak')('jsp-raknet').RakClient
  const plain = RakJs.prototype.plainConnect
  RakJs.prototype.plainConnect = async function (host = this.options.host, port = this.options.port) {
    if (!this.golemProxy) return plain.call(this, host, port)
    this.raknet = new JsClient(host, port)
    await proxySocket(this.raknet, this.golemProxy)
    await this.raknet.connect()
    this.raknet.on('connected', this.onConnected)
    this.raknet.on('encapsulated', (encapsulated, addr) => this.onEncapsulated(encapsulated, addr.hash))
    this.raknet.on('disconnect', (reason) => this.onCloseConnection(reason))
  }
}

async function pingViaProxy (host, port, proxy) {
  const { Client: JsClient } = require('jsp-raknet')
  const c = new JsClient(host, port)
  await proxySocket(c, proxy)
  try {
    const raw = await new Promise((resolve, reject) => {
      const t = setTimeout(() => reject(new Error('the server did not answer through the proxy. It may not support UDP.')), 8000)
      c.ping((data) => { clearTimeout(t); resolve(data) })
    })
    return bedrockLib().advertisement.fromServerName(raw)
  } finally {
    try { c.close() } catch {}
  }
}

async function pingBedrock (host, port, proxy) {
  if (proxy) return pingViaProxy(host, port, proxy)
  const { RakClient } = require('bedrock-protocol/src/rak')(rakBackend())
  const con = new RakClient({ host, port })
  try {
    const raw = await Promise.race([con.ping(), sleep(8000).then(() => { throw new Error('the server did not answer in time.') })])
    return bedrockLib().advertisement.fromServerName(raw)
  } finally {
    try { con.close() } catch {}
  }
}

class BedrockBot extends AfkBot {
  edition () { return 'bedrock' }

  quitClient () {
    try { this.mc.disconnect('Leaving') } catch {}
    try { this.mc.close() } catch {}
  }

  closeClient (client) { try { client.close() } catch {} }

  sendLine (text, quiet) {
    const c = this.mc
    if (!quiet) this.write('you', text, null, this.cfg.account || this.cfg.name || 'You')
    if (text.startsWith('/')) {
      c.queue('command_request', {
        command: text,
        origin: { type: 'player', uuid: (c.profile && c.profile.uuid) || crypto.randomUUID(), request_id: crypto.randomUUID(), player_entity_id: 0n },
        internal: false,
        version: c.versionLessThan && c.versionLessThan('1.21.70') ? 52 : 'latest'
      })
    } else {
      c.queue('text', {
        needs_translation: false,
        category: 'authored',
        type: 'chat',
        source_name: c.username || '',
        message: text,
        xuid: (c.profile && c.profile.xuid) ? String(c.profile.xuid) : '',
        platform_chat_id: '',
        has_filtered_message: false,
        filtered_message: ''
      })
    }
  }

  playMacro (id) {
    const { m, global } = this.findMacro(id)
    if (m && global && !m.steps.some(s => BEDROCK_STEPS.includes(s.type))) throw new Error('This macro only has steps Bedrock bots can\'t do.')
    // macros for every bot: Bedrock bots skip the steps they can't do
    if (m && !global && m.steps.some(s => !BEDROCK_STEPS.includes(s.type))) {
      throw new Error('Bedrock bots can use Move to, Look, Jump, Say and Wait steps.')
    }
    return super.playMacro(id)
  }

  // the server's game tick: start_game's tick plus the time since then
  gameTick () {
    const w = this.world
    return BigInt(Math.floor((w.startTick || 0) + (Date.now() - (w.startAt || Date.now())) / 50))
  }

  walker () {
    if (!this.walk || this.walk.client !== this.mc) this.walk = new BedrockWalker(this)
    return this.walk
  }

  // ---- menus (chest-style menus such as /shop, which Geyser shows as a chest) ----

  // Looks enough like a mineflayer bot for donut.js: currentWindow, clickWindow, closeWindow
  menuBot () {
    const self = this
    return {
      registry: null,
      get currentWindow () {
        const w = self.world && self.world.window
        if (!w) return null
        return { id: w.uid, type: w.type, title: '', slots: w.slots, inventoryStart: w.slots.length }
      },
      clickWindow: async (slot) => self.menuClick(slot),
      closeWindow: () => self.menuClose()
    }
  }

  // A click is a "take this stack to the cursor" request; Geyser turns it into a
  // left click on that slot for the Java server.
  menuClick (slot) {
    const w = this.world && this.world.window
    const it = w && w.slots[slot]
    if (!it || !this.mc) return
    this.requestId = (this.requestId || -1) - 2
    this.mc.queue('item_stack_request', {
      requests: [{
        request_id: this.requestId,
        actions: [{
          type_id: 'take',
          legacy_type_id: 0,
          count: Math.max(1, Math.min(255, it.count || 1)),
          source: { slot_type: { container_id: 'container' }, slot, stack_id: it.stackId || 0 },
          destination: { slot_type: { container_id: 'cursor' }, slot: 0, stack_id: 0 }
        }],
        custom_names: [],
        cause: 'chat_public'
      }]
    })
  }

  menuClose () {
    const w = this.world && this.world.window
    if (!w || !this.mc) return
    try { this.mc.queue('container_close', { window_id: w.rawId, window_type: w.rawType, server: false }) } catch {}
    this.world.window = null
  }

  async doStep (step, token) {
    if (!BEDROCK_STEPS.includes(step.type)) return
    if (step.type === 'chat' || step.type === 'wait') return super.doStep(step, token)
    if (!this.mc || !this.world || !this.world.eye) throw new Error('Disconnected')
    if (step.type === 'move') {
      const x = Number(step.x); const z = Number(step.z)
      if (!Number.isFinite(x) || !Number.isFinite(z)) throw new Error('Move to needs an X and a Z.')
      const hasY = step.y !== '' && step.y !== null && step.y !== undefined && Number.isFinite(Number(step.y))
      this.write('info', `Walking to ${hasY ? `${x}, ${step.y}, ${z}` : `${x}, ${z}`}`)
      return this.walker().walkTo(x, hasY ? Number(step.y) : null, z, token)
    }
    if (step.type === 'look') {
      const LOOK_DEG = { north: [180, 0], east: [-90, 0], south: [0, 0], west: [90, 0], up: [null, -90], down: [null, 90] }
      const [yaw, pitch] = LOOK_DEG[step.dir] || LOOK_DEG.north
      return this.walker().look(yaw, pitch)
    }
    if (step.type === 'jump') return this.walker().jump()
  }

  async connect () {
    const conn = ++this.conn
    this.ended = false
    this.setStatus('connecting', `Connecting to ${this.cfg.host}`)
    const host = this.cfg.host
    const port = Number(this.cfg.port) || 19132
    const isMs = this.cfg.auth === 'microsoft'
    if (!isMs && !/^[A-Za-z0-9_ ]{3,16}$/.test(this.cfg.name)) {
      this.setStatus('error', 'Offline names must be 3 to 16 letters, numbers, spaces or underscores.')
      this.cfg.running = false
      save()
      return
    }
    let proxy = null
    try { proxy = proxyForBot(this.cfg) } catch (e) {
      this.cfg.running = false
      save()
      return this.setStatus('error', `The group's proxy is wrong: ${e.message}`)
    }
    if (proxy && proxy.type !== 'socks5') {
      this.cfg.running = false
      save()
      return this.setStatus('error', 'Bedrock bots need a SOCKS5 proxy (Bedrock uses UDP). Give this group a SOCKS5 proxy, or move the bot to another group.')
    }
    if (proxy) { patchJsRaknet(); this.write('info', `Connecting through ${proxyLib.describe(proxy)} (UDP)`) }
    let version
    try {
      const { Options } = bedrockLib()
      const ad = await pingBedrock(host, port, proxy)
      const adVersion = (ad.version || '').split('.').slice(0, 3).join('.')
      version = Options.Versions[adVersion] ? adVersion : Options.CURRENT_VERSION
      if (!Options.Versions[adVersion]) this.write('info', `The server runs Bedrock ${ad.version || '?'}; joining as ${version}.`)
    } catch (e) {
      if (conn !== this.conn) return
      this.write('error', `Couldn't reach ${host}:${port}: ${(e && e.message) || e}`)
      return this.afterEnd(`Couldn't reach ${host}`, 'network')
    }
    if (conn !== this.conn || !this.cfg.running) return

    let client
    try {
      const { Client } = bedrockLib()
      client = new Client({
        host,
        port,
        version,
        offline: !isMs,
        username: isMs ? `golem-${this.cfg.id}` : this.cfg.name,
        profilesFolder: path.join(DATA, 'auth', this.cfg.id),
        onMsaCode: data => this.onCode(data, conn),
        raknetBackend: proxy ? 'jsp-raknet' : rakBackend(),
        ...(proxy ? { useRaknetWorkers: false } : {}), // the proxy hook lives in this thread
        conLog: null,
        delayedInit: true,
        followPort: false
      })
    } catch (e) {
      this.write('error', e.message || String(e))
      return this.afterEnd(e.message || String(e), 'network')
    }
    this.mc = client
    this.world = new BedrockWorld(client, version)
    this.world.onProblem = (text) => { if (conn === this.conn) this.write('error', `World data: ${text}`) }
    this.spawned = false
    this.kickText = ''
    this.players = new Map() // uuid -> name
    this.stats = {}
    if (backend === 'jsp-raknet') this.write('info', 'Using the built-in network code (install the Microsoft Visual C++ Redistributable for a faster one).')

    client.on('connect_allowed', () => {
      if (conn !== this.conn) return
      if (proxy) client.connection.golemProxy = proxy
      client.connect()
    })
    client.on('session', () => {
      if (conn !== this.conn) return
      if (this.status === 'signin') this.setStatus('connecting', `Joining ${host}`)
      this.timer(setTimeout(() => {
        if (conn === this.conn && !this.spawned) {
          this.write('error', 'Joined but never got into the world. Trying again.')
          try { client.close() } catch {}
          this.handleEnd(conn, 'timeout')
        }
      }, 90000))
    })

    client.on('session', (profile) => {
      if (isMs && profile && profile.name && profile.name !== this.cfg.account) {
        this.cfg.account = profile.name
        save()
        this.changed()
      }
    })

    client.on('network_stack_latency', (p) => {
      if (p.needs_response) client.queue('network_stack_latency', { timestamp: p.timestamp, needs_response: false })
    })
    client.once('resource_packs_info', () => {
      client.write('resource_pack_client_response', { response_status: 'completed', response_status_name: 'resourcepackstackfinished', resourcepackids: [] })
      client.once('resource_pack_stack', () => {
        client.write('resource_pack_client_response', { response_status: 'completed', response_status_name: 'resourcepackstackfinished', resourcepackids: [] })
      })
      client.queue('client_cache_status', { enabled: false })
      sleep(500).then(() => { try { client.queue('request_chunk_radius', { chunk_radius: 4 }) } catch {} })
    })

    client.on('join', () => this.write('info', `Logged in as ${client.username} (Bedrock ${version})`))

    client.on('start_game', (p) => {
      const pos = p.player_position || {}
      this.stats.x = Math.floor(pos.x || 0)
      this.stats.y = Math.floor((pos.y || 0) - 1.62)
      this.stats.z = Math.floor(pos.z || 0)
      this.stats.dimension = dimName(p.dimension)
    })

    client.on('spawn', () => {
      if (conn !== this.conn || this.spawned) return
      this.spawned = true
      this.onlineSince = Date.now()
      addHistory(this.cfg.id, 'on')
      const wasDown = this.downSince
      this.downSince = 0
      this.stats.health = this.stats.health ?? 20
      this.stats.food = this.stats.food ?? 20
      this.stats.players = this.players.size
      this.setStatus('online')
      this.write('info', `In the world on ${host}`)
      if (wasDown && Date.now() - wasDown > 60000) {
        alert('backOnline', { bot: this, title: 'Back online', text: `Down for ${ago(Date.now() - wasDown)}.`, tone: 'good' })
      }
      this.timer(setTimeout(() => { if (conn === this.conn) this.fails = 0 }, 120000))
      this.onJoined(conn)
    })

    client.on('player_list', (p) => {
      const rec = p.records || {}
      for (const r of rec.records || []) {
        if (rec.type === 'add' && r.username) this.players.set(r.uuid, r.username)
        if (rec.type === 'remove') this.players.delete(r.uuid)
      }
      if (this.stats.players !== this.players.size) { this.stats.players = this.players.size; this.changed() }
    })

    client.on('move_player', (p) => {
      if (p.runtime_id !== client.entityId && String(p.runtime_id) !== String(client.entityId)) return
      this.stats.x = Math.floor(p.position.x); this.stats.y = Math.floor(p.position.y - 1.62); this.stats.z = Math.floor(p.position.z)
      this.changed()
    })
    client.on('change_dimension', (p) => { this.stats.dimension = dimName(p.dimension); this.changed() })

    client.on('update_attributes', (p) => {
      if (String(p.runtime_entity_id) !== String(client.entityId)) return
      const prev = this.stats.health
      for (const a of p.attributes || []) {
        if (a.name === 'minecraft:health') this.stats.health = Math.round(a.current * 10) / 10
        if (a.name === 'minecraft:player.hunger') this.stats.food = Math.round(a.current)
      }
      this.changed()
      this.healthAlert(prev)
    })
    client.on('set_health', (p) => {
      const prev = this.stats.health
      this.stats.health = p.health
      this.changed()
      this.healthAlert(prev)
    })

    client.on('respawn', (p) => {
      if (p.state === 1) { // server says a spawn spot is ready: tell it we're ready too
        try { client.queue('respawn', { position: p.position, state: 2, runtime_entity_id: client.entityId }) } catch {}
      }
    })
    client.on('death_info', () => {
      this.write('error', 'Died. Respawning.')
      alert('died', { bot: this, title: 'Died', text: 'The bot died and respawned.', tone: 'bad' })
      try {
        client.queue('player_action', { runtime_entity_id: client.entityId, action: 'respawn', position: { x: 0, y: 0, z: 0 }, result_position: { x: 0, y: 0, z: 0 }, face: -1 })
      } catch {}
    })

    client.on('text', (p) => {
      if (conn !== this.conn) return
      const text = readText(p)
      if (!text.trim()) return
      if (p.type === 'tip' || p.type === 'popup' || p.type === 'jukebox_popup') {
        this.setActionBar(stripAll(text).trim(), text)
        return
      }
      const plain = stripAll(text)
      const known = (p.type === 'chat' || p.type === 'whisper') && p.source_name ? p.source_name : null
      if (known && !plain.includes(known)) {
        this.write('chat', plain, text, known)
      } else {
        const found = findSender(plain, [...this.players.values()], known)
        if (found) this.write('chat', plain.slice(found.cut), sliceMotd(text, found.cut), found.from)
        else this.write('server', plain, text)
      }
      this.checkShardsReply(plain, text)
      this.checkMention(plain, { username: client.username })
    })

    client.on('set_title', (p) => {
      if (conn !== this.conn) return
      if (p.type === 'action_bar_message') this.setActionBar(stripAll(p.text).trim(), p.text)
      if (p.type === 'action_bar_message_json') {
        try {
          const Chat = require('prismarine-chat')('1.21.11')
          const m = new Chat(JSON.parse(p.text))
          this.setActionBar(m.toString().trim(), m.toMotd())
        } catch {}
      }
    })

    client.on('kick', (p) => {
      if (conn !== this.conn) return
      this.kickText = stripAll(p.message || '') || String(p.reason || 'Kicked')
      this.write('error', `Kicked: ${this.kickText}`)
    })
    client.on('error', (err) => {
      if (conn !== this.conn) return
      const text = (err && err.message) || String(err)
      this.lastError = text
      this.write('error', text)
      setTimeout(() => { if (conn === this.conn && !this.ended) { try { client.close() } catch {} this.handleEnd(conn, text) } }, 3000)
    })
    client.on('close', () => this.handleEnd(conn, 'closed'))

    try {
      client.init()
    } catch (e) {
      this.write('error', e.message || String(e))
      this.handleEnd(conn, e.message || String(e))
    }
  }

  healthAlert (prev) {
    const low = Number(config.settings.lowHealth) || 6
    const h = this.stats.health
    if (typeof prev === 'number' && prev > low && h <= low && h > 0) {
      alert('lowHealth', { bot: this, title: 'Low health', text: `Health is down to ${hearts(h)}.`, tone: 'warn' })
    }
  }

  onJoined (conn) {
    this.timer(setInterval(() => this.changed(), 15000))
    this.scheduleShots(conn)
    this.stats.shards = this.cfg.shards ?? null // counted by the dashboard (afkTick), no /shards
    if (this.cfg.joinCommands.trim()) {
      this.timer(setTimeout(() => this.runCommands(this.cfg.joinCommands, conn, 'join'), 2500))
    }
    this.scheduleAfk(conn)
    if (this.cfg.repeat.on && this.cfg.repeat.commands.trim()) {
      const every = Math.max(0.5, Number(this.cfg.repeat.every) || 10) * 60000
      this.timer(setInterval(() => this.runCommands(this.cfg.repeat.commands, conn, 'repeat'), every))
    }
    const auto = (this.cfg.macros || []).find(m => m.onJoin && m.steps.length && m.steps.every(s => BEDROCK_STEPS.includes(s.type)))
    if (auto) this.timer(setTimeout(() => { if (conn === this.conn && !this.macro) { try { this.playMacro(auto.id) } catch {} } }, 8000))
  }

  // Bedrock anti-AFK: swing the arm now and then
  scheduleAfk (conn) {
    const afk = this.cfg.antiAfk
    if (!afk.on) return
    const every = Math.max(5, Number(afk.every) || 30) * 1000
    this.timer(setTimeout(() => {
      if (conn !== this.conn || !this.mc) return
      try { this.mc.queue('animate', { action_id: 'swing_arm', runtime_entity_id: this.mc.entityId, data: 0, has_swing_source: false }) } catch {}
      this.scheduleAfk(conn)
    }, every * (0.7 + Math.random() * 0.6)))
  }

  // Join/repeat commands on Bedrock: text, /commands and "wait N"
  async runCommands (text, conn, why) {
    if (this.busy) return
    this.busy = true
    try {
      for (const raw of String(text).split(/\r?\n/)) {
        const line = raw.trim()
        if (!line || line.startsWith('#')) continue
        if (conn !== this.conn || !this.mc) break
        const [word, ...rest] = line.split(/\s+/)
        if (word.toLowerCase() === 'wait') { await sleep(Math.min(600, Math.max(0, parseFloat(rest[0]) || 1)) * 1000); continue }
        if (['slot', 'use', 'click', 'close'].includes(word.toLowerCase())) { this.write('info', `Skipped "${line}" (Java bots only)`); continue }
        this.sendLine(line)
        await sleep(900)
      }
    } catch (e) {
      this.write('error', `${why === 'join' ? 'Join' : 'Repeat'} commands stopped: ${e.message || e}`)
    }
    this.busy = false
  }

  tick () {}

  hudState () {
    const w = this.world
    if (!w) return null
    const lines = w.sidebarLines()
    return {
      hotbar: w.hotbar,
      selected: w.selected,
      health: this.stats.health,
      food: this.stats.food,
      xpLevel: w.xpLevel,
      xpProgress: w.xpProgress,
      survival: true,
      actionBar: this.stats.actionBar && Date.now() - (this.actionBarAt || 0) < 4000 ? (this.actionBarMotd || this.stats.actionBar) : '',
      sidebar: lines.length ? { title: w.sidebarTitle(), lines } : null
    }
  }

  readShards () {}

  inventoryItems () { return (this.world && this.world.inv ? this.world.inv : []).filter(Boolean) }

  // drops one inventory stack on the ground (Geyser turns it into a Java "throw")
  dropSlot (it) {
    if (!this.mc || !it) return
    this.requestId = (this.requestId || -1) - 2
    this.mc.queue('item_stack_request', {
      requests: [{
        request_id: this.requestId,
        actions: [{ type_id: 'drop', legacy_type_id: 3, count: Math.max(1, Math.min(255, it.count || 1)), source: { slot_type: { container_id: 'hotbar_and_inventory' }, slot: it.slot, stack_id: it.stackId || 0 }, randomly: false }],
        custom_names: [],
        cause: 'chat_public'
      }]
    })
  }

  async lookDown () { try { await this.walker().look(null, 90) } catch {} }

  async prepareDrop () { await this.lookDown(); await sleep(400) }

  // walk a few blocks away so it doesn't pick its own drops back up
  async afterDrop () {
    const e = this.world && this.world.eye
    if (!e) return
    const token = {}
    setTimeout(() => { token.cancelled = true }, 4000)
    try { await this.walker().walkTo(Math.floor(e.x) + 3, null, Math.floor(e.z), token) } catch {}
  }

  position () { const e = this.world && this.world.eye; return e ? { x: e.x, y: e.y, z: e.z, dim: this.world.dim } : null }

  // the right-hand scoreboard (rounded, e.g. "★ Shards 1.11K")
  boardReading () {
    try { return this.world ? parseShards(this.world.sidebarLines()) : null } catch { return null }
  }
}

const BEDROCK_STEPS = ['chat', 'wait', 'move', 'look', 'jump']

function readText (p) {
  let msg = String(p.message || '')
  const params = p.parameters || []
  if (p.needs_translation || /^%|%[a-z]/.test(msg)) {
    const key = msg.replace(/^§[0-9a-fk-or]/i, '').replace(/^%/, '')
    if (key === 'chat.type.text' && params.length >= 2) return `<${params[0]}> ${params[1]}`
    if (key.startsWith('multiplayer.player.joined') && params[0]) return `§e${params[0]} joined the game`
    if (key.startsWith('multiplayer.player.left') && params[0]) return `§e${params[0]} left the game`
    if (params.length) msg = msg.replace(/%[a-z.]+/i, '').trim() + ' ' + params.join(' ')
  }
  return msg
}

function stripAll (s) { return String(s || '').replace(/§[0-9a-z]/gi, '') }
function dimName (d) { return d === 1 || d === 'nether' ? 'the_nether' : d === 2 || d === 'the_end' ? 'the_end' : 'overworld' }

module.exports = { BedrockBot, rakBackend }
