// ---------- updates ----------
function renderUpdate () {
  const u = state.update
  if (!u) return
  const busy = ['downloading', 'installing', 'restarting'].includes(u.status)
  $('#updatePill').hidden = u.status !== 'available'
  $('#updatePill span').textContent = u.latest ? `Update to ${u.latest}` : 'Update ready'
  $('#updText').textContent = [`You have version ${u.current}.`, u.detail].filter(Boolean).join(' ')
  $('#updBar').hidden = !busy
  $('#updFill').style.width = `${Math.round((u.status === 'downloading' ? u.progress : 1) * 100)}%`
  $('#updInstall').hidden = u.status !== 'available'
  $('#updInstall').textContent = `Install version ${u.latest}`
  for (const id of ['#updInstall', '#updCheck', '#updZip']) $(id).disabled = busy || u.status === 'checking'
  if (u.status === 'restarting') showRestarting(u.latest)
}
function showRestarting (version) {
  if (state.restarting) return
  state.restarting = true
  toast(`Updated${version && version !== '?' ? ` to ${version}` : ''}. Golem AFK is restarting; this page reloads by itself.`, 20000)
  const poll = setInterval(async () => {
    const s = await fetch('/api/session').then(r => r.json()).catch(() => null)
    if (s && s.version !== state.version) { clearInterval(poll); location.reload() }
  }, 2000)
}
$('#updatePill').addEventListener('click', () => openSettings().then(() => $('#updates').scrollIntoView({ block: 'start' })).catch(e => toast(e.message)))
$('#updCheck').addEventListener('click', async () => { try { state.update = await api('POST', '/api/update/check'); renderUpdate() } catch (e) { toast(e.message) } })
$('#updInstall').addEventListener('click', async () => { try { await api('POST', '/api/update/install'); showRestarting(state.update && state.update.latest) } catch (e) { toast(e.message) } })
$('#updZip').addEventListener('click', () => $('#updFile').click())
$('#updFile').addEventListener('change', () => {
  const file = $('#updFile').files[0]
  $('#updFile').value = ''
  if (!file) return
  const xhr = new XMLHttpRequest()
  xhr.open('POST', '/api/update/upload')
  xhr.setRequestHeader('content-type', 'application/zip')
  $('#updBar').hidden = false
  for (const id of ['#updInstall', '#updCheck', '#updZip']) $(id).disabled = true
  xhr.upload.onprogress = e => {
    if (!e.lengthComputable) return
    $('#updFill').style.width = `${Math.round(e.loaded / e.total * 100)}%`
    $('#updText').textContent = `Sending ${file.name}: ${Math.round(e.loaded / e.total * 100)}%`
  }
  xhr.onload = () => {
    let data = {}
    try { data = JSON.parse(xhr.responseText) } catch {}
    if (xhr.status >= 200 && xhr.status < 300) { $('#updText').textContent = `Installed ${data.version || 'the update'}. Restarting...`; showRestarting(data.version) } else {
      $('#updBar').hidden = true
      for (const id of ['#updCheck', '#updZip']) $(id).disabled = false
      $('#updText').textContent = data.error || `The update didn't install (${xhr.status}).`
    }
  }
  xhr.onerror = () => { $('#updText').textContent = "Couldn't send the file to Golem AFK." }
  xhr.send(file)
})

