  }
  if (b.summaryTime !== undefined) s.summaryTime = /^([01]?\d|2[0-3]):[0-5]\d$/.test(String(b.summaryTime)) ? String(b.summaryTime).padStart(5, '0') : '23:55'
  if (b.humanize !== undefined) s.humanize = !!b.humanize
  if (b.snow !== undefined) s.snow = !!b.snow
