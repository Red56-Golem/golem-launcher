app.patch('/api/settings', (req, res) => {
  const b = req.body || {}
  const s = config.settings
  if (b.webhookUrl !== undefined) {
    const url = String(b.webhookUrl).trim()
    if (url && !alerts.validUrl(url)) return res.status(400).json({ error: "That doesn't look like a Discord webhook link." })
    s.webhookUrl = url
  }
  if (b.alerts) for (const k of Object.keys(s.alerts)) if (b.alerts[k] !== undefined) s.alerts[k] = !!b.alerts[k]
  if (b.lowHealth !== undefined) s.lowHealth = clampInt(b.lowHealth, 1, 19, 6)
  if (b.keywords !== undefined) s.keywords = String(b.keywords).slice(0, 300)
  if (b.screenshotEvery !== undefined) s.screenshotEvery = [0, 1, 2, 5, 10, 30].includes(Number(b.screenshotEvery)) ? Number(b.screenshotEvery) : 1
  if (b.allowPhone !== undefined) s.allowPhone = !!b.allowPhone
  if (b.port !== undefined) s.port = clampInt(b.port, 1024, 65535, 8080)
  if (b.startWithWindows !== undefined) {
    const err = setStartup(!!b.startWithWindows)
    if (err) return res.status(400).json({ error: err })
    s.startWithWindows = !!b.startWithWindows
  }
  if (b.password !== undefined) {
    if (String(b.password).length < 6) return res.status(400).json({ error: 'Use at least 6 characters.' })
    store.setPassword(String(b.password))
    setCookie(res, store.newSession())
  }
  saveNow()
  res.json({ settings: s })
})

